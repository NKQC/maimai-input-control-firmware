import { Button, ComboBox, VerticalBox, HorizontalBox, GroupBox, ListView, CheckBox, SpinBox, LineEdit, ScrollView, TabWidget, TextEdit, Slider } from "std-widgets.slint";
import { ConfigRow, ConfigGroupCount, ZoneCell, HidPointCell, ParamRow, GlobalFences, ChannelStatus, AlgoReportLine, AlgoMetadataRow, LogRow, VcamKbdRow, AlgoSettingRow, LedUnitRow, SpectrumCell } from "common/types.slint";
import { CollapsibleSection, ParamEditorRow, AlgoSettingEditorRow, PlotPath, BinAmpEditor, SeriesRow } from "common/widgets.slint";
import { Theme } from "common/theme.slint";
import { ConfigPage } from "pages/config.slint";
import { BindingPage } from "pages/binding.slint";
import { LogPage } from "pages/log.slint";
import { KeyMapPage, PhysKbdPage } from "pages/keymap.slint";
import { AllChannelsPage } from "pages/all_channels.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { CurvesPage } from "pages/curves.slint";
import { AlgoPage } from "pages/algo.slint";
import { ClockFixedNode, ClockArrowRight, ClockArrowDown, GlobalTunePage } from "pages/global_tune.slint";
import { ToolboxPage } from "pages/toolbox.slint";
import { ProtocolPage } from "pages/protocol.slint";
import { SettingsPage } from "pages/settings.slint";
import { AboutPage } from "pages/about.slint";

// 供 Rust 侧生成模块使用: 结构体在入口文件再次导出, 保证生成的类型名与位置不变。
export { ConfigRow, ConfigGroupCount, ZoneCell, HidPointCell, ParamRow, GlobalFences, ChannelStatus, AlgoReportLine, AlgoMetadataRow, LogRow, VcamKbdRow, AlgoSettingRow, LedUnitRow, SpectrumCell }

export component AppWindow inherits Window {
    title: "mai2control-ui";
    // 窗口/任务栏图标(标题栏、Alt-Tab、任务栏都取它)。路径相对本 .slint 文件。
    icon: @image-url("assets/icon.png");
    // 默认更宽敞, 且允许缩到较小尺寸: 布局用 HorizontalBox/VerticalBox stretch 自适应回流,
    // 窄窗口下工具栏已拆多行, 不再右侧截断。
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 720px;
    min-height: 520px;

    // 设备下拉列表文本(由 main.rs 从 AppController::device_labels 回填)
    in property <[string]> device_labels: [];
    // 当前选中的设备索引(与 device_labels 对应)
    in-out property <int> selected_device: 0;
    // 连接状态文本(由 AppController::status_line 回填)
    in property <string> conn_status: "未连接";
    // DEVICE_INFO 原始 debug 展示文本(多行,由 AppController::device_info_text 回填)
    in property <string> device_info_text: "未获取到设备信息";
    // DEVICE_INFO 人可读摘要(固件/协议/通道/能力位已译成中文, 由 device_summary_text 回填)。
    // 主页默认只显示这份, 原始文本收进可折叠区。
    in property <string> device_summary_text: "未获取到设备信息";
    // 主页"原始诊断"折叠态: 真相源放在 AppWindow, 切页回来保持原样。
    in-out property <bool> diag_expanded: false;
    // 传感器健康总结 + 等级(0正常/1警告/2错误), 由 main.rs 回填。
    in property <string> sensor_health: "";
    in property <int> sensor_health_level: 0;
    // 配置页行数据(由 main.rs::build_config_rows 回填,version-gated 重建)
    in property <[ConfigRow]> config_rows: [];
    // 其中未归类("其他"组)的行数, 与 config_rows 同批回填。
    in property <int> config_other_count: 0;
    // 各分组行数: 空组据此就地自报原因(Slint 没有 filter/count, 数不出来)。
    in property <[ConfigGroupCount]> config_group_counts: [];

    // 绑区页数据(几何绘制版,由 main.rs::build_zone_cells 回填,每 tick 刷新
    // 以支持触摸实时高亮)
    in property <[HidPointCell]> hid_points: [];
    in property <image> hid_screenshot;
    in property <int> hid_screenshot_width: 0;
    in property <int> hid_screenshot_height: 0;
    in property <bool> hid_mode: false;
    in-out property <int> hid_selected_channel: -1;
    callback hid_screenshot_refresh();
    callback hid_point_commit(int, int, int);
    callback hid_point_enabled_set(int, bool);

    in property <[ZoneCell]> zones: [];
    in property <string> bind_status: "";
    in-out property <int> selected_zone: -1;
    in property <string> selected_zone_label: "";
    in property <int> selected_channel: -1;
    // 分区图绘制视框(内容 bbox), main.rs 从 touch_geometry::content_bbox 一次性回填。
    in property <float> zone_view_x: 0;
    in property <float> zone_view_y: 0;
    in property <float> zone_view_w: 1000;
    in property <float> zone_view_h: 562.5;

    // 曲线页数据 (#6g-2,由 main.rs::build_curve_paths/build_param_rows 回填)
    in-out property <int> sel_channel: 0;
    in-out property <bool> show_raw: false;
    in-out property <bool> show_bsln: false;
    in-out property <bool> show_diff: true;
    in-out property <int> scan_mode: 0;
    // 只在 DEVICE_INFO 诊断明确返回模式后置真，避免 UI 默认成自动模式。
    in property <bool> mode_known: false;
    in property <string> diff_path: "";
    in property <string> raw_path: "";
    in property <string> bsln_path: "";
    // ★主图线色的唯一真相源在 Rust 侧调色板(main.rs::SERIES_PALETTE)★: 同一张图内主曲线三条 +
    // 上报四条 + 触发判定共 8 条按出现顺序取色, 保证同图不重复。.slint 里不再写第二份色表。
    in property <color> raw_color: #3399ff;
    in property <color> bsln_color: #ffaa00;
    in property <color> diff_color: #33cc33;
    in property <color> active_color: #ff3399;
    in property <float> curve_y_min: 0;
    in property <float> curve_y_mid: 0;
    in property <float> curve_y_max: 0;
    in property <int> curve_point_count: 0;
    in property <float> finger_th_y: 500;
    in property <float> noise_th_y: 500;
    in property <int> finger_th_val: 0;
    in property <int> noise_th_val: 0;
    in property <[ParamRow]> curve_params: [];
    in property <string> cp_text: "未测量";
    in property <string> curve_readout: "";
    in property <string> active_path: "";
    in property <int> active_point_count: 0;
    in-out property <bool> show_active: true;
    // 算法上报叠加总开关(main.rs 读取以决定右轴量程与可见态)。
    in-out property <bool> show_algo_overlay: false;
    in property <float> active_norm_amp: 1;
    // 主图时间轴(真实设备时间)与右侧算法量纲纵轴, 由 main.rs 回填。
    in property <float> curve_t_span_ms: 0;
    in property <string> curve_t_end_text: "";
    in property <float> curve_r_min: 0;
    in property <float> curve_r_max: 1;
    // 单通道精调页右列两个折叠区块的展开态(放这里 → 切页重建不丢)。
    in-out property <bool> curve_params_expanded: true;
    in-out property <bool> curve_algo_cfg_expanded: false;
    in-out property <bool> curve_series_expanded: true;
    // 响应噪声频谱(增益档 0..6 × 分频 1..64)。★默认收起★: 它是一次改写本通道 gain/div、
    // 逐点重校准 448 次的重操作, 不该在打开页面时就挡在眼前。折叠态同样放这里, 切页不丢。
    in-out property <bool> curve_spectrum_expanded: false;
    in property <[SpectrumCell]> curve_spectrum_cells: [];
    in property <bool> curve_spectrum_active: false;
    in property <string> curve_spectrum_status: "";
    in property <string> focus_bandwidth: "";
    in property <float> curve_spectrum_progress: 0;
    callback curve_spectrum_start();
    callback curve_spectrum_cancel();
    // 绘图视窗是否冻结("停止" = 只冻画面, 遥测仍在收)。
    in property <bool> plot_frozen: false;

    // 全通道实时状态页数据(由 main.rs 每 tick 从 telem_latest 构建)
    in property <[ChannelStatus]> all_channels: [];
    // 全通道页"批量应用"抽屉: 勾选态真相源在 AppController, 走 batch_sel_version 门控回填。
    in property <[bool]> batch_ch_selected: [];
    in property <[bool]> batch_param_selected: [];
    in property <[ParamRow]> batch_param_rows: [];
    // ★可手改的"待写值"一列★: -1 = 面板上尚无值(源通道未回读且未手填)。围栏上下限随行下发,
    // 唯一来源是 Rust 侧 proto::telemetry::param_fence(与两处固件同源), .slint 不写第四份。
    callback batch_toggle_channel(int);
    callback batch_toggle_param(int);
    callback batch_param_value_set(int, int);   // param_id(0x01..0x0B), 新值
    callback batch_channels_all();
    callback batch_channels_invert();
    callback batch_params_all();
    callback batch_params_invert();
    callback batch_clear();
    callback batch_apply(int);
    callback batch_set_source(int);
    in property <int> batch_source: 0;
    // 批量启用/禁用(复用 PARAM_ENABLED=0x0C) + 抽屉收起时的会话清理。
    callback batch_enable_channels();
    callback batch_disable_channels();
    callback batch_drawer_closed();
    // 全通道页排序/筛选: 真正的排序与筛选在 Rust 侧做(逻辑顺序的唯一真相源是绑定映射),
    // 这两个属性只是把用户的选择传下去; channel_hidden_count 由 Rust 回填被筛掉的通道数。
    in-out property <int> channel_sort: 0;
    in-out property <bool> channel_show_disabled: false;
    in property <int> channel_hidden_count: 0;
    // ★采集开关与"画面冻结"是两件事★: 本对回调真正 停/开 设备遥测流(全通道页的按钮),
    // 而 plot_resume/plot_freeze 现在只管曲线页的绘图视窗冻结/解冻。
    callback telem_source_start();
    callback telem_source_stop();
    in property <bool> telem_paused: false;
    // 单通道精调页(曲线页)的通道启用开关: 与全通道页卡片、批量启停共用 PARAM_ENABLED=0x0C,
    // 由 Rust 侧按 sel_channel 回填/写入, 关闭后该页的校准/基线/频谱/参数编辑一并锁定。
    in property <bool> curve_ch_enabled: true;
    callback curve_ch_enable_set(bool);
    // 触控组合映射(多分区 → 多键)
    in property <[string]> combo_zones_text: [];
    in property <[string]> combo_keys_text: [];
    in property <[int]> combo_delay: [];
    in property <[int]> combo_max_hold: [];
    in property <[bool]> combo_zone_used: [];
    in property <[bool]> combo_zone_picked: [];
    in property <string> combo_pending_keys_text: "";
    in property <string> combo_status: "";
    in property <int> combo_count: 0;
    callback combo_zone_toggled(int);
    callback combo_zones_clear();
    callback combo_captured(string, bool, bool, bool, bool);
    callback combo_hid_submitted(string);
    callback combo_keys_clear();
    callback combo_add(int, int);   // delay_ms, max_hold_ms
    callback combo_removed(int);
    callback combo_hold_set(int, int, int);
    callback combo_key_capture_started(int);
    callback combo_key_captured(int, string, bool, bool, bool, bool);
    callback combo_key_hid_submitted(int, string);
    // 采样率(Hz)与设备实测探测周期(ms,两位小数)，由 main.rs 每 tick 从 AppController 回填
    in property <int> sample_rate_hz: 0;
    in property <string> curve_threshold_warning: "";
    in property <float> scan_period_ms: 0;
    // 设备实测探测周期原值(µs)，供 CSD 页与"期望周期"精确比较。
    in property <int> scan_period_us: 0;
    // 探测周期是否有实测值(遥测在跑且带 STATS)。★停流时 scan_period_* 恒为 0，界面必须显示
    // "未测"而不是 0 ms★——0 会被读成"设备真的 0ms"。主页/全通道页/全局调整页共用此标志。
    in property <bool> scan_period_valid: false;
    // 全局项(GPARAM_*)数字输入围栏，main.rs 启动时由 proto::telemetry::global_fence 一次性回填。
    in property <GlobalFences> global_fences;
    // 由当前 CSD 参数解算的理论采集周期下限(µs)，main.rs 每 tick 回填。
    in property <int> scan_period_expected_us: 0;

    // Phase 1 UI 现代化:左栏导航当前视图(0=主页,1=设置,2=工具箱,3=日志,4=关于),纯 UI 内部状态
    in-out property <int> current_view: 0;
    // 主页工作模式只读文案(Serial/HID/未知), 由 main.rs::work_mode_text 回填(草稿优先)。
    in property <string> work_mode_text: "未知";
    // 关于页: 上位机版本与仓库地址为编译期常量(一次性回填), 设备版本复用主页那份 DEVICE_INFO。
    in property <string> about_app_version: "";
    in property <string> about_repo_url: "";
    in property <string> about_device_versions: "";
    callback copy_repo_url();
    // 设置页当前子标签，与 SettingsPage/TabWidget 双向绑定。
    in-out property <int> settings_tab: 0;
    // 延迟卡数据(Phase 2 由固件填值,当前默认 0)
    in property <int> latency_total_us: 0;
    in property <int> latency_spi_us: 0;
    in property <int> latency_proc_us: 0;
    in property <int> latency_usb_us: 0;
    in property <int> latency_sensor_us: 0;
    in property <string> latency_corrected_text: "补正后延迟: 未启用";
    in-out property <bool> measure_latency: false;
    in property <string> log_text: "";
    in property <string> log_line_numbers: "";
    in-out property <int> log_filter: 2;   // 日志过滤等级 0=错误 1=警告 2=信息 3=调试

    in-out property <bool> log_auto_scroll: true;
    in property <bool> log_file_on: true;
    in property <string> log_file_path: "";
    in property <string> log_stats: "";
    callback set_log_filter(int);

    callback clear_log();
    callback copy_log_all();
    callback open_log_dir();
    callback set_log_file_enabled(bool);
    in property <string> lat_path: "";
    in property <float> lat_y_max: 1;
    in property <float> lat_y_min: 0;
    in property <int> lat_point_count: 0;
    // 触控键盘映射开关(由 main.rs 从 config_cache 的 comm.keyboard_map_en 回填)
    in property <bool> keyboard_map_en: false;
    // 设置有未保存到 flash 的改动(main.rs 从 AppController::is_config_dirty 回填)。
    in property <bool> config_dirty: false;
    in property <int> config_dirty_count: 0;   // 未保存项数(main.rs 回填)
    // 草稿含 mode.work(Serial/HID)改动: 需整机重启重枚举生效, 保存后自动重启并提示。
    in property <bool> mode_change_needs_reboot: false;
    // 键盘页数据(物理键盘 + 触控键盘映射), 由 main.rs 回填。
    in property <[bool]> kbd_phys_pressed: [];
    in property <[int]> kbd_phys_choice: [];
    in property <[int]> kbd_phys_mod: [];
    in property <[int]> kbd_zone_choice: [];
    in property <[int]> kbd_zone_mod: [];
    in property <[string]> kbd_zone_names: [];
    in property <[string]> kbd_key_choices: [];
    in property <[string]> kbd_phys_display: [];
    in property <[string]> kbd_zone_display: [];
    in property <[int]> kbd_phys_hold_delay: [];
    in property <[int]> kbd_phys_hold_max: [];
    in property <[int]> kbd_zone_hold_delay: [];
    in property <[int]> kbd_zone_hold_max: [];
    // 物理键盘页: 去抖前/实际输出实时态 + 每键极性/防抖 + 逻辑分析仪视图(由 main.rs 回填)。
    in property <[bool]> kbd_phys_raw: [];
    in property <[bool]> kbd_phys_out: [];
    // 极性配置态(0=低/1=高/2=AUTO)与固件解析后的生效极性(true=高电平触发)。
    in property <[int]> kbd_phys_pol_mode: [];
    in property <[bool]> kbd_phys_pol_resolved_high: [];
    in property <[bool]> kbd_phys_pol_resolved_known: [];
    in property <[int]> kbd_phys_debounce: [];
    in property <string> kbd_keycfg_status: "";
    in property <[string]> la_raw_paths: [];
    in property <[string]> la_deb_paths: [];
    in property <[string]> la_out_paths: [];
    in property <[string]> la_trig_text: [];
    in property <[float]> la_trig_x: [];
    in property <[string]> la_time_labels: [];
    in property <string> la_status: "";
    in property <string> la_span_text: "";
    in property <[string]> la_window_names: [];
    in property <int> la_window_index: 0;
    // 物理键盘页三个抽屉的折叠态: 放 AppWindow 上双向绑定, 切页重建也不丢(同 CollapsibleSection 约定)。
    in-out property <bool> phys_live_expanded: true;
    in-out property <bool> phys_keys_expanded: false;
    in-out property <bool> phys_la_expanded: false;

    // 顶层由 UI 侧(main.rs)绑定,驱动 AppController 对应方法
    callback refresh();
    callback connect_clicked();
    callback disconnect_clicked();
    callback reboot_device();
    callback reboot_bootloader();
    callback reboot_psoc();
    callback auto_tune();               // 全通道频率自适应 → AppController::auto_tune(0xFF)
    callback global_calibrate();        // 全通道校准 → AppController::calibrate(全通道掩码)
    callback global_baseline_reset();   // 全通道基线复位 → AppController::baseline_reset(全通道掩码)
    callback calib_pref_set(int);       // 校准频率偏好 1..7 → set_config_number("calib.pref")
    in property <int> calib_pref: 4;    // 由 main.rs 每 tick 从 calib.pref(草稿优先)回填
    /// 串行下发队列剩余项数(含在途), 由 main.rs 从 AppController::cfg_tx_pending() 回填。
    in property <int> save_pending: 0;
    callback curve_auto_tune();         // 本通道频率自适应 → AppController::auto_tune(sel_channel)
    in property <string> curve_auto_tune_status: "";
    // 阻塞类操作(校准/基线/重启/自适应)状态: main.rs 每 tick 回填, 驱动各页按钮锁定+运行标识。
    in property <bool> op_busy: false;
    in property <string> op_label: "";
    in property <string> auto_tune_status: "";
    // 全通道操作的 host 侧串行队列(逐通道校准/基线/频率自适应)状态。上面那三个 callback 现在都
    // 落到这条队列上(而不是让固件自己 for 36 遍), 于是三者共用同一份进度/取消/状态文案。
    in property <bool> batch_op_active: false;
    in property <float> batch_op_progress: 0;
    in property <string> batch_op_status: "";
    callback batch_op_cancel();
    // "Cp 辅助": 逐通道自适应按实测 Cp 推每通道的增益档/频率偏好档。
    in property <bool> cp_assist: false;
    callback set_cp_assist(bool);
    // 延迟测量开关(Phase 2 前先接 no-op)
    callback latency_measure_toggled(bool);
    // 触控键盘映射开关 → CFG_SET(comm.keyboard_map_en)
    callback set_keyboard_map_en(bool);
    // 键盘映射回调
    callback kbd_set_phys(int, int, int);
    callback kbd_set_zone(int, int, int);
    callback kbd_set_hold_phys(int, int, int);
    callback kbd_set_hold_zone(int, int, int);
    callback kbd_capture_phys(int, string, bool, bool, bool, bool);
    callback kbd_hid_phys(int, string);
    callback kbd_capture_zone(int, string, bool, bool, bool, bool);
    callback kbd_clear_phys(int);
    callback kbd_clear_zone(int);
    callback kbd_set_keycfg(int, int, int);   // idx, 极性(0=低/1=高/2=AUTO), 防抖 us
    callback la_window_set(int);
    callback la_clear();

    // 配置页回调(透传给内部 ConfigPage 实例)
    callback cfg_set_bool(string, bool);
    callback cfg_set_number(string, float);
    callback cfg_set_number_hex(string, string);
    callback cfg_set_enum(string, int);
    callback cfg_set_string(string, string);
    callback cfg_load();
    callback cfg_save();
    callback cfg_reset();
    callback settings_export(bool, bool, bool, bool, bool, bool);
    callback settings_import(bool, bool, bool, bool, bool, bool);
    // 范围弹窗中的配置项数量由 Rust 从当前缓存更新；其余为固定协议槽位数。
    in property <int> settings_io_config_count: 0;
    in property <int> settings_io_channel_params_count: 396;
    in property <int> settings_io_globals_count: 8;
    in property <int> settings_io_algo_count: 10;
    in property <int> settings_io_keyboard_count: 46;
    in property <int> settings_io_zones_count: 34;
    callback discard_draft();

    // 绑区页回调(几何绘制版,透传给内部 BindingPage 实例)
    callback bind_load();
    callback zone_selected(int);
    callback zone_activated(int);
    callback zone_channel_set(int, int);
    callback bind_touch_start(int);
    callback bind_listen_cancel();
    callback zone_unbind(int);
    pure callback zone_hit_test(float, float) -> int;
    callback interactive_bind();
    callback interactive_bind_cancel();
    in property <bool> interactive_active: false;
    in property <bool> mai2_send_en_known: false;
    in property <bool> mai2_send_en: false;
    in property <string> mai2_status: "未知";
    in property <string> mai2_baud: "未知";
    // mai2serial 区块折叠态(默认折叠): 真相源在此, 经 SettingsPage 透传到协议页。
    in-out property <bool> mai2_panel_expanded: false;
    callback mai2_set_send_en(bool);
    callback mai2_refresh();

    // mai2light 灯板协议(协议页): 真相源在此, 经 SettingsPage 透传到 ProtocolPage。
    in property <bool> light_known: false;
    in property <bool> light_chain0_ready: false;
    in property <bool> light_chain1_ready: false;
    in property <string> light_init_fault: "";
    in property <string> light_status: "未知";
    in property <string> light_resp_en: "未知";
    in property <string> light_baud: "未知";
    in property <string> light_rx_frames: "未知";
    in property <string> light_sum_errors: "未知";
    in property <[LedUnitRow]> light_units: [];
    in property <string> light_conflict: "";
    in property <string> light_apply_status: "";
    in property <int> light_ws_count0: 0;
    in property <int> light_ws_count1: 0;
    in property <int> light_brightness: 0;
    // 灯效面板折叠态: 默认折叠, 展开才值得低频轮询采样色(轮询门控在 Rust 侧 tick)。
    in-out property <bool> light_panel_expanded: false;
    callback light_refresh();
    callback light_map_set(int, int, int, int);
    callback light_map_apply();
    callback light_preview(int, int, int, int);
    callback light_ws_count_set(int, int);
    callback light_brightness_set(int);

    // 曲线页回调 (#6g-2,透传给内部 CurvesPage 实例)
    callback plot_resume();
    callback plot_freeze();
    callback curve_calibrate();
    callback curve_baseline_reset();
    callback curve_measure_cp();
    // 二值算法线归一化幅度 N 设置。
    // ★已删除 plot_area_resized★: 主图 PlotPath 改用 fit: fill(非等比拉伸), 曲线铺满与绘图区
    // 宽高比无关, Rust 侧不再需要知道宽高比。
    callback report_norm_set(int, float);
    callback threshold_set(int, int);
    callback curve_param_edited(int, int);
    callback curve_mode_changed(int);
    callback curve_capture_params();
    callback channel_selected(int);

    // 算法页(透传给 SettingsPage → AlgoPage)
    in property <string> algo_info_text: "算法信息未读取";
    in property <string> global_summary_text: "当前设备全局参数：未读取";
    in-out property <string> algo_c_source;
    in property <string> algo_line_numbers: "1";
    in property <string> algo_status: "";
    // 编译/上传同步执行时的阶段反馈；忙碌期间锁定一键操作以避免重入。
    in property <bool> algo_busy: false;
    in property <string> algo_phase: "";
    in property <string> algo_asm: "";
    in property <int> algo_asm_bytes: 0;
    in property <int> algo_asm_capacity: 1024;
    in property <int> algo_c_bytes: 0;
    in property <int> algo_c_capacity: 32768;
    in property <[AlgoMetadataRow]> algo_metadata_rows: [];
    in property <[AlgoSettingRow]> algo_setting_rows: [];
    in property <int> g_inactive_sns: 1;
    in property <int> g_idac_gain: 4;
    in property <int> g_idac_sense_config: 0;   // 0=IDAC sourcing, 1=IDAC sinking
    in property <int> g_auto_calibrate: 1;      // 1=自动校准, 0=固定IDAC(不自动校准)
    in property <int> g_idac_min: 20;
    in property <int> g_raw_target: 85;
    in property <int> g_mfs_div_f1: 1;
    in property <int> g_mfs_div_f2: 2;
    in property <int> csd_sns_clk_div: 0;
    // 全 36 通道 snsClk 分频范围(逐通道自适应后各通道不同 → 时钟树按范围展示; 0=未知)。
    in property <int> csd_sns_clk_div_min: 0;
    in property <int> csd_sns_clk_div_max: 0;
    in property <int> csd_resolution: 0;
    in property <int> csd_sns_clk_source: 0;
    // 时钟源单选项(文本/下发值/当前下标)由 Rust 侧 ParamFence::ui_choices() 派生, 界面不自造标签。
    in property <[string]> csd_clk_labels: [];
    in property <[int]> csd_clk_values: [];
    in property <int> csd_clk_index: -1;
    // 异常采样标识 + 下一步动作指引(0=正常 1=警告 2=异常)。
    in property <string> sampling_advice: "";
    in property <int> sampling_advice_level: 0;
    // Cp 测量失败的通道列表(形如 "CH0 CH5"), 空串 = 无失败。★唯一判据是设备回读 0x00FFFFFF★,
    // 不从接法/railed/采样率反推。
    in property <string> cp_failed_channels: "";
    callback psoc_rescue();               // PSoC 救砖: SWD 强制重刷 PSoC + 重新下发算法/CSD
    callback algo_refresh();
    callback algo_reset_default();
    callback algo_compile(string);
    callback algo_upload();
    callback algo_build_upload(string);
    callback algo_load_template(int);
    callback algo_source_edited(string);
    callback algo_setting_edited(int, int);
    callback algo_global_set(int, int);
    callback csd_param_set(int, int);

    // 工具箱页(透传给内部 ToolboxPage 实例)
    in property <bool> auto_port_enabled: false;
    in property <int> serial_com: 3;
    in property <int> light_com: 21;
    in property <string> port_status: "";
    callback set_auto_port_enabled(bool);
    callback set_serial_com(int);
    callback set_light_com(int);
    callback apply_ports();

    // 虚拟扫码摄像头(透传给内部 ToolboxPage 实例)
    in property <bool> vcam_enabled: false;
    in property <int> vcam_submit_secs: 2;
    in property <int> vcam_display_secs: 10;
    in property <string> vcam_last_data: "";
    in property <image> vcam_preview;
    // 当前是否已提权, 以及一句话受限说明(由 Rust 侧的 elevation 模块给出)。
    in property <bool> is_elevated: false;
    in property <string> elevation_text: "";
    callback restart_as_admin();
    in property <string> vcam_install_status: "未安装";
    in property <string> vcam_runtime_status: "未运行";
    // 部署(安装/卸载)是否在进行中: 两者改同一批注册表键与文件, 只能有一个在跑,
    // 故用**同一个**属性同时禁掉两个按钮(单一真值, 不给两个按钮各来一个标志)。
    in property <bool> vcam_deploy_busy: false;
    // 输入源设备树(组头 + 设备项), 由 Rust 侧按分类展平后填充。
    in property <[VcamKbdRow]> vcam_kbd_rows;
    in property <int> vcam_device_index: 0;
    callback set_vcam_enabled(bool);
    callback set_vcam_submit_secs(int);
    callback set_vcam_display_secs(int);
    callback set_vcam_device(int);
    callback refresh_vcam_devices();
    callback install_vcam();
    callback uninstall_vcam();

    background: #15181c;

    HorizontalBox {
        padding: 0px;
        spacing: 0px;

        // 左侧导航栏
        Rectangle {
            // ★宽窗口保持 160px 设计宽度, 窄窗口自动让位到 104px★ 全部用布局约束表达, 不写
            // width: 也不读 root.width —— 子元素宽度一旦依赖父/窗口宽度就会形成
            // layoutinfo-h → width → layoutinfo-h 绑定环(Slint 1.17 已标记弃用并可能运行时 panic)。
            // 约束的含义: preferred == max == 160px → 空间富余时布局处于 Grow 阶段, 本栏无可增长
            // 余量, 多出来的宽度全归右侧主区; 空间不足时进入 Shrink 阶段, 按 stretch 比例分摊,
            // 本栏只承担 0.2/1.2 的收缩量且最低到 104px("工具箱"三字 + 内边距的真实下限)。
            min-width: 104px;
            max-width: 160px;
            preferred-width: 160px;
            horizontal-stretch: 0.2;
            background: #1a1e22;

            VerticalBox {
                padding: 10px;
                spacing: 4px;

                Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.current_view == 0 ? #2b7de9 : transparent;

                    TouchArea {
                        clicked => { root.current_view = 0; }
                    }

                    Text {
                        text: "主页";
                        color: #ffffff;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.current_view == 1 ? #2b7de9 : transparent;

                    TouchArea {
                        clicked => { root.current_view = 1; }
                    }

                    Text {
                        text: "设置";
                        color: #ffffff;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.current_view == 2 ? #2b7de9 : transparent;

                    TouchArea {
                        clicked => { root.current_view = 2; }
                    }

                    Text {
                        text: "工具箱";
                        color: #ffffff;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.current_view == 3 ? #2b7de9 : transparent;

                    TouchArea {
                        clicked => { root.current_view = 3; }
                    }

                    Text {
                        text: "日志";
                        color: #ffffff;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                // 关于入口置于连接状态条之上: 属于"不常用但要找得到"的一类, 与上面四项同款。
                Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.current_view == 4 ? #2b7de9 : transparent;

                    TouchArea {
                        clicked => { root.current_view = 4; }
                    }

                    Text {
                        text: "关于";
                        color: #ffffff;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                HorizontalBox {
                    padding: 4px;
                    spacing: 6px;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.conn_status == "已连接" ? #2b8a3e : #888888;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: root.conn_status;
                        color: #b0b8c0;
                        font-size: 11px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // 右侧主区
        Rectangle {
            horizontal-stretch: 1;
            background: #15181c;

            if root.current_view == 0: DashboardPage {
                device_labels: root.device_labels;
                selected_device <=> root.selected_device;
                conn_status: root.conn_status;
                device_info_text: root.device_info_text;
                device_summary_text: root.device_summary_text;
                work_mode_text: root.work_mode_text;
                diag_expanded <=> root.diag_expanded;
                sensor_health: root.sensor_health;
                sensor_health_level: root.sensor_health_level;
                sample_rate_hz: root.sample_rate_hz;
                scan_period_ms: root.scan_period_ms;
                scan_period_valid: root.scan_period_valid;
                scan_mode <=> root.scan_mode;
                latency_total_us: root.latency_total_us;
                latency_spi_us: root.latency_spi_us;
                latency_proc_us: root.latency_proc_us;
                latency_usb_us: root.latency_usb_us;
                latency_sensor_us: root.latency_sensor_us;
                latency_corrected_text: root.latency_corrected_text;
                measure_latency <=> root.measure_latency;
                lat_path: root.lat_path;
                lat_y_max: root.lat_y_max;
                lat_y_min: root.lat_y_min;
                lat_point_count: root.lat_point_count;
                refresh() => { root.refresh(); }
                connect_clicked() => { root.connect_clicked(); }
                disconnect_clicked() => { root.disconnect_clicked(); }
                reboot_device() => { root.reboot_device(); }
                reboot_bootloader() => { root.reboot_bootloader(); }
                reboot_psoc() => { root.reboot_psoc(); }
                mode_changed(m) => { root.curve_mode_changed(m); }
                latency_measure_toggled(v) => { root.latency_measure_toggled(v); }
            }

            if root.current_view == 1: SettingsPage {
                settings_tab <=> root.settings_tab;
                save_pending: root.save_pending;
                config_rows: root.config_rows;
                config_other_count: root.config_other_count;
                config_group_counts: root.config_group_counts;
                device_summary_text: root.device_summary_text;
                algo_info_text: root.algo_info_text;
                global_summary_text: root.global_summary_text;
                config_dirty: root.config_dirty;
                config_dirty_count: root.config_dirty_count;
                mode_change_needs_reboot: root.mode_change_needs_reboot;
                cfg_set_bool(k, v) => { root.cfg_set_bool(k, v); }
                cfg_set_number(k, v) => { root.cfg_set_number(k, v); }
                cfg_set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                cfg_set_enum(k, v) => { root.cfg_set_enum(k, v); }
                cfg_set_string(k, v) => { root.cfg_set_string(k, v); }
                cfg_load() => { root.cfg_load(); }
                cfg_save() => { root.cfg_save(); }
                cfg_reset() => { root.cfg_reset(); }
                settings_export(a, b, c, d, e, f) => { root.settings_export(a, b, c, d, e, f); }
                settings_import(a, b, c, d, e, f) => { root.settings_import(a, b, c, d, e, f); }
                settings_io_config_count: root.settings_io_config_count;
                settings_io_channel_params_count: root.settings_io_channel_params_count;
                settings_io_globals_count: root.settings_io_globals_count;
                settings_io_algo_count: root.settings_io_algo_count;
                settings_io_keyboard_count: root.settings_io_keyboard_count;
                settings_io_zones_count: root.settings_io_zones_count;
                reboot_psoc() => { root.reboot_psoc(); }
                discard_draft() => { root.discard_draft(); }
                auto_tune() => { root.auto_tune(); }
                global_calibrate() => { root.global_calibrate(); }
                global_baseline_reset() => { root.global_baseline_reset(); }
                calib_pref: root.calib_pref;
                calib_pref_set(v) => { root.calib_pref_set(v); }
                op_busy: root.op_busy;
                op_label: root.op_label;
                auto_tune_status: root.auto_tune_status;
                batch_op_active: root.batch_op_active;
                batch_op_progress: root.batch_op_progress;
                batch_op_status: root.batch_op_status;
                batch_op_cancel() => { root.batch_op_cancel(); }
                cp_assist: root.cp_assist;
                set_cp_assist(on) => { root.set_cp_assist(on); }

                hid_points: root.hid_points;
                hid_screenshot: root.hid_screenshot;
                hid_screenshot_width: root.hid_screenshot_width;
                hid_screenshot_height: root.hid_screenshot_height;
                hid_mode: root.hid_mode;
                hid_selected_channel <=> root.hid_selected_channel;
                hid_screenshot_refresh() => { root.hid_screenshot_refresh(); }
                hid_point_commit(ch, x, y) => { root.hid_point_commit(ch, x, y); }
                hid_point_enabled_set(ch, on) => { root.hid_point_enabled_set(ch, on); }

                zones: root.zones;
                bind_status: root.bind_status;
                selected_zone: root.selected_zone;
                selected_zone_label: root.selected_zone_label;
                selected_channel: root.selected_channel;
                zone_view_x: root.zone_view_x;
                zone_view_y: root.zone_view_y;
                zone_view_w: root.zone_view_w;
                zone_view_h: root.zone_view_h;
                bind_load() => { root.bind_load(); }
                interactive_bind() => { root.interactive_bind(); }
                interactive_bind_cancel() => { root.interactive_bind_cancel(); }
                interactive_active: root.interactive_active;
                mai2_send_en_known: root.mai2_send_en_known;
                mai2_send_en: root.mai2_send_en;
                mai2_status: root.mai2_status;
                mai2_baud: root.mai2_baud;
                mai2_panel_expanded <=> root.mai2_panel_expanded;
                mai2_set_send_en(enabled) => { root.mai2_set_send_en(enabled); }
                mai2_refresh() => { root.mai2_refresh(); }
                light_known: root.light_known;
                light_chain0_ready: root.light_chain0_ready;
                light_chain1_ready: root.light_chain1_ready;
                light_init_fault: root.light_init_fault;
                light_status: root.light_status;
                light_resp_en: root.light_resp_en;
                light_baud: root.light_baud;
                light_rx_frames: root.light_rx_frames;
                light_sum_errors: root.light_sum_errors;
                light_units: root.light_units;
                light_conflict: root.light_conflict;
                light_apply_status: root.light_apply_status;
                light_ws_count0: root.light_ws_count0;
                light_ws_count1: root.light_ws_count1;
                light_brightness: root.light_brightness;
                light_panel_expanded <=> root.light_panel_expanded;
