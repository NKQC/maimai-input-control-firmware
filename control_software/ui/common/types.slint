// ==========================================================================
// 公共数据结构 (Rust 侧 build_* 回填的展平行模型)
// ★本文件只放 export struct★: Rust 侧生成的类型名与字段一一对应, 改名即破坏 main.rs。
// ==========================================================================

// 一条配置行的展平数据,由 main.rs::build_config_rows 从 ConfigEntry 转换而来。
// kind: 0=Bool(CheckBox) 1=Number(SpinBox) 2=Enum(ComboBox,当前仅 mode.work)
//       3=String(LineEdit) 4=LedColor(专用颜色 ComboBox)
// type_code 沿用 proto::config::ConfigValueType 编码(Bool=0..String=6),
// 用于 main.rs 回调里按原类型重建 CfgValue。
export struct ConfigRow {
    key: string,
    label: string,
    desc: string,
    group: string,
    kind: int,
    type_code: int,
    bool_val: bool,
    num_val: float,
    min_val: float,
    max_val: float,
    has_range: bool,
    enum_index: int,
    str_val: string,
    // 数字型配置的十六进制口径: hex_val=当前值(如 "0x1E"), range_hex=取值范围(如 "0x00–0xFF (0–255)")。
    // 仅整数型(U8/U16/U32/I8)非空; 浮点/布尔/枚举/字符串为空串。
    hex_val: string,
    range_hex: string,
}

// 每个分组实际有多少行。★为什么必须由 Rust 回填★: Slint 没有 filter/count, 组件内部数不出
// "属于本组的行数", 于是"本组 0 行"就只能表现为一片空白 —— 空白说不出是"没取到配置""归组名对不上"
// 还是"页面没接上数据源"。有了这个计数, 每个组都能就地给出明确原因, 而不是让用户对着空白猜。
export struct ConfigGroupCount {
    group: string,
    count: int,
}

// 一个绑区槽位的展平数据,由 main.rs::build_zone_cells 从
// AppController::binding_channel_of()/telem_latest() 转换而来。34 个
// (index 0..33)。ring: 分组标签("A".."E"),沿用既有分组约定。
// channel: 绑定的物理通道索引(0..35),-1=未映射。
// touched: 绑定通道当前是否被触摸(status bit0),驱动几何图实时高亮。
// cx/cy: 该分区圆心在画布 0..1000 归一化坐标系下的位置,由 main.rs 按
// maimai 圆形分区几何(A/D 外环,B/E 内环,C 中心)预先算好回填,UI 侧
// 只管按比例绘制,不在 Slint 里做三角函数计算(更稳)。
export struct ZoneCell {
    index: int,
    label: string,
    ring: string,
    channel: int,
    binding_text: string,
    cp_text: string,
    touched: bool,
    binding_active: bool,
    path: string,
    path_x: float,
    path_y: float,
    path_width: float,
    path_height: float,
    label_x: float,
    label_y: float,
}

// 一条参数行的展平数据,由 main.rs::build_param_rows 从
// AppController::param(ch, pid) 转换而来。
// min/max = 该参数的合法输入范围, 由 Rust 侧 `proto::telemetry::param_fence` 单一声明表填充
// (main.rs::build_param_rows)。★不许在 .slint 里按 param_id 硬编码阈值★: 那会变成第三份围栏,
// 与固件两处必然漂移(历史上 SNS_CLK_SOURCE 就被 slint 写死上界 6, 把设备合法的 128 = AUTO 标志
// 夹成 6, 用户一碰这一行就把 AUTO 标志抹掉)。
export struct ParamRow {
    param_id: int,
    label: string,
    value: int,
    min: int,
    max: int,
    // ★单选项(非空 ⇒ 用单选而不是数字框)★ 由 Rust 侧 `ParamFence::ui_choices()` 填充。
    // 凡带 AUTO 标志位、取值离散、或可选值少于 16 的参数一律走这条路:
    // 数字框在这些参数上必然让用户填出非法值(SNS_CLK_SOURCE 的 UI 区间 0..134 里 7..127 全是空洞),
    // 而"128 = AUTO"这种编码更不该让用户去背。choice_values[i] 是第 i 项实际下发的值。
    choices: [string],
    choice_values: [int],
    // 设备真值对应的下标; -1 = 设备当前值不在合法取值内(界面必须如实说明, 不许假装选中某项)。
    choice_index: int,
    // ★参数元数据(与围栏同源)★ 由 Rust 侧 `ParamFence` 的 unit / help_text() 填充。
    // unit = 计量单位(无量纲则空串), 显示在标签后面; help = "?" 悬浮时展示的完整详解
    // (含协议名/ID/作用域/取值范围/越界处理/说明/影响范围, 由 Rust 一处拼好)。
    // ★不许在 .slint 里按 param_id 写说明文案★: 那就是第二份元数据, 与围栏一样必然漂移。
    unit: string,
    help: string,
}

// 响应噪声频谱的一个格子(main.rs::build_spectrum_cells 从 AppController::noise_sweep_cells 转换)。
// gain 0..6, div 1..64; std/pp 为该点实测 RAW 标准差与峰峰值(ADC 计数)。
// norm = std 在本次扫描全部有效格中的归一化位置(0..1), 供热图上色 —— ★归一化在 Rust 侧算★,
// Slint 数不出"全部格子的最大值"。railed = 该点 RAW 撞顶/贴底, 其"低噪声"是假象, 必须区别标注。
export struct SpectrumCell {
    gain: int,
    div: int,
    std: float,
    pp: float,
    norm: float,
    valid: bool,
    railed: bool,
    tint: color,
}

// 全局项(GPARAM_*)的数字输入围栏, 由 main.rs::build_global_fences 从 Rust 侧单一声明表
// `proto::telemetry::global_fence` 填充。★与 ParamRow.min/max 同一理由: 不许在 .slint 里按
// gparam_id 硬编码阈值★ —— 那会成为与两处固件必然漂移的第三份围栏。
// 用一个 struct 而不是十来个平行 int 属性, 是为了只穿一层属性就能透传三层(app → settings → 本页)。
// INACTIVE_SNS(0x01) 取值离散({1,2,4}) 由 ComboBox 表达, 不需要数值上下界, 故不在此列。
export struct GlobalFences {
    idac_gain_min: int,
    idac_gain_max: int,
    idac_min_min: int,
    idac_min_max: int,
    raw_target_min: int,
    raw_target_max: int,
    mfs_f1_min: int,
    mfs_f1_max: int,
    mfs_f2_min: int,
    mfs_f2_max: int,
}

// 单通道实时状态，由 main.rs 每 tick 从 AppController::telem_latest(ch) 构建(36 个)。
// grid_col/grid_row 和 binding_text 均在 Rust 侧计算，Slint 仅消费明确数据。
export struct ChannelStatus {
    index: int,
    label: string,
    active: bool,
    raw: int,
    diff: int,
    grid_col: int,
    grid_row: int,
    binding_text: string,
    cp_text: string,
    // 数据停滞标记: raw 长时间逐帧完全不变(设备仍在出帧) → 疑似该通道扫描/测量卡死或链路停滞
    // 非真实恒定读数。UI 明确标红提示, 杜绝"是真值还是卡住"的忙猜。
    frozen: bool,
    // 通道启用开关(PARAM_ENABLED=0x0C, 草稿优先)。false = 该通道的电极保持模拟高阻、不参与扫描,
    // 读数恒为 0 且不会触发。UI 据此整卡灰显并禁掉一切对它无意义的操作。
    enabled: bool,
    // 展示次序里的位次(0 起)。★排序在 Rust 侧做★: 逻辑顺序的唯一真相源是现有绑定映射
    // (AppController::binding_channel_of), 在 Slint 里复制一份映射必然与绑定页漂移。
    order: int,
    // 链路新鲜度: 0=正常 1=遥测过期 2=连接离线/未知。Rust 复用 psoc_link_evidence 判定。
    telemetry_state: int,
}

// 兼容曲线页内部过渡数据结构；算法页不再展示/回填 report 折线。
export struct AlgoReportLine {
    idx: int,
    name: string,
    path: string,
    visible: bool,
    is_binary: bool,
    norm_amp: float,
    line_color: color,
    // ★以下三项一律来自 C 源声明, 不是按运行数据反推的★: value_type/range 取
    // ALGO_REPORT_META 的类型与 min..max, 旧式 ALGO_REPORT 没有声明时给空串(整块不显示,
    // 而不是编一个 "u16 0..65535" 冒充声明事实)。current_value 是该槽最近一次运行值。
    value_type: string,
    range: string,
    current_value: string,
}

// 算法变量元数据行：由源码声明生成，AlgoPage 展示名称、类型、范围、当前值、介绍与别名。
export struct AlgoMetadataRow {
    idx: int,
    name: string,
    value_type: string,
    range: string,
    current_value: string,
    alias: string,
    description: string,
    kind: string,
}

// 算法可调变量行：保留编辑器所需的默认值/数值，同时携带元数据。
export struct AlgoSettingRow {
    idx: int,
    name: string,
    default_val: int,
    value: int,
    value_type: string,
    range: string,
    alias: string,
    description: string,
}
// 虚拟摄像头输入源设备树的一行: 组头(分类)或设备项。
// 日志页一行。no=全局行号(跨过滤稳定, 便于指位与去重), level: 0错误 1警告 2信息 3调试。
export struct LogRow {
    no: int,
    level: int,
    text: string,
}

export struct VcamKbdRow {
    // true=组头(不可选), false=可选设备项。
    is_group: bool,
    // 缩进层级: 0=分类, 1=物理设备, 2=该设备下的 HID 集合。
    level: int,
    // 组头=分类名; 设备项=设备描述(SetupAPI 友好名)。
    title: string,
    // 组头=该类设备个数说明; 设备项=厂商 · VID/PID · 父设备。
    detail: string,
    // -1=组头; 0="所有键盘"; >=1 对应第 (dev_index-1) 个枚举设备。
    dev_index: int,
}

// 一个虚拟 LED 单元的展平数据(main.rs::build_led_unit_rows 从 AppController 转换)。
// unit: 0..10; 0..7=按键灯 8=Body 9=Ext 10=Side。
// sample: LED_GET 回报的当前有效颜色(预览生效时即预览色), 直接给色块上色。
// ch_choice: 下拉索引 0=未映射 1=通道0 2=通道1(与固件 ch=0xFF/0/1 一一对应)。
export struct LedUnitRow {
    unit: int,
    label: string,
    sample: color,
    rgb_text: string,
    ch_choice: int,
    start: int,
    count: int,
}

// HID 触控点位页的一行(= 一个物理通道)。
// ★x/y 是屏幕归一坐标(0..32767), 不是像素★: 与固件 HID 触屏描述符的 LOGICAL_MAXIMUM 同域
// (见 app_state::HID_COORD_MAX / 固件 TOUCH_LOGICAL_MAX), 因此换分辨率、换缩放都不需要重锚。
// 画布上的像素位置由归一坐标 + 当前缩放/平移实时换算, 存储值与显示变换彻底解耦。
export struct HidPointCell {
    channel: int,
    label: string,      // "CH0".."CH35"
    enabled: bool,      // 该通道是否输出触摸点
    x: int,             // 归一 X(0..32767)
    y: int,             // 归一 Y(0..32767)
    coord_text: string, // 右栏摘要文案(未锚定 / x,y)
    touched: bool,      // 该通道此刻是否被触摸(遥测实时态, 便于确认锚的是哪一片)
}
