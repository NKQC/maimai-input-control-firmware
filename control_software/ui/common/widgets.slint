// ==========================================================================
// 公共可复用组件 (跨页面共享, 不含任何页面业务逻辑)
// ==========================================================================

import { HorizontalBox, SpinBox, CheckBox, LineEdit, ComboBox, Button } from "std-widgets.slint";
import { ParamRow, AlgoSettingRow, AlgoReportLine } from "types.slint";
import { Theme } from "theme.slint";

// ============================================================================
// 通用可折叠区块
// ============================================================================

// 标题行(箭头 + 标题 + 右侧摘要) + 内容区(仅展开时实例化)。
// 折叠态由使用方的 in-out property 提供并两向绑定 → 存到 AppWindow 中, 切页重建也不丢。
// 交互沿用项目既有手写风格(Rectangle + TouchArea), 不引入第三方控件。
export component CollapsibleSection inherits Rectangle {
    in property <string> title;
    // 折叠时显示在标题行右侧的一行摘要, 收起状态也能一眼看到关键值。
    in property <string> summary;
    in-out property <bool> expanded: false;

    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;

    // 与 SectionCard 共用同一套卡片度量(内边距/行距/标题行高), 折叠区块与常规分区卡片
    // 在同一页里并排时才不会一高一矮、一疏一密。
    VerticalLayout {
        padding: Theme.card-pad;
        spacing: Theme.card-inner-gap;

        Rectangle {
            height: Theme.card-title-height;
            HorizontalLayout {
                spacing: Theme.gap;
                Text {
                    width: 14px;
                    text: root.expanded ? "▼" : "▶";
                    color: Theme.accent;
                    font-size: Theme.fs-normal;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    color: Theme.text-title;
                    font-weight: 700;
                    font-size: Theme.fs-title;
                    vertical-alignment: center;
                }
                Text {
                    // 展开后摘要让位给内容, 避免同一信息两处并存。
                    text: root.expanded ? "" : root.summary;
                    color: Theme.text-sub;
                    font-size: Theme.fs-normal;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
        }

        // 内容区。Slint 不允许把 @children 放进条件元素(if), 故折叠用"高度归零 + clip 裁切"实现,
        // 展开时高度取内容自身首选高度 ——效果等价于条件实例化, 且外层布局会随之伸缩。
        Rectangle {
            clip: true;
            height: root.expanded ? body.preferred-height : 0px;
            body := VerticalLayout {
                padding: 0px;
                spacing: Theme.gap;
                @children
            }
        }
    }
}

// ============================================================================
// 功能分区卡片
// ----------------------------------------------------------------------------
// ★为什么不再用 std-widgets 的 GroupBox★ 它只画一行标题文字, 没有底色也没有描边, 于是一页里
// 五六个功能组看上去就是一串等距的行 —— "这一组从哪开始、到哪结束"完全要靠读文字去推。本组件把
// 分区做成实体卡片: 底色 + 描边 + 圆角 + 标题左侧一条强调色竖条, 组间距(card-gap)明显大于组内
// 行距(card-inner-gap), 扫一眼就能数出这一页有几个功能组。
// 度量全部取自 Theme 的卡片令牌, 与 CollapsibleSection 完全一致(两者常在同一页并排出现)。
export component SectionCard inherits Rectangle {
    in property <string> title;
    // 标题右侧的一行摘要/补充说明(可选), 过长时省略, 不挤走标题。
    in property <string> subtitle;
    // 标题竖条颜色。★这是本组件唯一的语义变体入口★: 常规组用默认强调色, "待提交/新建"用
    // Theme.pick, "危险与恢复"用 Theme.err —— 用一条 3px 竖条区分组的性质, 不必再给每种组
    // 单独设计一套配色。
    in property <color> tint: Theme.accent;

    // ★必须 vertical-stretch: 0★ 否则视口比内容高时多余高度会被各卡片平分, 卡片内的表单行随之
    // 被摊开(行高不再统一)。多余空间统一由页面末尾的弹性占位吸收。
    vertical-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;

    VerticalLayout {
        padding: Theme.card-pad;
        spacing: Theme.card-inner-gap;

        HorizontalLayout {
            height: Theme.card-title-height;
            spacing: Theme.gap;
            // 竖条不给 height ⇒ 由布局撑满标题行, 卡片标题行高变化时无需同步改这里。
            Rectangle {
                width: 3px;
                horizontal-stretch: 0;
                border-radius: 1.5px;
                background: root.tint;
            }
            Text {
                text: root.title;
                color: Theme.text-title;
                font-weight: 700;
                font-size: Theme.fs-title;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Text {
                text: root.subtitle;
                color: Theme.text-sub;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        @children
    }
}

// ============================================================================
// 带焦点守卫的数字输入框
// ----------------------------------------------------------------------------
// ★为什么不能直接用 SpinBox + `value: <模型值>`★
// 那是声明式绑定: 模型值一变就把新值写进部件。而设备真值是**持续回读**的(全局项每次
// GLOBAL_GET 回来都会 bump 版本 → 回填 → 赋值), 于是用户刚敲进一个字符, 下一次回读就把它冲掉,
// 光标与编辑态一起丢 —— 用户看到的就是"输入一下就失焦"(实测反馈)。
// 本组件的规则:
//   · 外部值只在**本框没有焦点**时同步进来 —— 正在编辑就绝不打扰;
//   · 失焦那一刻按围栏夹取并回显, 同时抛 `committed` —— 这就是"失焦即按围栏截断并回显";
//   · 编辑过程中仍逐次抛 `edited`(维持既有"改了就入草稿"的行为, 不改变保存语义)。
// ★不用声明式 `value:` 绑定★: Slint 里对属性赋一次值就会永久摧毁其上的绑定, 两者混用只会得到
// "有时能推进来、有时推不进来"的薛定谷行为; 这里统一走 init + changed 显式赋值。
// ============================================================================
export component GuardedSpinBox inherits SpinBox {
    in property <int> model_value: 0;
    // 失焦时按围栏夹取后的最终值(已在 [minimum, maximum] 内)。
    callback committed(int);
    private property <int> _snap;
    private property <int> _committed_value;

    init => {
        self.value = root.model_value;
        self._committed_value = self.value;
    }
    // 外部真值变化: 只在用户没在编辑本框时才同步。
    changed model_value => {
        if (!self.has-focus) {
            self._apply(root.model_value);
            self._committed_value = self.value;
        }
    }
    // 失焦时才按围栏校验并提交；编辑中的字符只留在控件草稿中。
    // 标准 SpinBox 未向外暴露 Enter 回调；其内部 accepted 动作仍会处理文本，
    // 业务提交统一留给失焦，避免逐键回写模型。
    function _commit() {
        self._apply(self.value);
        if (self.value != self._committed_value) {
            self._committed_value = self.value;
            root.committed(self.value);
        }
    }
    changed has-focus => {
        if (!self.has-focus) { self._commit(); }
    }
    // 把目标值写进部件, 并尽力保证内部文本被刷新。
    // ★为什么要绕一个中间值★ SpinBoxBase 只在 `changed value` 时才回写它私有的 TextInput;
    // 而用户键入越界数字时 base 的 update-value 会**拒收** ⇒ value 根本没变 ⇒ 文本就一直停在
    // 那个非法数字上。先落到一个必然不同的值再落到目标值, 制造出一次 value 变化把文本拉回合法显示。
    function _apply(v: int) {
        self._snap = v < self.minimum ? self.minimum : (v > self.maximum ? self.maximum : v);
        if (self.minimum != self.maximum) {
            self.value = self._snap == self.minimum ? self.maximum : self.minimum;
        }
        self.value = self._snap;
    }
}

// 带回填守卫的单选框。
// ★同一处坑的下拉版本★ std-widgets 的 ComboBox 在用户选中时会给自己的 current-index **赋值**,
// 而 Slint 里一次赋值就永久摧毁该属性上的声明式绑定 ⇒ 用户手选过一次之后, Rust 侧的回填
// (设备真值 / 撤销草稿 / 断线清值)就再也推不进这个下拉了。故此处不写声明式绑定, 改为
// init + `changed model_index` 显式写回, 让"下拉 = 当前生效值"不依赖那条会被摧毁的绑定。
export component GuardedComboBox inherits ComboBox {
    in property <int> model_index: 0;

    init => { self.current-index = root.model_index; }
    changed model_index => { self.current-index = root.model_index; }
}

// 参数说明的"左侧悬浮问号"。
// ★为什么不用 PopupWindow★ 详解有六七行(协议名/ID/作用域/取值范围/越界处理/说明/影响), 而参数行
// 住在一个被 clip 的窄列 ScrollView 里, 弹窗在那里必然被裁掉一半。本组件只负责"鼠标进/出时把文本
// 抛给使用方", 由页面在自己的顶层画一个不受裁切的浮层 —— 位置与宽度归页面管, 组件不假设布局。
// ★文本内容一律来自 ParamRow.help(= Rust 侧 ParamFence::help_text)★, 这里不拼一个字。
export component HelpDot inherits Rectangle {
    in property <string> help;
    // 移入 → 完整详解; 移出 → 空串(页面据此收起浮层)。
    callback hovered(string);

    width: root.help == "" ? 0px : 14px;
    horizontal-stretch: 0;
    visible: root.help != "";

    // ★不给 root 固定 height, 圆点自己在行内垂直居中★
    // 原实现把 14px 高度写在 root 上, 于是在 HorizontalBox 里问号被按布局规则贴着行的上沿放,
    // 与同行 `vertical-alignment: center` 的标签文本错开半行(实测截图)。改成: root 由布局撑满行高,
    // 圆点按 (行高 - 自身高)/2 居中 —— 这样问号与标签文本永远水平对齐, 且不依赖具体行高取值。
    dot := Rectangle {
        width: 14px;
        height: 14px;
        y: (parent.height - self.height) / 2;
        border-radius: 7px;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.accent : Theme.border-light;
        background: ta.has-hover ? Theme.accent : transparent;

        Text {
            width: 100%;
            height: 100%;
            text: "?";
            font-size: 10px;
            color: ta.has-hover ? #0d1117 : Theme.text-sub;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ta := TouchArea {
            // ★必须写全限定 MouseCursor.help★: 本组件有一个同名的 `help` 属性, 裸写 `help` 会被解析成
            // 那个 string 属性 → "Cannot convert string to enum MouseCursor"。
            mouse-cursor: MouseCursor.help;
            changed has-hover => { root.hovered(self.has-hover ? root.help : ""); }
        }
    }
}

// 统一表单行: [?] + 固定宽标签列 + 控件槽 + 尾部弹性空白, 可选下方一行灰色说明。
// ★必须定义在 HelpDot 之后★(Slint 先声明后使用)。
// ----------------------------------------------------------------------------
// ★为什么所有带标签的控件行都必须走这一个组件★ 三个实测病灶都出在"每页各写一遍行结构":
//  ① 标签列宽有的写 width 有的写 min-width ⇒ 长标签把控件推走, 同页各行控件列起点对不齐;
//  ② 行尾没有弹性空白 ⇒ Slint 在"所有子项 stretch 都是 0"时把多余宽度**平分**给每个子项,
//     于是一行里的按钮会横跨半屏(如原「捕获当前值→手动」);
//  ③ 有的行给了 height 有的没给 ⇒ 容器被拉伸时控件跟着纵向摊开, 同页行高参差。
// 本组件把这三件事各定义一次: label_width 固定、行高固定、末尾常驻一个 stretch 空白。
// ★使用约定★ 放进控件槽的控件一律写 horizontal-stretch: 0 并给出确定宽度(取 Theme 的宽度分档),
// 剩余宽度全部归行尾空白。
export component FormRow inherits VerticalLayout {
    in property <string> label;
    // 非空 ⇒ 行首出现悬浮问号(内容与悬浮上抛沿用 HelpDot 的既有语义)。
    in property <string> help;
    // 非空 ⇒ 控件下方一行灰色说明, 缩进到控件列, 与标签明确分层。
    in property <string> hint;
    // 个别页面的标签更长(或更短), 允许按页覆盖; 同一页内必须取同一个值。
    in property <length> label_width: Theme.form-label-width;
    callback help_hovered(string);

    padding: 0px;
    spacing: 2px;
    vertical-stretch: 0;

    HorizontalLayout {
        // 固定行高 = 全页行高一致的唯一来源; 容器被拉伸时本行不参与摊开。
        height: Theme.row-height;
        spacing: Theme.gap;
        // ★用 if 条件实例化而不是 visible★: HelpDot 宽度归零后, 布局的 spacing 仍会留下 6px,
        // 于是"有问号"和"没问号"两种行的标签起点相差 6px。整块不实例化才真正对齐。
        if root.help != "": HelpDot {
            help: root.help;
            hovered(t) => { root.help_hovered(t); }
        }
        Text {
            text: root.label;
            width: root.label_width;
            horizontal-stretch: 0;
            color: Theme.text-sub;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
        // 行尾弹性空白: 吸收整行剩余宽度 —— 控件不被拉伸的根本保证(见组件头注释 ②)。
        Rectangle { horizontal-stretch: 1; }
    }
    if root.hint != "": HorizontalLayout {
        // 说明缩进到控件列: 它解释的是这一行的控件, 与标签同列会读成又一个标签。
        padding-left: root.label_width + Theme.gap;
        Text {
            text: root.hint;
            color: Theme.text-dim;
            font-size: Theme.fs-small;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// 单通道参数编辑行。分辨率等需全通道一致的参数由 Rust 侧统一处理, 不再提供逐行"应用全部"。
export component ParamEditorRow inherits HorizontalBox {
    in property <ParamRow> entry;
    // 未读取真值时不允许编辑；AUTO 时明确显示文本，避免自动计算值被误认为手动设置。
    in property <bool> mode_known: false;
    in property <bool> auto_mode: false;
    callback edited(int, int);
    // "?" 悬浮详解: 原样上抛给页面(见 HelpDot 的注释)。
    callback help_hovered(string);

    padding: 0px;
    spacing: Theme.gap;
    height: Theme.row-height;

    // 左侧问号: 悬浮即给出这一项的完整详解(单位/作用域/取值/越界处理/说明/影响)。
    HelpDot {
        help: root.entry.help;
        hovered(t) => { root.help_hovered(t); }
    }
    // 标签占剩余宽度并在过窄时省略, 保证 SpinBox 与按钮始终在 360px 参数区内不越界。
    // 单位就贴在标签后面(取自同一份元数据): 光看"手指阈值 800"看不出 800 是什么量纲。
    Text {
        text: root.entry.unit == "" ? root.entry.label
                                   : (root.entry.label + " / " + root.entry.unit);
        horizontal-stretch: 1;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
    }
    if root.auto_mode || !root.mode_known: Text {
        text: root.mode_known ? "AUTO" : @tr("读取中…");
        color: root.mode_known ? Theme.accent : Theme.muted;
        min-width: Theme.spin-width;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // 围栏随行下发(entry.min/entry.max), 唯一来源是 Rust 侧 `proto::telemetry::param_fence`
    // —— 与 RP2040 `sensor_link.cpp::_handle_param_set`、PSoC `main.c::_param_value_legal` 三处同源。
    // ★这里不许再按 param_id 写阈值★: 旧实现把 SNS_CLK_SOURCE 上界写死 6, 而设备合法持有 128
    // (0x80 = CapSense AUTO 标志), 于是 UI 把 128 夹成 6, 用户一碰就把 AUTO 标志抹掉下发。
    // 含标志位的参数其区间内存在非法点(如 0x0A 的 7..127), 那些值由 Rust 侧下发前明确拒绝并告知。
    // ★可选值少 / 带 AUTO 的参数一律单选★(见 types.slint::ParamRow.choices)
    // 单选让用户**填不出**非法值: 时钟源这类参数的 UI 区间里存在大段非法空洞, 数字框拦不住。
    // 两个控件都常驻, 用 visible + 宽度归零切换, 未启用的那个不占布局宽度。
    param_choice := GuardedComboBox {
        visible: root.entry.choices.length > 0 && root.mode_known && !root.auto_mode;
        width: (root.entry.choices.length > 0 && root.mode_known && !root.auto_mode)
            ? Theme.spin-width : 0px;
        horizontal-stretch: 0;
        model: root.entry.choices;
        model_index: root.entry.choice_index;
        selected(_) => {
            root.edited(root.entry.param_id, root.entry.choice_values[self.current-index]);
        }
    }
    // 设备真值不在合法取值内: 如实说明, 不许假装选中某一项(否则用户以为设备就是这个值)。
    if root.entry.choices.length > 0 && root.mode_known && !root.auto_mode
        && root.entry.choice_index < 0: Text {
        text: "值 " + root.entry.value + " 非法";
        color: Theme.warn;
        font-size: Theme.fs-small;
        vertical-alignment: center;
    }
    // ★用 GuardedSpinBox 而非裸 SpinBox★ 两个理由, 都是实测踩过的:
    // ① 回填必须能推进来: std-widgets 的 SpinBox 是 `value <=> base.value`, 而
    //    SpinBoxBase.update-value() 对 `root.value` 是**赋值**, Slint 里一次赋值就永久摧毁该属性上
    //    的声明式绑定 ⇒ 用户编辑过这一行之后 `value: root.entry.value` 便不存在, 此后 Rust 侧
    //    set_row_data 换 entry 也推不进来; Repeater 又复用行实例(换通道只换 entry 不重建元素),
    //    于是该行永远停在用户键入的数字 —— 表现为"改一个参数后所有通道都是同一个值"。
    // ② 回填不能打断编辑: 参数是持续回读的, 无条件重推会在用户敲第二个字符前就把文本冲掉
    //    (表现为"输入一下就失焦")。故只在本框无焦点时同步, 失焦时按 entry.min/max 夹取回显。
    param_value := GuardedSpinBox {
        visible: root.entry.choices.length == 0 && root.mode_known && !root.auto_mode;
        // ★必须同时收掉占位★: 只 visible:false 仍占布局宽度, 会把单选框挤出参数区。
        // ★条件必须与 visible 完全一致★(照 param_choice 的写法): 原先只判 choices.length==0,
        // 于是 AUTO / 未读取真值时这个隐藏的数字框仍占一个 spin-width, 加上右侧"AUTO"标签
        // 又占一个, 标签被挤到放不下 —— overflow: elide 把参数名整条省略成"…", 表现为
        // "AUTO 时通道参数全变成省略号"。
        width: (root.entry.choices.length == 0 && root.mode_known && !root.auto_mode)
            ? Theme.spin-width : 0px;
        horizontal-stretch: 0;
        minimum: root.entry.min;
        maximum: root.entry.max;
        model_value: root.entry.value;
        committed(v) => { root.edited(root.entry.param_id, v); }
    }
}


// 声明类型标签。文本只来自 C 源 META 的类型参数; 空串 = 该声明没带类型(旧式 ALGO_REPORT),
// 如实显示"未声明"而不是补一个看起来很确定的 u16。
// ★按族配色, 不按具体类型配色★: 要一眼分清的只有"布尔 / 有符号 / 无符号 / 未声明"四档,
// 逐类型一个色会让色表比类型表还难记。族判定用穷举等值比较, 不依赖字符串下标。
export component TypeTag inherits Rectangle {
    in property <string> value_type;
    property <string> _t: root.value_type.to-lowercase();
    property <color> _tint: root._t == "" ? Theme.text-dim
        : (root._t == "bool" ? #b98fd6
        : ((root._t == "i8" || root._t == "i16" || root._t == "i32") ? Theme.warn
        : Theme.accent));

    horizontal-stretch: 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: root._tint;
    background: #00000000;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root._t == "" ? "未声明" : root._t;
            color: root._tint;
            font-size: Theme.fs-small;
            vertical-alignment: center;
        }
    }
}

// 算法可调变量编辑行: 0..255(u8)，同时显示别名、类型标签与范围。
export component AlgoSettingEditorRow inherits HorizontalBox {
    in property <AlgoSettingRow> entry;
    callback edited(int, int);

    padding: 0px;
    spacing: Theme.gap;
    height: Theme.row-height;

    Text {
        text: (root.entry.alias != "" ? root.entry.alias : root.entry.name)
            + " (cfg[" + root.entry.idx + "])";
        horizontal-stretch: 1;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
        color: Theme.text-strong;
    }
    // ★可调变量的类型/范围一律有确定结论★: 设备 cfg[8] 就是 8 个 u8, 旧式 ALGO_SETTING 缺
    // META 时退回的 u8/0..255 是协议事实(不是猜的), 所以这里不需要"未声明"分支。
    TypeTag { value_type: root.entry.value_type; }
    Text {
        text: root.entry.range;
        width: 92px;
        color: Theme.text-sub;
        vertical-alignment: center;
        overflow: elide;
    }
    cfg_value := GuardedSpinBox {
        horizontal-stretch: 0;
        min-width: Theme.spin-width;
        minimum: 0;
        maximum: 255;
        model_value: root.entry.value;
        committed(v) => { root.edited(root.entry.idx, v); }
    }
}

// 主图里的一条折线。所有线共用同一套 viewbox 视图变换(缩放/平移永不错层), 数据坐标固定 1000x1000。
//
// ★为什么必须 fit: fill★: Path 的 `fit` 默认是 contain, 即"等比缩放 + 居中"(lyon FitStyle::Min)。
// 等比缩放下, 只有 viewbox 宽高比恰好等于元素宽高比时才铺满; 一旦横向缩放时间窗(viewbox 变窄而
// 高度不变), 宽高比立刻失配 → 内容按高度等比缩放后横向只占一小条, 左右对称留出空白带。
// 这是无法用"给 x 乘绘图区宽高比"绕过的: 那个修正只在横纵缩放倍数相同(全览)时成立: 缩放后必然破功。
// fill = FitStyle::Stretch(非等比拉伸), 任意宽高比的 viewbox 都被拉满元素矩形 → 缩放/平移到任何
// 极端位置都铺满可视区, 且 x 值域可固定为 [0,1000], 缩放不必回 Rust 重算 path。
export component PlotPath inherits Path {
    in property <float> vx;
    in property <float> vy;
    in property <float> vw: 1000;
    in property <float> vh: 1000;

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    fit: fill;
    viewbox-x: root.vx;
    viewbox-y: root.vy;
    viewbox-width: root.vw;
    viewbox-height: root.vh;
}

// 二值算法线的"归一化幅度 N"输入: 把 0/1 拉伸到 0..N, 否则它在共享右轴上就是贴底的一条直线。
// ★为什么用 init 而不是把 text 绑到 value★: 上报折线模型每帧(30Hz)都可能整行替换, 若 text 绑定
// 模型字段, 输入过程中会被回填反复重置(光标乱跳、输入被吞)。改成初始化取一次 + 回车提交。
export component BinAmpEditor inherits HorizontalLayout {
    in property <string> label: "×";
    in property <float> value: 1;
    callback changed(float);

    spacing: 3px;
    Text {
        text: root.label;
        color: Theme.accent;
        font-size: Theme.fs-small;
        vertical-alignment: center;
    }
    LineEdit {
        width: 62px;
        font-size: Theme.fs-normal;
        input-type: decimal;
        init => { self.text = Math.round(root.value * 1000) / 1000; }
        accepted(t) => { root.changed(t.to-float()); }
    }
}

// 右列"数据序列"里的一行: 同色线标 + 勾选 + (仅二值线才有的)归一化幅度 N。
// ★为什么抽成组件★: "原生数据读取"组与"算法上报变量"组的行结构完全一致, 两处各写一遍必然
// 越改越长歪; 抽出来后两组各自只是"往 VerticalLayout 里塞若干 SeriesRow", 项数变化由布局
// 自动增行, 无处需要写死行数或行高之和。
export component SeriesRow inherits HorizontalLayout {
    in property <string> label;
    // 线标颜色 = 主图里那条线的颜色: 看图时不必靠猜哪条线对应哪个变量。
    in property <color> tint;
    in property <bool> checked;
    // 只有取值恒为 0/1 的二值线需要归一化幅度; 非二值线给了也无意义, 纯占宽度。
    in property <bool> has_norm: false;
    in property <float> norm: 1;
    callback toggled(bool);
    callback norm_changed(float);

    spacing: 4px;
    Text {
        text: "—";
        color: root.tint;
        font-size: 15px;
        width: 14px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    CheckBox {
        text: root.label;
        checked: root.checked;
        horizontal-stretch: 1;
        toggled => { root.toggled(self.checked); }
    }
    if root.has_norm: BinAmpEditor {
        value: root.norm;
        changed(v) => { root.norm_changed(v); }
    }
}

// 曲线页"算法变量(右轴)"的一行: 勾选行 + 声明详情行(类型标签 · 声明范围 · 当前运行值)。
// ★为什么不把详情塞进 SeriesRow★: 上面那组是设备原生量, 它们没有 C 源声明也没有声明范围,
// 给 SeriesRow 加一堆恒为空的属性只会让两组行结构名义相同、实际各用一半。
// 详情行在无任何可显示内容时高度归零(沿用本文件其它收起手法), 不留空行。
export component AlgoSeriesRow inherits VerticalLayout {
    in property <AlgoReportLine> entry;
    callback toggled(bool);
    callback norm_changed(float);

    property <bool> _has_detail: root.entry.value_type != "" || root.entry.current_value != "";

    spacing: 0px;
    SeriesRow {
        label: "report[" + root.entry.idx + "] " + root.entry.name;
        tint: root.entry.line_color;
        checked: root.entry.visible;
        // 二值性来自声明(见 ui_plot.rs: 声明优先, 无声明才按数据反推), 所以倍率框不会闪跳。
        has_norm: root.entry.is_binary;
        norm: root.entry.norm_amp;
        toggled(on) => { root.toggled(on); }
        norm_changed(v) => { root.norm_changed(v); }
    }
    Rectangle {
        height: root._has_detail ? detail.preferred-height : 0px;
        clip: true;
        detail := HorizontalLayout {
            // 与上一行的线标列对齐: 详情属于该变量, 不该顶到最左边与勾选行抢起点。
            padding-left: 18px;
            spacing: 5px;
            width: parent.width;
            TypeTag { value_type: root.entry.value_type; }
            Text {
                text: root.entry.range != "" ? root.entry.range : "范围未声明";
                color: Theme.text-dim;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                // 运行值这一栏只在真有值时出现: 无值时写"当前 —"会让人以为设备回了 0。
                text: root.entry.current_value != "" ? "当前 " + root.entry.current_value : "暂无运行值";
                color: root.entry.current_value != "" ? Theme.text-strong : Theme.text-dim;
                font-size: Theme.fs-small;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// 组合键捕获输入框。HID Usage 直填仅转发原文，解析由 Rust 统一处理。
export component KeyCaptureBox inherits Rectangle {
    in property <string> display;
    callback captured(string, bool, bool, bool, bool);
    callback hid_submitted(string);
    callback capture_started();
    property <bool> _recording: false;
    property <bool> _acted: false;
    property <duration> _capture_idle_timeout: 500ms;
    forward-focus: fs;
    height: 28px;
    border-width: 1px;
    border-radius: Theme.radius-small;
    border-color: root._recording ? #4a90d9 : Theme.border-light;
    background: root._recording ? #16222e : #262b31;

    function _begin() {
        if (!root._recording) {
            root._recording = true;
            root.capture_started();
        }
    }

    idle_focus := FocusScope { }
    // 录制焦点只覆盖左侧区域，直填框获得焦点后不会被 key-pressed 捕获。
    fs := FocusScope {
        width: parent.width - 98px;
        height: parent.height;
        key-pressed(e) => {
            root._begin();
            root._acted = false;
            root._acted = true;
            root.captured(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta);
            return accept;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root._acted = false;
                root._begin();
            }
        }
    }
    key_idle := Timer {
        interval: root._capture_idle_timeout;
        running: root._recording && root._acted;
        triggered => {
            root._recording = false;
            root._acted = false;
            if (fs.has-focus) {
                idle_focus.focus();
            }
        }
    }
    Text {
        x: 8px;
        width: fs.width - 12px;
        vertical-alignment: center;
        overflow: elide;
        text: root.display;
        color: root._recording ? Theme.accent : #d0d6dd;
    }
    hid_input := LineEdit {
        x: parent.width - 94px;
        y: 3px;
        width: 56px;
        height: parent.height - 6px;
        placeholder-text: "HID";
        accepted(t) => { root.hid_submitted(t); }
    }
    Button {
        x: parent.width - 34px;
        y: 3px;
        width: 30px;
        height: parent.height - 6px;
        text: @tr("用");
        clicked => { root.hid_submitted(hid_input.text); }
    }
}

// 参数详解浮层。★必须由页面放在自己的顶层★(而不是塞在被 clip 的参数列里), 位置与宽度归页面管。
// text 为空 ⇒ 整块不可见且不占高度, 于是"没悬浮任何问号"时页面布局与从前完全一致。
export component HelpOverlay inherits Rectangle {
    in property <string> text;

    visible: root.text != "";
    height: root.text == "" ? 0px : body.preferred-height + 16px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.accent;
    background: #0f1b26;

    body := Text {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: #cfe6ff;
        font-size: Theme.fs-small;
        wrap: word-wrap;
    }
}
