// ============================================================================
// 全通道实时状态页
// ============================================================================

import { Button, CheckBox, VerticalBox, HorizontalBox, ScrollView, SpinBox, ComboBox } from "std-widgets.slint";
import { ChannelStatus, ParamRow, AlgoSettingRow } from "../common/types.slint";
import { Theme } from "../common/theme.slint";
import { GuardedSpinBox, GuardedComboBox, GuardedCheckBox, HelpDot, HelpOverlay, CollapsibleSection, AlgoSettingEditorRow } from "../common/widgets.slint";

// 批量应用抽屉的宽度。★只定义一次★: 抽屉自身宽度与"算通道网格列数时要扣掉的宽度"必须是同一个
// 常量, 两处各写一个数就会出现"展开后右边一列被抽屉盖住"。
// 取值依据: 抽屉里最宽的一行 = 勾选框 + 参数名 + 控件(下拉取 Theme.combo-width) + 卡片内边距。
global BatchDrawer {
    out property <length> width: Theme.combo-width + 172px;
}

component ChannelStatusCell inherits Rectangle {
    in property <ChannelStatus> entry;
    in property <bool> selected: false;
    // 抽屉展开时本卡片变为"可勾选": 单击切换勾选而不是切换精调目标, 双击行为不变。
    in property <bool> pick_mode: false;
    in property <bool> picked: false;

    // 抽屉展开时本卡片是否为"源通道"(参数复制的来源), 与勾选态、精调选中态三者视觉分开。
    in property <bool> is_source: false;

    callback activated(int);   // 双击 → 进入单通道精调
    callback selected_click(int); // 单击 → 仅高亮选中
    callback picked_click(int);   // 勾选模式下的单击 → 切换勾选
    callback source_click(int);   // 勾选模式下 Shift+单击 → 设为源通道

    width: 124px;
    height: 90px;
    // 禁用通道: 整卡压暗到近乎背景色并降低不透明度。★即使用户选了"显示不启用的通道"也照样灰显★
    // "显示"只决定它是否出现在网格里, 不改变"它此刻不工作"这个事实 —— 让它和正常通道长得一样才是骗人。
    opacity: root.entry.enabled ? 1.0 : 0.45;
    border-width: (root.selected || root.picked || root.is_source) ? 2px : 1px;
    // 源通道优先着色(它是本次批量应用的数据来源, 必须一眼能找到), 其次勾选态, 再次精调选中态。
    border-color: !root.entry.enabled ? #3a4048
        : (root.is_source ? #7cf5a0
        : (root.picked ? #ffd166 : (root.selected ? #4fc3f7 : touch.has-hover ? #6b8191 : Theme.border-light)));
    background: !root.entry.enabled ? #171a1d
        : (root.is_source ? #1f3a29
        : (root.picked ? #3a3320
            : (root.selected ? #203b4a : touch.has-hover ? #242c33 : root.entry.active ? #245f35 : #1a1e22)));
    border-radius: 5px;

    // 源通道角标: 与勾选角标分列左右, 避免两种状态叠在同一位置分不清。
    Text {
        visible: root.is_source;
        x: 4px;
        y: root.height - 16px;
        text: @tr("源");
        font-size: 10px;
        font-weight: 700;
        color: #7cf5a0;
    }

    // 勾选角标: 只在勾选模式下出现, 避免平时多一块视觉噪声。
    Rectangle {
        visible: root.pick_mode;
        x: root.width - 18px;
        y: 4px;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        border-width: 1px;
        border-color: root.picked ? #ffd166 : #6b8191;
        background: root.picked ? #ffd166 : transparent;
        Text {
            text: root.picked ? "✓" : "";
            font-size: 10px;
            color: #2a2418;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalBox {
        padding: 5px;
        spacing: 1px;
        HorizontalBox {
            padding: 0px;
            spacing: 4px;
            Text {
                text: root.entry.label;
                font-weight: 700;
                color: Theme.text-title;
                min-width: 38px;
            }
            Text {
                // 禁用优先: 它压根不在扫描, "空闲/触摸/停滞"三个字都不适用。
                // 其次停滞提示: raw 长时间完全不变疑似异常, 明确标红, 不再让人猜是否真值。
                text: root.entry.telemetry_state == 2 ? @tr("离线/未知")
                    : (root.entry.telemetry_state == 1 ? @tr("遥测过期")
                    : (!root.entry.enabled ? @tr("已禁用")
                    : (root.entry.frozen ? @tr("⚠停滞") : (root.entry.active ? @tr("触摸") : @tr("空闲")))));
                font-size: Theme.fs-small;
                color: root.entry.telemetry_state == 2 ? #ff6b64
                    : (root.entry.telemetry_state == 1 ? #ffb454
                    : (!root.entry.enabled ? #8a939c
                    : (root.entry.frozen ? #ff8c42 : (root.entry.active ? #d0ffd0 : #85929d))));
            }
        }
        Text {
            // 禁用通道的 raw/diff 恒为 0(设备侧不再扫描它) —— 摆两个 0 会被读成"真的测到 0",
            // 直接写明"电极高阻"才是它的实际状态。
            text: root.entry.telemetry_state == 2 ? @tr("设备连接离线，读数未知")
                : (root.entry.telemetry_state == 1 ? @tr("最后遥测已过期")
                : (!root.entry.enabled ? @tr("电极高阻 · 不参与扫描")
                : ("raw " + root.entry.raw + "  diff " + root.entry.diff)));
            font-size: Theme.fs-normal;
            color: root.entry.telemetry_state == 2 ? #ff6b64
                : (root.entry.telemetry_state == 1 ? #ffb454
                : (!root.entry.enabled ? #77828c : (root.entry.frozen ? #ff8c42 : #c4ccd3)));
        }
        Text {
            text: @tr("逻辑区: ") + root.entry.binding_text;
            font-size: Theme.fs-small;
            color: root.entry.binding_text == "未绑定" ? #77828c : Theme.accent;
        }
        Text {
            text: root.entry.cp_text;
            font-size: Theme.fs-small;
            color: Theme.accent;
        }
    }

    // Shift 状态只能在 pointer-event 里读到(TouchArea 的 clicked 不带修饰键), 故在按下沿记住它,
    // 供随后的 clicked 判断。工程内已有同类做法: curves.slint 用 scroll-event 的 e.modifiers.shift。
    property <bool> _shift_down: false;

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root._shift_down = e.modifiers.shift;
            }
        }
        clicked => {
            if (root.pick_mode && root._shift_down) {
                // Shift+单击 = 指定"源通道"(参数从哪个通道复制)。
                root.source_click(root.entry.index);
            } else if (root.pick_mode) {
                root.picked_click(root.entry.index);
            } else {
                root.selected_click(root.entry.index);
            }
        }
        // ★勾选模式下屏蔽双击进精调★: 勾选目标通道时双击极易误触, 一跳页就丢掉刚勾的一批。
        double-clicked => {
            if (!root.pick_mode) {
                root.activated(root.entry.index);
            }
        }
    }
}

// 批量应用抽屉里的一行: 勾选 + 参数名 + ★可手改的目标值★。每个参数各自独立勾选, 只有勾上的
// 才会被写到目标通道。
//
// ★值为什么要能改★: 原实现这一列是只读文本, 只能把源通道的值整份复制过去; 想给一批通道写一个
// 源通道上并不存在的新数字, 就得先跑去源通道改一次再回来复制, 绕一大圈还会把源通道也改掉。
// ★上下限由 Rust 侧随行下发(minimum/maximum)★: 唯一来源是 proto::telemetry::param_fence,
// 与 RP2040/PSoC 两处固件同源。这里绝不许按 param_id 写死阈值 —— 那会变成第四份围栏, 与固件
// 必然漂移(widgets.slint 里刚清掉过一份写死 SNS_CLK_SOURCE 上界 6 的实现)。
component BatchParamRow inherits Rectangle {
    // ★与单通道精调共用同一份 ParamRow★(含围栏与单选项)。原先是 names/values/min/max 四条平行数组,
    // 于是"时钟源该用单选"这件事只在精调页做了、这里漏掉, 界面上同一个参数两种表达、还能填出 12
    // 这种非法值(实测截图)。共用一个结构就不可能再漏。
    in property <ParamRow> entry;
    in property <bool> checked: false;
    callback toggled();
    callback value_set(int);
    // "?" 悬浮详解: 与单通道精调同一份 ParamRow.help, 原样上抛给页面画浮层。
    callback help_hovered(string);
    // -1 = 面板上尚无值(源通道未回读到该参数且用户也没手填) → 显示"—", 不摆一个假的 0。
    property <bool> has_value: root.entry.value >= 0;
    property <bool> use_choice: root.entry.choices.length > 0;

    height: Theme.row-height;
    HorizontalLayout {
        spacing: 6px;
        // ★必须用 GuardedCheckBox★ 同 config.slint: Repeater 复用行实例, 裸 CheckBox 点一次就
        // 失去回填, 勾选状态会跟着行号而不是跟着通道数据。
        GuardedCheckBox {
            width: 22px;
            model_checked: root.checked;
            toggled => { root.toggled(); }
        }
        HelpDot {
            help: root.entry.help;
            hovered(t) => { root.help_hovered(t); }
        }
        Text {
            text: root.entry.unit == "" ? root.entry.label
                                       : (root.entry.label + " / " + root.entry.unit);
            font-size: Theme.fs-small;
            color: Theme.text-sub;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // 无值时用"—"占位、编辑控件隐身(与 widgets.slint::ParamEditorRow 的 AUTO 占位同一手法):
        // 数字框装不下 -1 这个哨兵, 而摆一个 0 会被误读成"该参数真的是 0"。
        if !root.has_value: Text {
            min-width: Theme.spin-width;
            horizontal-stretch: 0;
            text: "—";
            font-size: Theme.fs-small;
            color: Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // 单选与数字框都常驻, 用 visible + 宽度归零切换, 未启用的那个不占宽度。
        // 回填/失焦夹取由 Guarded* 自己管(见 widgets.slint), 故这里不再手动重推 ——
        // 手动重推是无条件的, 会把用户正在键入的内容冲掉。
        batch_choice := GuardedComboBox {
            visible: root.has_value && root.use_choice;
            // 下拉不能用数字框的宽度档: 选项是"IDAC sourcing / 自动(启动电平=抬起)"这类短语,
            // 按 spin-width(132px) 给会被箭头区吃掉后半截(实测"IDAC sour…")。
            width: (root.has_value && root.use_choice) ? Theme.combo-width : 0px;
            horizontal-stretch: 0;
            model: root.entry.choices;
            model_index: root.entry.choice_index;
            selected(_) => {
                root.value_set(root.entry.choice_values[self.current-index]);
            }
        }
        batch_value := GuardedSpinBox {
            visible: root.has_value && !root.use_choice;
            width: (root.has_value && !root.use_choice) ? Theme.spin-width : 0px;
            horizontal-stretch: 0;
            minimum: root.entry.min;
            maximum: root.entry.max;
            model_value: root.entry.value >= root.entry.min ? root.entry.value : root.entry.min;
            committed(v) => { root.value_set(v); }
        }
    }
}

export component AllChannelsPage inherits Rectangle {
    in property <[ChannelStatus]> channels: [];
    in-out property <int> selected_channel: 0;
    // ---- 批量应用抽屉 ----
    // 勾选状态的真相源在 Rust(AppController::batch_*), 这里只展示与转发事件, 避免两份状态对不上。
    in property <[bool]> batch_ch_selected: [];
    in property <[bool]> batch_param_selected: [];
    // 每参数一行(名称/待写值/围栏/单选项)。★与单通道精调共用 ParamRow★ ——
    // 原先拆成 names/values/min/max 四条平行数组, 结果"该用单选"的改动只在精调页落地、这里漏掉。
    // value = -1 表示面板上尚无值; 围栏与单选项唯一来源是 Rust 侧 proto::param_fence。
    in property <[ParamRow]> batch_param_rows: [];
    in-out property <bool> batch_drawer_open: false;
    callback batch_toggle_channel(int);
    // 传 param_id。清单由 Rust 的 `proto::BATCH_PARAM_IDS` 决定(不含分辨率 0x07: 全局项)。
    callback batch_toggle_param(int);
    callback batch_param_value_set(int, int);
    callback batch_channels_all();
    callback batch_channels_invert();
    callback batch_params_all();
    callback batch_params_invert();
    callback batch_clear();
    callback batch_apply(int);          // 源通道号
    callback batch_set_source(int);
    // 源通道: 真相源在 Rust(抽屉里显示的"源值"一列也得按它取), 这里只读回填。
    in property <int> batch_source: 0;
    // 由 main.rs 每 tick 从 AppController::telem_samples_per_sec()/telem_scan_period_us() 回填
    in property <int> sample_rate_hz: 0;
    in property <string> curve_threshold_warning: "";
    // 设备实测探测周期(ms, 两位小数), 由 telem_scan_period_us / 1000.0 换算回填。
    in property <float> scan_period_ms: 0;
    // 探测周期是否有实测值; 停流时来源恒为 0, 无值显示"未测"而不是 0 ms。
    in property <bool> scan_period_valid: false;

    // ★这一页控制的是"数据源"而不是"画面"★
    // 原先这两个按钮接的是曲线页那对 telem_start/telem_stop —— 而那对的语义早已改成"解冻/冻结绘图
    // 视窗"(遥测一直在收)。于是这一页写着"开始实时 / 停止", 点下去却只是把曲线页的视窗冻住,
    // 本页读数照旧在跳: 按钮名与实际行为完全不符。现在本页用独立的采集开关。
    callback telem_source_start();
    callback telem_source_stop();
    // 采集是否已被用户显式停止(真停流, 非画面冻结), 由 Rust 侧 telem_user_paused 回填。
    in property <bool> telem_paused: false;
    callback channel_selected(int);

    // ---- 排序 / 筛选 ----
    // ★排序与筛选都在 Rust 侧执行★: channels 这个模型送过来时就已经排好序、筛过了。
    // 逻辑顺序的唯一真相源是现有绑定映射(AppController::binding_channel_of); 在 Slint 里再复制
    // 一份"分区→通道"的映射必然与绑定页漂移, 所以这里只上抛用户的选择, 不自己算次序。
    // 0 = 逻辑通道顺序(按绑定的 A1..E8 排, 未绑定的稳定排在末尾并按物理号升序)
    // 1 = 物理通道顺序(PSoC channel index 0..35)
    in-out property <int> channel_sort: 0;
    // 是否把"未启用"的通道也显示出来(它们仍然灰显)。默认不显示, 让网格只剩真正在工作的通道。
    in-out property <bool> channel_show_disabled: false;
    // 当前被筛掉的通道数(由 Rust 回填), 用于在勾选框旁如实说明"少了几个", 不让人对着缺口猜。
    in property <int> channel_hidden_count: 0;

    // ---- 批量启用 / 禁用(复用同一 PARAM_ENABLED, 不新增协议) ----
    callback batch_enable_channels();
    callback batch_disable_channels();
    // 抽屉从展开 → 收起时通知 Rust 清理本次批量会话(勾选/待写值/源通道)。
    callback batch_drawer_closed();

    // ---- 算法可调变量(cfg): 全通道共享的一份值, 与批量勾选无关 ----
    // 与单通道精调页同一个模型、同一个回调, 不新增第二条通路(否则两页的值会漂移)。
    in property <[AlgoSettingRow]> algo_setting_rows: [];
    callback algo_setting_edited(int, int);

    // 抽屉内四个折叠分区的展开态。★必须由外部(AppWindow)持有★: 抽屉本身是 `if` 条件实例化的,
    // 状态放在页面里会随抽屉收起被销毁, 下次展开全部回到默认值。
    in-out property <bool> batch_targets_expanded: true;
    in-out property <bool> batch_enable_expanded: false;
    in-out property <bool> batch_params_expanded: true;
    in-out property <bool> batch_algo_cfg_expanded: false;

    // 批量抽屉里 "?" 悬浮详解的当前文本(空 = 没悬浮在任何问号上)。
    property <string> help_text: "";

    VerticalBox {
        padding: 8px;
        spacing: 8px;

        HorizontalBox {
            padding: 0px;
            spacing: Theme.gap;
            Button {
                min-width: Theme.button-min-width;
                horizontal-stretch: 0;
                // 真开采集(重新下发 TELEM_START), 不是"解冻画面"。
                text: @tr("开始采集");
                enabled: root.telem_paused;
                clicked => { root.telem_source_start(); }
            }
            Button {
                min-width: Theme.button-min-width;
                horizontal-stretch: 0;
                // 真停采集: 设备停止推流, 读数/采样率/延迟一并停在最后一帧(如实反映"没数据了")。
                // 想只把波形停住看一眼请用曲线页的「暂停画面」。
                text: @tr("停止采集");
                enabled: !root.telem_paused;
                clicked => { root.telem_source_stop(); }
            }
            Text {
                text: root.telem_paused ? @tr("■ 采集已停止(读数为最后一帧, 点「开始采集」恢复)")
                                        : @tr("双击卡片进入精调；单击选中。");
                vertical-alignment: center;
                color: root.telem_paused ? #ff8c42 : #89949e;
                overflow: elide;
            }
            Text {
                text: @tr("排序");
                vertical-alignment: center;
                color: Theme.text-sub;
            }
            ComboBox {
                // 150px 低于 fluent ComboBox 的 160px 下限 ⇒ "逻辑通道顺序"被箭头区压掉尾字。
                width: Theme.combo-width;
                horizontal-stretch: 0;
                model: [@tr("逻辑通道顺序"), @tr("物理通道顺序")];
                current-index: root.channel_sort;
                selected => { root.channel_sort = self.current-index; }
            }
            CheckBox {
                text: root.channel_hidden_count > 0
                    ? (@tr("显示不启用的通道 (") + root.channel_hidden_count + @tr(" 个已隐藏)"))
                    : @tr("显示不启用的通道");
                checked: root.channel_show_disabled;
                toggled => { root.channel_show_disabled = self.checked; }
            }
            Button {
                // 最小交付窗口下工具栏还要容纳采集、排序、筛选和采样摘要；固定短按钮宽度，
                // 不让批量入口被 HorizontalBox 推到客户区外。详细语义由抽屉内标题和操作说明提供。
                width: 92px;
                text: root.batch_drawer_open ? @tr("收起批量") : @tr("批量应用");
                clicked => {
                    // 收起前先清理本次批量会话: 勾选态活在 Rust 里, 只把抽屉藏起来的话下次展开会
                    // 带着上一批勾选出现, 而"应用到已选通道"会照着它执行(写进用户以为没选的通道)。
                    if (root.batch_drawer_open) { root.batch_drawer_closed(); }
                    root.batch_drawer_open = !root.batch_drawer_open;
                }
            }
            Text {
                // ★固定 min-width (与主页采样/延迟块同口径): 采样率与探测周期每帧刷新, 位数变化会改变
                // 文本首选宽度, 进而驱动 HorizontalBox 重新分配, 左侧说明文字被来回推动。钉死宽度后不抖。
                // 固定 width(不是 min-width): 采样率/探测周期每帧刷新, min-width 挡不住"文本比下限更长"
                // 时首选宽度随位数变化, 那会持续驱动 HorizontalBox 重分配, 左侧说明文字来回被推。
                width: 220px;
                overflow: elide;
                horizontal-alignment: right;
                text: @tr("采样率") + root.sample_rate_hz + " Hz  " + @tr("探测周期 ") + (root.scan_period_valid
                    ? (Math.round(root.scan_period_ms * 100) / 100 + " ms")
                    : @tr("未测"));
                vertical-alignment: center;
                color: Theme.accent;
            }
        }

        // 网格定位用循环索引自身(Math.mod/Math.floor)，不依赖 Rust 字段。
        // 杜绝旧实现的"仅渲染 6 格斜向级联"故障。124px 宽 + 6px 间距 = 130px 列距。
        // ★列数随可用宽度自适应★: 固定 6 列在窄窗口要 792px, 在 2560 宽窗口又只占左侧三分之一。
        // ★viewport 必须显式指定★: Flickable 只会把【布局类】子元素的 min 折进 viewport, 这里的
        // 子元素是绝对定位的裸 Rectangle, 于是 viewport 恒等于视口 → 原实现在窄窗口下是"直接裁掉
        // 右边几列且滚不动"。按实际网格尺寸给出 viewport 后, 不够放时才真的能滚。
        // 网格与抽屉并排。抽屉宽度是**常量**, 左侧可用宽度 = 本页宽度 - 抽屉宽度, 因此列数只依赖
        // 一个与滚动条无关的量(见下方 cols 注释), 抽屉开合只是让这个常量在 0/300px 之间切换。
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

        grid_view := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            // ★★列数只能由外层容器宽度推导, 绝不能用 self.visible-width★★
            // 曾经写成 `cols: Math.floor(self.visible-width / 130px)` + `viewport-width: ... cols`,
            // 这是一个完整闭环: visible-width 取决于纵向滚动条是否出现 → 取决于 viewport-height →
            // 取决于 rows → 取决于 cols → 取决于 visible-width。布局求值无限递归, 一进设置页就
            // "thread 'main' has overflowed its stack"(TabWidget 会实例化所有子页, 一页有环全崩)。
            // root.width 是本页整体宽度(由 TabWidget 的 content-width 决定), 与本 ScrollView 内部的
            // 滚动条反馈无关, 因此用它算列数是安全的(减去 VerticalBox 的左右 padding 与滚动条宽度)。
            // 抽屉占据的宽度必须从列数计算里扣掉, 否则展开后右侧几列会被抽屉盖住。
            // drawer_w 是常量(不是抽屉的实际渲染宽度), 所以不会把抽屉尺寸反馈回列数。
            property <length> drawer_w: root.batch_drawer_open ? BatchDrawer.width : 0px;
            property <float> cols: Math.max(1, Math.floor((root.width - 30px - self.drawer_w) / 130px));
            property <float> rows: Math.ceil(root.channels.length / self.cols);
            viewport-width: self.cols * 130px;
            viewport-height: self.rows * 100px;
            Rectangle {
                for cell[idx] in root.channels: ChannelStatusCell {
                    entry: cell;
                    selected: cell.index == root.selected_channel;
                    pick_mode: root.batch_drawer_open;
                    picked: cell.index < root.batch_ch_selected.length
                        ? root.batch_ch_selected[cell.index] : false;
                    is_source: root.batch_drawer_open && cell.index == root.batch_source;
                    x: Math.mod(idx, grid_view.cols) * 130px;
                    y: Math.floor(idx / grid_view.cols) * 100px;
                    selected_click(ch) => { root.selected_channel = ch; }
                    picked_click(ch) => { root.batch_toggle_channel(ch); }
                    source_click(ch) => { root.batch_set_source(ch); }
                    activated(ch) => { root.channel_selected(ch); }
                }
            }
        }

        // 批量应用抽屉: 固定宽 = BatchDrawer.width(与上面算列数用的 drawer_w 同一个常量)。
        // ★必须用 `if` 条件实例化, 不能用 visible★: Slint 的 visible=false 只是不绘制, 元素照样
        // 参与布局求值 —— 收起时即使把 width 置 0, 内部 VerticalBox 累加出来的 min-height 仍会
        // 一路上传到 TabWidget(它会实例化全部 9 个子页), 把整个设置页撑高, 表现为"底部保存栏被顶出
        // 窗口"以及"分区绑定页的 letterbox 按被撑大的 parent.height 算尺寸导致底部被裁"。
        // `if` 收起时根本不实例化, 对外部布局零影响。
        // ★内容必须再套一层 ScrollView★: 抽屉内容的 min-height 有三四百 px, 直接摆进去会在窄/矮
        // 窗口下继续撑高父布局; ScrollView 的 min 是常量, 内容超出即自身滚动, 不向上传播。
        // 本 Rectangle 有固定 width, 内部子元素才可以绑 parent.width —— 反过来(尺寸由内容反推)
        // 就会形成本工程修过多次的布局环。
        if root.batch_drawer_open : Rectangle {
            width: BatchDrawer.width;
            border-radius: Theme.radius;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border-light;
            clip: true;

            ScrollView {
            VerticalBox {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: @tr("单通道参数批量应用");
                    font-weight: 700;
                    color: Theme.text-title;
                }

                // ★抽屉改用与单通道精调右栏同一套折叠分区★ 原先四组内容(源/目标通道、启用禁用、
                // 参数表、说明文字)平铺在一列里, 300px 宽下一屏放不下, 每次都要滚很久才能摸到
                // "应用"按钮; 而说明文字与详解浮层还会随内容变化改变列高。改成折叠区后:
                //   · 每组能各自收起, 只留标题行 + 一行摘要, 常用的那组保持展开;
                //   · 折叠态是确定高度(见 CollapsibleSection 说明), 不再因说明文字长短抖动。
                // ★分区体内一律不放 wrap: word-wrap 的 Text★ 那会让区块 preferred-height 偏小
                // (CollapsibleSection 注释里记的老病灶), 表现为展开后内容被裁。说明一律进摘要或
                // 进页面底部的详解浮层。
                CollapsibleSection {
                    title: @tr("目标通道");
                    summary: @tr("源 CH") + root.batch_source;
                    expanded <=> root.batch_targets_expanded;

                    Text {
                        text: @tr("源通道 CH") + root.batch_source + @tr(" · Shift+单击网格更换");
                        font-size: Theme.fs-small;
                        color: #7cf5a0;
                        overflow: elide;
                    }
                    // 抽屉里的按钮行都加行尾弹性空白: Slint 在"全部子项 stretch=0"时平分余量,
                    // 没有这块空白时两三个按钮会各被摊成整列宽的巨块。
                    HorizontalBox {
                        padding: 0px;
                        spacing: Theme.gap;
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("全选");
                            clicked => { root.batch_channels_all(); }
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("反选");
                            clicked => { root.batch_channels_invert(); }
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("清空");
                            clicked => { root.batch_clear(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // ★与"批量应用参数"分开成一组★: 参数是调参(要选参数、要填值), 而启用是硬件开关
                // (只有开/关两种结果)。混进参数表会让"启用"看着像又一个可复制的数值项。
                CollapsibleSection {
                    title: @tr("批量启用 / 禁用");
                    summary: @tr("硬件开关");
                    expanded <=> root.batch_enable_expanded;

                    HorizontalBox {
                        padding: 0px;
                        spacing: Theme.gap;
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("启用已选");
                            clicked => { root.batch_enable_channels(); }
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("禁用已选");
                            clicked => { root.batch_disable_channels(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                CollapsibleSection {
                    title: @tr("通道参数");
                    summary: root.batch_param_rows.length + @tr(" 项 · 勾选才写入");
                    expanded <=> root.batch_params_expanded;

                    HorizontalBox {
                        padding: 0px;
                        spacing: Theme.gap;
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("全选");
                            clicked => { root.batch_params_all(); }
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("反选");
                            clicked => { root.batch_params_invert(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // 参数行按自然高度排布, 整列的滚动由抽屉外层那个 ScrollView 承担。
                    // 这里不再套第二层 ScrollView: 嵌套 Flickable 会抢滚动事件, 且内层 min 仍要占位。
                    VerticalLayout {
                        padding: 0px;
                        spacing: 1px;
                        for row[i] in root.batch_param_rows: BatchParamRow {
                            entry: row;
                            checked: i < root.batch_param_selected.length
                                ? root.batch_param_selected[i] : false;
                            // ★param_id 只能取自行自身★: 行清单由 Rust 的 `BATCH_PARAM_IDS` 给出
                            // (分辨率是全局项, 已被剔除), 用 "下标+1" 反推会整列错位一格。
                            toggled => { root.batch_toggle_param(row.param_id); }
                            value_set(v) => { root.batch_param_value_set(row.param_id, v); }
                            help_hovered(t) => { root.help_text = t; }
                        }
                    }
                }

                // ---- 算法可调变量(cfg) ----
                // ★与上面的通道参数是两种东西, 必须分区并标出作用域★ cfg[8] 在设备上只有一份
                // (PSoC g_algo_cfg[8] / RP PsocAlgo::_cfg[8] 都不带通道下标), 改一次即对全部 36 个
                // 通道生效, 与"勾了哪些目标通道"无关, 也不参与下面那个"应用到已选通道"。
                // 放进本抽屉的理由: 用户在全通道页对着一片读数调参时, 算法量与硬件量本来就要一起看;
                // 作用域差异由每行的 ScopeTag(全通道共享)与本区摘要如实标注, 不靠用户记。
                CollapsibleSection {
                    title: @tr("算法可调变量(cfg)");
                    summary: root.algo_setting_rows.length > 0
                        ? root.algo_setting_rows.length + @tr(" 项 · 全通道共享 · 改即下发")
                        : @tr("无声明");
                    expanded <=> root.batch_algo_cfg_expanded;

                    Text {
                        text: root.algo_setting_rows.length > 0
                            ? @tr("一份值对全部通道生效, 不随目标通道勾选")
                            : @tr("当前算法未声明 ALGO_SETTING");
                        font-size: Theme.fs-small;
                        color: Theme.text-sub;
                        overflow: elide;
                    }
                    VerticalLayout {
                        padding: 0px;
                        spacing: 2px;
                        for row in root.algo_setting_rows: AlgoSettingEditorRow {
                            entry: row;
                            // 抽屉只有 300px 宽: 收起"范围"列, 免得整列长出横向滚动条。
                            compact: true;
                            edited(idx, v) => { root.algo_setting_edited(idx, v); }
                        }
                    }
                }

                Button {
                    text: @tr("应用到已选通道");
                    primary: true;
                    clicked => { root.batch_apply(root.batch_source); }
                }
            }
            }
        }
        }
    }

    // 参数 "?" 的详解浮层。★与单通道精调页同一手法: 贴在页面底部、绝对定位、不进任何布局★
    // 原先它长在抽屉那一列的参数行下方, 于是鼠标每划过一个问号, 详解文本的高度变化就会改变抽屉
    // VerticalBox 的累加高度 → 列内所有控件上下跳动(用户反馈的"震荡"), 严重时正在瞄的那个数字框
    // 会从指针下跑掉。作为根 Rectangle 的兄弟节点后, 它只是盖在页面上的一层, 对布局零影响;
    // 没悬浮任何问号时 text 为空 ⇒ 组件自身高度 0 且不可见, 观感与从前一致。
    HelpOverlay {
        x: 8px;
        y: parent.height - self.height - 8px;
        width: parent.width - 16px;
        text: root.help_text;
    }
}
