import { Button, ComboBox, HorizontalBox, CheckBox, SpinBox, ScrollView } from "std-widgets.slint";
import { ConfigRow, ConfigGroupCount, LedUnitRow } from "../common/types.slint";
import { CollapsibleSection, GuardedSpinBox, GuardedComboBox } from "../common/widgets.slint";
import { ConfigGroupSection } from "./config.slint";
import { Theme } from "../common/theme.slint";

// 灯板映射表里"非控件列"的列宽。★只在这里各定义一次★: 表头与数据行两处都引用它,
// 控件列的宽度则直接取 Theme 的宽度分档 —— 两套宽度各有唯一来源, 改一处不会错列。
global LedCols {
    out property <length> unit: 108px;     // 单元名(A1/B2…, 最长四字)
    out property <length> swatch: 34px;    // 采样色块
    out property <length> rgb: 132px;      // "R255 G255 B255" 文本
}


// ============================================================================
// 协议页: mai2serial(游戏触控上报) + mai2light(灯板协议) 两块面板并列
// ============================================================================

export component ProtocolPage inherits Rectangle {
    // ---- 协议能力参数(与"通信系统"Tab 同一份 config_rows / 同一套草稿写入回调) ----
    // 行的归属由 Rust 侧 group 字段决定, 本页只挂两个协议组; 同一 KV 不会在两处出现。
    in property <[ConfigRow]> config_rows: [];
    // 各分组行数: 组为空时就地自报原因(未取到配置 / 归组异常), 不留一片空白让人猜。
    in property <[ConfigGroupCount]> config_group_counts: [];
    callback cfg_set_bool(string, bool);
    callback cfg_set_number(string, float);
    callback cfg_set_number_hex(string, string);
    callback cfg_set_enum(string, int);
    callback cfg_set_string(string, string);

    // ---- mai2serial(自分区绑定页迁移而来, 属性/回调名沿用) ----
    in property <bool> mai2_send_en_known: false;
    in property <bool> mai2_send_en: false;
    in property <string> mai2_status: "未知";
    in property <string> mai2_baud: "未知";
    in-out property <bool> mai2_panel_expanded: false;
    callback mai2_set_send_en(bool);
    callback mai2_refresh();

    // ---- mai2light ----
    in property <bool> light_known: false;
    // WS2812 两链初始化就绪 + 故障说明(空串=无故障/尚未回读)。故障是硬件级问题, 必须显性报红。
    in property <bool> light_chain0_ready: false;
    in property <bool> light_chain1_ready: false;
    in property <string> light_init_fault: "";
    in property <string> light_status: "未知";
    in property <string> light_resp_en: "未知";
    in property <string> light_baud: "未知";
    in property <string> light_rx_frames: "未知";
    in property <string> light_sum_errors: "未知";
    in property <[LedUnitRow]> light_units: [];
    // 本地校验结论与设备回执分开显示: 前者是"发之前就知道会失败", 后者是设备真实反馈。
    in property <string> light_conflict: "";
    in property <string> light_apply_status: "";
    in property <int> light_ws_count0: 0;
    in property <int> light_ws_count1: 0;
    in property <int> light_brightness: 0;
    in-out property <bool> light_panel_expanded: false;
    callback light_refresh();
    callback light_map_set(int, int, int, int);
    callback light_map_apply();
    callback light_preview(int, int, int, int);
    callback light_ws_count_set(int, int);
    callback light_brightness_set(int);

    // 预览色暂存在本组件, 属于纯交互态, 不必上升到 AppWindow。
    property <int> pv_r: 255;
    property <int> pv_g: 255;
    property <int> pv_b: 255;
    // 预览作用对象: -1=全部单元, 否则为单元号。
    property <int> pv_unit: -1;

    ScrollView {
        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // 默认折叠: 平时只需确认"有没有在发", 展开才是手动覆盖操作。
            // ★本页所有块都必须 vertical-stretch: 0 + 末尾留一个弹性占位★
            // 否则视口比内容高时, 多余高度会被两个 ConfigGroupSection 平分并把其中的行压扁,
            // 表现为"两个组标题下各有一大片等高空白, 参数一个都看不见"(实测就是这个症状)。
            // 有了末尾占位, 多余空间全部归它, 各块保持自身首选高度; 内容超过视口时 ScrollView 正常滚动。
            CollapsibleSection {
                title: "mai2serial 发送状态";
                expanded <=> root.mai2_panel_expanded;
                summary: (root.mai2_send_en_known ? (root.mai2_send_en ? "已启用发送" : "未启用发送") : "使能未知")
                    + " · 状态 " + root.mai2_status + " · 波特率 " + root.mai2_baud;
                HorizontalBox {
                    padding: 4px;
                    spacing: 10px;
                    CheckBox {
                        text: "启用发送";
                        checked: root.mai2_send_en;
                        enabled: root.mai2_send_en_known;
                        toggled => { root.mai2_set_send_en(self.checked); }
                    }
                    // 注: 「触控映射仅协议启动时生效」不在此处放专属勾选框 —— 它已作为
                    // comm.keyboard_map_serial_only 归入本页下方「mai2serial 协议参数」组,
                    // 那里带完整中文说明。同一页放两个控件控同一个键只会让人以为是两个设置。
                    Text {
                        text: "状态: " + root.mai2_status;
                        color: root.mai2_status == "运行" ? Theme.ok : Theme.text-sub;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "波特率: " + root.mai2_baud;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "游戏发 {A} 开启发送、{L}/{E} 关闭，此处为手动覆盖。";
                        color: Theme.text-dim;
                        font-size: Theme.fs-normal;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Button {
                        min-width: Theme.button-min-width;
                        horizontal-stretch: 0;
                        text: "刷新";
                        clicked => { root.mai2_refresh(); }
                    }
                }
            }

            // mai2serial 协议参数(串口波特率 / 触控上报延迟 / 发送节流 / {E}RSET 善后行为)。
            // 编辑仅入草稿, 点左下角"保存到设备"才写 flash, 与通信系统 Tab 完全同一条路径。
            ConfigGroupSection {
                vertical-stretch: 0;
                group_title: "mai2serial 协议参数";
                rows: root.config_rows;
                group_counts: root.config_group_counts;
                set_bool(k, v) => { root.cfg_set_bool(k, v); }
                set_number(k, v) => { root.cfg_set_number(k, v); }
                set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                set_enum(k, v) => { root.cfg_set_enum(k, v); }
                set_string(k, v) => { root.cfg_set_string(k, v); }
            }

            // 灯板协议(837-15070-04 复刻, 11 颗灯 / 115200 8N1): 展开后才轮询采样色。
            CollapsibleSection {
                title: "mai2light 灯板协议";
                expanded <=> root.light_panel_expanded;
                summary: "状态 " + root.light_status + " · 灯链 "
                    + (root.light_known ? ((root.light_chain0_ready ? "0" : "-") + "/" + (root.light_chain1_ready ? "1" : "-")) : "未知")
                    + " · 收帧 " + root.light_rx_frames
                    + " · 校验错误 " + root.light_sum_errors + " · 波特率 " + root.light_baud;

                HorizontalBox {
                    padding: 4px;
                    spacing: 10px;
                    Text {
                        text: "状态: " + root.light_status;
                        color: root.light_status == "运行" ? #2b8a3e : #b0b8c0;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "应答: " + root.light_resp_en;
                        color: #b0b8c0;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "波特率: " + root.light_baud;
                        color: #8fd6ff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "收帧: " + root.light_rx_frames;
                        color: #b0b8c0;
                        vertical-alignment: center;
                    }
                    // 校验错误非 0 = 线序/波特率/干扰问题, 变红以区别于正常计数。
                    Text {
                        text: "校验错误: " + root.light_sum_errors;
                        color: root.light_sum_errors == "未知" ? #b0b8c0 : (root.light_sum_errors != "0" ? #d9480f : #2b8a3e);
                        font-weight: root.light_sum_errors != "未知" && root.light_sum_errors != "0" ? 700 : 400;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.light_known ? "" : "尚未回读到设备灯效状态";
                        color: Theme.text-dim;
                        font-size: Theme.fs-normal;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Button {
                        min-width: Theme.button-min-width;
                        horizontal-stretch: 0;
                        text: "刷新";
                        clicked => { root.light_refresh(); }
                    }
                }

                // WS2812 建链诊断: 两链就绪各自成色, 故障分档报红。灯不亮时先看这一行,
                // 而不是去猜映射表 —— 链没建起来时映射再对也不会有输出。
                HorizontalBox {
                    padding: 4px;
                    spacing: 10px;
                    Text {
                        text: "灯链0: " + (root.light_known ? (root.light_chain0_ready ? "已建链" : "未建链") : "未知");
                        color: !root.light_known ? #b0b8c0 : (root.light_chain0_ready ? #2b8a3e : #d9480f);
                        font-weight: (root.light_known && !root.light_chain0_ready) ? 700 : 400;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "灯链1: " + (root.light_known ? (root.light_chain1_ready ? "已建链" : "未建链") : "未知");
                        color: !root.light_known ? #b0b8c0 : (root.light_chain1_ready ? #2b8a3e : #d9480f);
                        font-weight: (root.light_known && !root.light_chain1_ready) ? 700 : 400;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.light_init_fault != "" ? "初始化故障: " + root.light_init_fault : "";
                        color: #d9480f;
                        font-weight: 700;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // 灯链长度与全局亮度走配置 KV(led.ws_count0/1, led.ws_brightness), 随"保存到设备"落 flash。
                HorizontalBox {
                    padding: 4px;
                    spacing: 8px;
                    Text { text: "灯链0 灯珠数:"; vertical-alignment: center; color: Theme.text-sub; }
                    GuardedSpinBox {
                        width: Theme.spin-narrow;
                        horizontal-stretch: 0;
                        minimum: 1;
                        maximum: 1000;
                        model_value: root.light_ws_count0;
                        edited(v) => { root.light_ws_count_set(0, v); }
                    }
                    Text { text: "灯链1 灯珠数:"; vertical-alignment: center; color: Theme.text-sub; }
                    GuardedSpinBox {
                        width: Theme.spin-narrow;
                        horizontal-stretch: 0;
                        minimum: 1;
                        maximum: 1000;
                        model_value: root.light_ws_count1;
                        edited(v) => { root.light_ws_count_set(1, v); }
                    }
                    Text { text: "全局亮度:"; vertical-alignment: center; color: Theme.text-sub; }
                    GuardedSpinBox {
                        width: Theme.spin-narrow;
                        horizontal-stretch: 0;
                        minimum: 0;
                        maximum: 255;
                        model_value: root.light_brightness;
                        edited(v) => { root.light_brightness_set(v); }
                    }
                    Text {
                        text: "以上三项为配置项，需点左下角“保存到设备”才写入 flash。";
                        color: Theme.text-dim;
                        font-size: Theme.fs-normal;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // 11 个虚拟 LED 单元: 采样色块 + 映射编辑。列宽与下方表头一致。
                Rectangle {
                    height: 22px;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 8px;
                        // ★表头列宽必须与下面数据行的控件宽度逐列同源★: 控件宽度取自 Theme 的分档,
                        // 表头也必须引用同一个令牌, 否则改一档宽度就会让表头与数据错列。
                        Text { width: LedCols.unit; text: "单元"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; }
                        Text { width: LedCols.swatch; text: "色"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; }
                        Text { width: LedCols.rgb; text: "采样 RGB"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; }
                        Text { width: Theme.combo-width; text: "通道"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; }
                        Text { width: Theme.spin-narrow; text: "起始"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; }
                        Text { width: Theme.spin-narrow; text: "数量"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; }
                        Text { text: "预览目标"; color: Theme.text-dim; font-size: Theme.fs-normal; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                for row in root.light_units: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: root.pv_unit == row.unit ? #232b33 : transparent;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 8px;
                        Text {
                            width: LedCols.unit;
                            text: row.label;
                            color: Theme.text-title;
                            font-size: Theme.fs-title;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            width: LedCols.swatch;
                            height: 20px;
                            y: 6px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            background: row.sample;
                        }
                        Text {
                            width: LedCols.rgb;
                            text: row.rgb_text;
                            color: Theme.text-sub;
                            font-size: Theme.fs-normal;
                            vertical-alignment: center;
                        }
                        GuardedComboBox {
                            // 104px 低于 fluent ComboBox 自报的 160px 下限 ⇒ 选项文本被箭头区吃掉。
                            width: Theme.combo-width;
                            horizontal-stretch: 0;
                            model: ["未映射", "通道0", "通道1"];
                            model_index: row.ch_choice;
                            selected(_) => {
                                root.light_map_set(row.unit, self.current-index, row.start, row.count);
                            }
                        }
                        // 112px 低于 fluent SpinBox 自报的 128px 下限 ⇒ 数字被上下箭头挤到看不全。
                        GuardedSpinBox {
                            width: Theme.spin-narrow;
                            horizontal-stretch: 0;
                            minimum: 0;
                            maximum: 999;
                            model_value: row.start;
                            edited(v) => { root.light_map_set(row.unit, row.ch_choice, v, row.count); }
                        }
                        GuardedSpinBox {
                            width: Theme.spin-narrow;
                            horizontal-stretch: 0;
                            minimum: 0;
                            maximum: 255;
                            model_value: row.count;
                            edited(v) => { root.light_map_set(row.unit, row.ch_choice, row.start, v); }
                        }
                        Button {
                            min-width: Theme.button-min-width;
                            horizontal-stretch: 0;
                            text: root.pv_unit == row.unit ? "预览目标 ✓" : "设为预览目标";
                            clicked => { root.pv_unit = row.unit; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                HorizontalBox {
                    padding: 4px;
                    spacing: 10px;
                    Button {
                        min-width: Theme.button-min-width;
                        horizontal-stretch: 0;
                        text: "应用映射";
                        // 本地已判定冲突就不让发: LED_SET_REGION 整批原子, 失败等于什么都没变。
                        enabled: root.light_conflict == "";
                        clicked => { root.light_map_apply(); }
                    }
                    Text {
                        text: root.light_conflict != "" ? root.light_conflict : root.light_apply_status;
                        color: root.light_conflict != "" ? Theme.err-soft : Theme.text-sub;
                        font-size: Theme.fs-normal;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                // 预览: 常用色一键 + 可调 RGB, 目标为"全部"或上表选中的单元。
                HorizontalBox {
                    padding: 4px;
                    spacing: 8px;
                    Text {
                        text: "预览目标: " + (root.pv_unit < 0 ? "全部单元" : "单元 " + root.pv_unit);
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                    // 一排色按钮: 全部不拉伸, 余量归行尾空白 —— 否则五个色按钮会各自被拉成一大块。
                    Button {
                        min-width: Theme.button-min-width;
                        horizontal-stretch: 0;
                        text: "改为全部";
                        clicked => { root.pv_unit = -1; }
                    }
                    Button { horizontal-stretch: 0; text: "红"; clicked => { root.light_preview(root.pv_unit, 255, 0, 0); } }
                    Button { horizontal-stretch: 0; text: "绿"; clicked => { root.light_preview(root.pv_unit, 0, 255, 0); } }
                    Button { horizontal-stretch: 0; text: "蓝"; clicked => { root.light_preview(root.pv_unit, 0, 0, 255); } }
                    Button { horizontal-stretch: 0; text: "白"; clicked => { root.light_preview(root.pv_unit, 255, 255, 255); } }
                    Button { horizontal-stretch: 0; text: "熄灭"; clicked => { root.light_preview(root.pv_unit, 0, 0, 0); } }
                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalBox {
                    padding: 4px;
                    spacing: 8px;
                    Text { text: "R"; color: Theme.err; vertical-alignment: center; }
                    SpinBox { width: Theme.spin-narrow; horizontal-stretch: 0; minimum: 0; maximum: 255; value: root.pv_r; edited(v) => { root.pv_r = v; } }
                    Text { text: "G"; color: Theme.ok; vertical-alignment: center; }
                    SpinBox { width: Theme.spin-narrow; horizontal-stretch: 0; minimum: 0; maximum: 255; value: root.pv_g; edited(v) => { root.pv_g = v; } }
                    Text { text: "B"; color: Theme.info; vertical-alignment: center; }
                    SpinBox { width: Theme.spin-narrow; horizontal-stretch: 0; minimum: 0; maximum: 255; value: root.pv_b; edited(v) => { root.pv_b = v; } }
                    Button {
                        min-width: Theme.button-min-width;
                        horizontal-stretch: 0;
                        text: "发送该色";
                        clicked => { root.light_preview(root.pv_unit, root.pv_r, root.pv_g, root.pv_b); }
                    }
                    Text {
                        text: "预览色覆盖协议色，约 3 秒无新预览后自动回到灯板协议色。";
                        color: Theme.text-dim;
                        font-size: Theme.fs-normal;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }

            // mai2light 协议参数(灯板串口波特率 / 节点 ID / 灯珠总数)。灯链长度与全局亮度在上方
            // 专用 SpinBox 里编辑, 映射表由上方 11 单元编辑器负责, 故不在此以裸 KV 重复出现。
            ConfigGroupSection {
                vertical-stretch: 0;
                group_title: "mai2light 协议参数";
                rows: root.config_rows;
                group_counts: root.config_group_counts;
                set_bool(k, v) => { root.cfg_set_bool(k, v); }
                set_number(k, v) => { root.cfg_set_number(k, v); }
                set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                set_enum(k, v) => { root.cfg_set_enum(k, v); }
                set_string(k, v) => { root.cfg_set_string(k, v); }
            }

            // 弹性占位: 视口比内容高时多余空间全归它, 上面各块保持首选高度不被压扁。
            Rectangle { vertical-stretch: 1; }
        }
    }
}
