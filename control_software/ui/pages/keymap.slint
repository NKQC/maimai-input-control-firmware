// ============================================================================
// 触控键盘映射(组合语义) / 物理键盘
// ============================================================================

import { VerticalBox, HorizontalBox, CheckBox, SpinBox, ScrollView, Button, ComboBox } from "std-widgets.slint";
import { KeyCaptureBox, CollapsibleSection, PlotPath, GuardedSpinBox, GuardedCheckBox } from "../common/widgets.slint";
import { Theme } from "../common/theme.slint";

// 逻辑通道池里的一个分区块。选中 = 该分区进入"待新建映射"的分区集合。
component ZoneChip inherits Rectangle {
    in property <string> label;
    in property <bool> picked: false;
    in property <bool> used: false;   // 已被某条映射占用(仅提示, 不禁止复用)
    callback toggled();

    width: 52px;
    height: 26px;
    border-radius: 4px;
    border-width: root.picked ? 2px : 1px;
    border-color: root.picked ? #ffd166 : (root.used ? Theme.accent : Theme.border-light);
    background: root.picked ? #3a3320 : (touch.has-hover ? #262d34 : #1e2429);

    Text {
        text: root.label;
        font-size: Theme.fs-small;
        font-weight: root.picked ? 700 : 400;
        color: root.picked ? #ffd166 : (root.used ? Theme.accent : Theme.text-sub);
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// 已保存的一条组合映射: 压成单行表格。分区集合只读展示(要改仍是删了重建, 保持单一编辑路径);
// 按键组合可就地重录(点键框直接录, 语义同新建区: 跨会话覆盖、会话内累加), 两个时间参数可就地改。
// ★列宽/间距/内边距必须与 ComboHeader 逐项一致★, 两者同为页面 VerticalBox 的直接子项、等宽;
// fluent 的 ScrollView 滚动条是覆盖式绘制(flickable.width = parent.width, 不吃内容宽度),
// 因此滚动条出现与否都不会让表头与数据行错列。
// 单位文字全部上移到表头, 行内不再重复 —— 这才是把 62px 压到 36px 的空间来源。
component ComboRow inherits Rectangle {
    in property <int> index;
    in property <string> zones_text;
    in property <string> keys_text;
    in property <int> delay_ms;
    in property <int> max_hold_ms;
    callback hold_edited(int, int);   // delay, maxhold
    callback key_capture_started();
    callback key_captured(string, bool, bool, bool, bool);  // text, ctrl,shift,alt,gui
    callback hid_submitted(string);
    callback removed();

    // 36px = 内边距 3px×2 + fluent SpinBox 的 min-height 30px, 再矮就会把数字框挤出行外。
    // 行内 KeyCaptureBox 自身固定 28px < 30px, 因此换成可录制键框不会撑高本行。
    height: 36px;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.border-light;
    background: #1c2126;

    HorizontalLayout {
        padding: 3px;
        spacing: 8px;
        Text {
            text: "#" + (root.index + 1);
            width: 30px;
            font-weight: 700;
            color: Theme.text-sub;
            font-size: Theme.fs-small;
            vertical-alignment: center;
        }
        Text {
            text: root.zones_text;
            color: Theme.accent;
            font-size: Theme.fs-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // 就地重录按键: 与新建区用同一个 KeyCaptureBox, 因此覆盖/累加语义天然一致。
        // ★列宽必须与 ComboHeader 的「按键组合」列一致★。280px = KeyCaptureBox 右侧固定预留
        // 146px + 键组合显示区 134px; 原来的 200px 在「应用」按钮加宽后只剩 54px 显示区。
        KeyCaptureBox {
            width: 280px;
            display: root.keys_text;
            capture_started() => { root.key_capture_started(); }
            captured(t, c, s, a, g) => { root.key_captured(t, c, s, a, g); }
            hid_submitted(t) => { root.hid_submitted(t); }
        }
        GuardedSpinBox {
            width: Theme.spin-width;
            minimum: 0;
            maximum: 65535;
            model_value: root.delay_ms;
            edited(v) => { root.hold_edited(v, root.max_hold_ms); }
        }
        GuardedSpinBox {
            width: Theme.spin-width;
            minimum: 0;
            maximum: 65535;
            model_value: root.max_hold_ms;
            edited(v) => { root.hold_edited(root.delay_ms, v); }
        }
        Button {
            width: 52px;
            text: @tr("删除");
            clicked => { root.removed(); }
        }
    }
}

// 映射列表的表头。列宽与 ComboRow 一一对应(改一处必须同时改另一处)。
component ComboHeader inherits HorizontalLayout {
    height: 16px;
    padding-left: 3px;
    padding-right: 3px;
    spacing: 8px;
    Text {
        text: "#";
        width: 30px;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("分区集合");
        horizontal-stretch: 1;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: @tr("按键组合 / HID");
        width: 280px;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("触发延时(ms)");
        width: Theme.spin-width;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("自动抬起(ms)");
        width: Theme.spin-width;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Rectangle { width: 52px; }
}

export component KeyMapPage inherits Rectangle {
    in property <bool> keyboard_map_en: false;
    // 链路诊断一行(由设备实测位推出, 见 proto::KbdLinkDiag::summary)。读不到诊断字段时
    // Rust 侧填"诊断字段不可用…", 本页只显示, 不做任何推断。
    in property <string> link_diag: "";
    in property <[string]> zone_names: [];   // 34 分区名 A1-E8
    // ---- 组合映射(多分区 → 多键) ----
    // 真相源在 AppController::kbd_combo_*; 本页只展示与转发事件。
    in property <[string]> combo_zones_text: [];   // 每条的分区集合可读文本
    in property <[string]> combo_keys_text: [];    // 每条的键组合可读文本
    in property <[int]> combo_delay: [];
    in property <[int]> combo_max_hold: [];
    in property <[bool]> zone_used: [];            // 34 位: 该分区是否已被某条映射用到
    in property <[bool]> zone_picked: [];          // 34 位: 该分区是否在"待新建"集合里
    in property <string> pending_keys_text: "";    // 待新建映射已抓到的键组合
    in property <string> combo_status: "";         // 设备支持性/条数等提示
    in property <int> combo_count: 0;
    // 新建区的两个时间参数(ms)。★刻意只存在于 UI 侧、且添加成功后不清零★:
    // 连续添加同类映射时不必反复重填同一组延时(分区与按键仍照旧清空)。
    // Rust 侧不回写这两个值 —— 这是有意为之的行为, 不是忘记清理的 bug, 请勿"修正"。
    in-out property <int> new_delay_ms: 0;
    in-out property <int> new_max_hold_ms: 0;

    callback set_keyboard_map_en(bool);
    callback combo_zone_toggled(int);
    callback combo_zones_clear();
    callback combo_captured(string, bool, bool, bool, bool);  // text, ctrl,shift,alt,gui
    callback combo_hid_submitted(string);
    callback combo_keys_clear();
    callback combo_add(int, int);   // delay_ms, max_hold_ms
    callback combo_removed(int);
    callback combo_hold_set(int, int, int);
    // 已有映射的按键就地重录: 行号 + 与新建区完全相同的键捕获载荷。
    callback combo_key_capture_started(int);
    callback combo_key_captured(int, string, bool, bool, bool, bool);
    callback combo_key_hid_submitted(int, string);

    VerticalBox {
        padding: 8px;
        spacing: 6px;

        // 链路诊断行。★不套 Rectangle★: Rectangle 在 VerticalBox 里没有内在高度, 里面放
        // 换行 Text 会算不出高度并与下一个元素重叠。单行 + elide 即可, 完整读数在日志里。
        // 条件子项而非空串占位: 还没收到 KBD_GET_STATE 响应时本行整体不存在, 不留一条空缝。
        if root.link_diag != "": Text {
            text: root.link_diag;
            font-size: Theme.fs-small;
            color: Theme.text-title;
            overflow: elide;
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Text {
                text: @tr("选择分区并录入按键组合；保存后生效。HID 可输入十进制或 0xNN。");
                color: Theme.text-sub;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            // ★这里原来有一个「刷新」按钮, 已删★: 连接成功后 main.rs 的自动加载块已经发过
            // kbd_request_combo(), 组合表进页即有真值, 该按钮纯属多余入口。
            // 物理键盘页的「刷新」同样已删 —— 那页的 map/touchmap/hold/keycfg/state 也都在
            // 自动加载块里请求过, 整条 refresh_kbd/kbd_refresh 链路已连根移除。
        }

        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            // ★必须用 GuardedCheckBox★ 设备真值回填, 裸 CheckBox 点一次即失去回填。
            GuardedCheckBox {
                text: @tr("启用触控键盘映射");
                model_checked: root.keyboard_map_en;
                toggled => { root.set_keyboard_map_en(self.checked); }
            }
            Text {
                text: root.combo_status;
                color: Theme.text-sub;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        // 逻辑通道池: 34 个分区块。点一下进/出"待新建"集合。
        Text {
            text: @tr("逻辑通道池（点选参与本条映射的分区）");
            font-size: Theme.fs-small;
            color: Theme.text-title;
        }
        // 分区池用绝对定位网格, 列数按本页宽度自适应 —— 与全通道页同一套已验证的做法。
        // ★不要用 HorizontalLayout 逐行摆★: 原先写成"前 17 个一行、其余一行", 窄窗口必然横向溢出被裁;
        // 而且用 width:0 的占位块隐藏另一半时, 占位块仍然吃 HorizontalLayout 的 spacing, 第二行会被
        // 整体右推(34 × 4px)。绝对定位没有这两个问题。
        // ★依赖链安全★: height ← rows ← cols ← root.width(本页宽度, 由 TabWidget 给),
        // 全程不碰自身高度也不碰滚动条的 visible-width, 因此不会形成布局环。
        pool := Rectangle {
            property <float> cols: Math.max(1, Math.floor((root.width - 24px) / 56px));
            property <float> rows: Math.ceil(root.zone_names.length / self.cols);
            height: self.rows * 30px;
            for name[i] in root.zone_names: ZoneChip {
                x: Math.mod(i, pool.cols) * 56px;
                y: Math.floor(i / pool.cols) * 30px;
                label: name;
                picked: i < root.zone_picked.length ? root.zone_picked[i] : false;
                used: i < root.zone_used.length ? root.zone_used[i] : false;
                toggled => { root.combo_zone_toggled(i); }
            }
        }

        // 新建条: 已选分区 + 抓键 + 两个时间参数 + 添加。
        Rectangle {
            height: 80px;
            border-radius: 5px;
            border-width: 1px;
            border-color: #ffd166;
            background: #241f14;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("新建映射 · 按键组合:");
                        font-size: Theme.fs-small;
                        color: #ffd166;
                        vertical-alignment: center;
                        width: 150px;
                    }
                    KeyCaptureBox {
                        horizontal-stretch: 1;
                        display: root.pending_keys_text;
                        // ★每次录制独立覆盖★: 会话开始即清空待新建键组合, 于是"上次录的键"
                        // 不会跟这次的攒在一起(以前不同时间按的 F7/F6/F5 会累成一条四键映射)。
                        // 同一次会话内仍然累加, 所以"同时按住 F5+F6"这种真实和弦照旧能录成多键。
                        capture_started() => { root.combo_keys_clear(); }
                        captured(t, c, s, a, g) => { root.combo_captured(t, c, s, a, g); }
                        hid_submitted(t) => { root.combo_keys_clear(); root.combo_hid_submitted(t); }
                    }
                    Button {
                        text: @tr("清空按键");
                        clicked => { root.combo_keys_clear(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("清空分区");
                        clicked => { root.combo_zones_clear(); }
                    }
                    Text {
                        text: @tr("触发延时(ms)");
                        font-size: Theme.fs-small;
                        color: Theme.text-sub;
                        vertical-alignment: center;
                    }
                    // 两个 SpinBox 用两向绑定持有页面属性: 添加成功后 Rust 不回写 ⇒ 值自然留存。
                    SpinBox {
                        width: Theme.spin-width;
                        minimum: 0;
                        maximum: 65535;
                        value <=> root.new_delay_ms;
                    }
                    Text {
                        text: @tr("自动抬起(ms)");
                        font-size: Theme.fs-small;
                        color: Theme.text-sub;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: Theme.spin-width;
                        minimum: 0;
                        maximum: 65535;
                        value <=> root.new_max_hold_ms;
                    }
                    Button {
                        text: @tr("添加映射");
                        primary: true;
                        clicked => { root.combo_add(root.new_delay_ms, root.new_max_hold_ms); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        Text {
            text: @tr("已有映射（") + root.combo_count + @tr(" 条）");
            font-size: Theme.fs-small;
            color: Theme.text-title;
        }
        ComboHeader { }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 0px;
                spacing: 4px;
                alignment: start;
                for zt[i] in root.combo_zones_text: ComboRow {
                    index: i;
                    zones_text: zt;
                    keys_text: i < root.combo_keys_text.length ? root.combo_keys_text[i] : "";
                    delay_ms: i < root.combo_delay.length ? root.combo_delay[i] : 0;
                    max_hold_ms: i < root.combo_max_hold.length ? root.combo_max_hold[i] : 0;
                    hold_edited(d, m) => { root.combo_hold_set(i, d, m); }
                    key_capture_started() => { root.combo_key_capture_started(i); }
                    key_captured(t, c, s, a, g) => { root.combo_key_captured(i, t, c, s, a, g); }
                    hid_submitted(t) => { root.combo_key_capture_started(i); root.combo_key_hid_submitted(i, t); }
                    removed => { root.combo_removed(i); }
                }
            }
        }
    }
}

// 逻辑分析仪的一个通道泳道: 左侧通道名 + 中间波形(原始/去抖后/实际输出三条) + 右侧本通道触发读数。
// 12 条泳道共用同一横轴(时间), 因此触发标记的 x 语义在所有泳道之间可直接比较。
component LaneRow inherits Rectangle {
    in property <string> label;
    in property <string> raw_path;    // 去抖前阶梯波形(viewbox 1000×100)
    in property <string> deb_path;    // 仅去抖后阶梯波形
    in property <string> out_path;    // 实际输出 HID 阶梯波形
    in property <float> trig_x: -1;   // 本通道去抖后首个上升沿(0..1000); <0 = 窗口内无触发
    in property <string> trig_text;
    in property <bool> raw_on: false;
    in property <bool> deb_on: false;
    in property <bool> out_on: false;

    height: 26px;
    HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            width: 58px;
            font-size: Theme.fs-small;
            color: Theme.text-sub;
            vertical-alignment: center;
        }
        // 原始/去抖后/输出三个即时状态点: 波形之外还要能一眼看出"现在"是什么状态。
        Rectangle {
            width: 10px; height: 10px; y: 8px;
            border-radius: 5px;
            background: root.raw_on ? #6a9ec9 : #2a3138;
        }
        Rectangle {
            width: 10px; height: 10px; y: 8px;
            border-radius: 5px;
            background: root.deb_on ? Theme.accent : #2a3138;
        }
        Rectangle {
            width: 10px; height: 10px; y: 8px;
            border-radius: 5px;
            background: root.out_on ? Theme.ok : #2a3138;
        }
        plot := Rectangle {
            horizontal-stretch: 1;
            background: #14181c;
            border-width: 1px;
            border-color: Theme.border-light;
            clip: true;
            PlotPath {
                vh: 100;
                commands: root.raw_path;
                stroke: #6a9ec9;
                stroke-width: 1px;
            }
            PlotPath {
                vh: 100;
                commands: root.deb_path;
                stroke: Theme.accent;
                stroke-width: 1px;
            }
            PlotPath {
                vh: 100;
                commands: root.out_path;
                stroke: Theme.ok;
                stroke-width: 1px;
            }
            // 触发标记: 本通道在窗口内去抖后态的第一个上升沿。逐通道独立, 互不影响。
            if root.trig_x >= 0: Rectangle {
                x: parent.width * (root.trig_x / 1000);
                width: 1px;
                height: parent.height;
                background: #ffd166;
            }
        }
        Text {
            text: root.trig_text;
            width: 104px;
            font-size: Theme.fs-small;
            color: root.trig_x >= 0 ? #ffd166 : Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

// 单个物理键的全部参数(极性 / 防抖 / 长按)收在一行两栏里 —— 不让用户在两个页面之间来回找。
component PhysKeyRow inherits Rectangle {
    in property <int> index;
    in property <bool> pressed: false;
    in property <bool> raw_on: false;
    in property <string> display;
    // 极性配置态: 0=低电平触发 / 1=高电平触发 / 2=AUTO(默认)。
    in property <int> pol_mode: 2;
    // ★固件回传的生效极性掩码逐位摊平★(true=当前按高电平触发)。所有档位都用它显示"当前实际
    // 是什么电平触发" —— 绝不用 pol_mode 自己推算, 那等于把设备真值换成本地猜测。
    in property <bool> pol_resolved_high: false;
    // 上面那位是否真的读到过。false = 旧固件没回传 resolved mask → 显示"未知", 不假装低电平。
    in property <bool> pol_resolved_known: false;
    in property <int> debounce_us: 0;
    in property <int> hold_delay: 0;
    in property <int> hold_max: 0;
    callback captured(string, bool, bool, bool, bool);
    callback hid_submitted(string);
    callback cleared();
    callback keycfg_set(int, int);
    callback hold_set(int, int);

    height: 66px;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.border-light;
    background: #1c2126;

    VerticalLayout {
        padding: 4px;
        spacing: 3px;
        HorizontalLayout {
            spacing: Theme.gap;
            Rectangle {
                width: 16px;
                height: 16px;
                y: 6px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-light;
                background: root.pressed ? Theme.ok : (root.raw_on ? #3d5871 : #262b31);
            }
            Text {
                text: @tr("键 ") + (root.index + 1) + " (GPIO" + (root.index + 1) + ")";
                color: #d0d6dd;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                min-width: 92px;
            }
            KeyCaptureBox {
                horizontal-stretch: 1;
                display: root.display;
                captured(t, c, s, a, g) => { root.captured(t, c, s, a, g); }
                hid_submitted(t) => { root.hid_submitted(t); }
            }
            Button {
                text: @tr("清除");
                clicked => { root.cleared(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            ComboBox {
                // 最长选项是"自动(启动电平=抬起)": 150px 会把它省略成"自动(启动电…", 取宽档。
                width: Theme.combo-wide;
                horizontal-stretch: 0;
                // ★model 下标必须与协议值一一对应(0/1/2)★ 另设映射表就是 off-by-one 的温床。
                model: [@tr("低电平触发"), @tr("高电平触发"), @tr("自动(启动电平=抬起)")];
                current-index: root.pol_mode;
                selected => { root.keycfg_set(self.current-index, root.debounce_us); }
            }
            // ★三个数字框原为 96px★, 低于 fluent SpinBox 自报的 128px 下限 ⇒ 文本区被上下箭头挤掉,
            // 五位数(10000/65535)根本看不全。统一取 Theme.spin-narrow(=128px, 恰为下限)。
            // ★列标题不在行内★ 三个"防抖/触发延时/自动抬起"标签原先每行都重复一遍, 与四个定宽控件
            // 一起把本行撑到约 1010px, 而这一页的可用宽度只有约 820px ⇒ 行被撑宽后 ScrollView 直接
            // 裁掉右侧, 连第一行的"清除"按钮也一并看不见。标题改为在 12 行之上只画一次(PhysKeyHeader),
            // 与本文件上半部分的分区表同一范式; 本行只剩 220+128×3 ≈ 622px, 结构上不再可能溢出。
            GuardedSpinBox {
                width: Theme.spin-narrow;
                horizontal-stretch: 0;
                minimum: 0;
                // 上限与固件 KeyboardService::DEBOUNCE_US_MAX 同源: 越界固件会 NAK, 不给用户设的机会。
                maximum: 10000;
                model_value: root.debounce_us;
                edited(v) => { root.keycfg_set(root.pol_mode, v); }
            }
            GuardedSpinBox {
                width: Theme.spin-narrow;
                horizontal-stretch: 0;
                minimum: 0;
                maximum: 65535;
                model_value: root.hold_delay;
                edited(v) => { root.hold_set(v, root.hold_max); }
            }
            GuardedSpinBox {
                width: Theme.spin-narrow;
                horizontal-stretch: 0;
                minimum: 0;
                maximum: 65535;
                model_value: root.hold_max;
                edited(v) => { root.hold_set(root.hold_delay, v); }
            }
            Text {
                // 恒显"当前实际是什么电平触发"(不再只在 AUTO 档露出, 也不做二值化推断):
                // 电平文案一律取固件回传的生效掩码; AUTO 档只多加一个"自动 → "前缀说明来源。
                // ★它就是本行的伸缩位★(原来这里是个 stretch 占位矩形): 放在末尾吃掉剩余宽度并
                // 允许省略号, 于是无论窗口多窄, 溢出压力都落在这条可省略的说明文字上, 而不是
                // 把定宽的数字框挤出可视区 —— 那正是原先整行被裁的原因。
                text: !root.pol_resolved_known
                    ? @tr("当前: 未知")
                    : (root.pol_mode == 2 ? @tr("自动 → ") : "")
                      + (root.pol_resolved_high ? @tr("当前: 高电平触发") : @tr("当前: 低电平触发"));
                font-size: Theme.fs-small;
                color: root.pol_resolved_known ? Theme.text-sub : Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

// 每键参数表的列标题, 在 12 行之上只画一次。★宽度必须与 PhysKeyRow 第二行逐列一致★
// (combo-wide / spin-narrow ×3 + Theme.gap), 否则标题与其下的控件对不上列。
// 左侧 5px = PhysKeyRow 的边框 1px + 内层 VerticalLayout padding 4px。
component PhysKeyHeader inherits HorizontalLayout {
    padding-left: 5px;
    padding-right: 5px;
    spacing: Theme.gap;
    height: 18px;
    Text {
        text: @tr("触发极性");
        width: Theme.combo-wide;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("防抖(us)");
        width: Theme.spin-narrow;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("触发延时(ms)");
        width: Theme.spin-narrow;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("自动抬起(ms)");
        width: Theme.spin-narrow;
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
    }
    Text {
        text: @tr("生效电平");
        font-size: Theme.fs-small;
        color: Theme.text-sub;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component PhysKbdPage inherits Rectangle {
    in property <[bool]> phys_pressed: [];   // 12 键去抖后按下态
    in property <[bool]> phys_raw: [];       // 12 键去抖前(已按极性归一)
    in property <[bool]> phys_out: [];       // 12 键实际输出 HID(经长按状态机)
    in property <[string]> phys_display: []; // 12 键当前组合键显示
    // 数值单位为毫秒：0..65535，与设备 kbd.hdNN/kbd.mhNN KV 完全一致。
    in property <[int]> phys_hold_delay: [];
    in property <[int]> phys_hold_max: [];
    // 每键触发极性配置态(0=低/1=高/2=AUTO)与防抖窗(us, 0..10000)。设备 kbd.plNN / kbd.dbNN。
    in property <[int]> phys_pol_mode: [];
    // 固件解析后的生效极性(true=当前按高电平触发)。所有档位的"当前电平"都只从这里读。
    in property <[bool]> phys_pol_resolved_high: [];
    // 上面那份掩码是否有真实来源。false = 旧固件未回传 → 显示"未知"。
    in property <[bool]> phys_pol_resolved_known: [];
    in property <[int]> phys_debounce: [];
    in property <string> keycfg_status: "";
    // ---- 逻辑分析仪(12 通道共用一张图) ----
    in property <[string]> la_raw_paths: [];
    in property <[string]> la_deb_paths: [];
    in property <[string]> la_out_paths: [];
    in property <[string]> la_trig_text: [];
    in property <[float]> la_trig_x: [];
    in property <[string]> la_time_labels: [];   // 横轴 5 个刻度(左=窗口起点, 右=最新)
    in property <string> la_status: "";
    in property <string> la_span_text: "";
    in property <[string]> la_window_names: [];
    in property <int> la_window_index: 0;
    // 折叠态。三个抽屉各自独立, 默认只展开"当前按键触发状态"(进页即可看到实时态)。
    in-out property <bool> live_expanded: true;
    in-out property <bool> keys_expanded: false;
    in-out property <bool> la_expanded: false;

    callback phys_captured(int, string, bool, bool, bool, bool);  // idx, text, ctrl,shift,alt,gui
    callback phys_hid_submitted(int, string);
    callback phys_cleared(int);
    callback phys_hold_set(int, int, int);
    callback phys_keycfg_set(int, int, int);   // idx, 极性(0=低/1=高/2=AUTO), 防抖 us
    callback la_window_set(int);
    callback la_clear();

    // 根组件不得引用 parent(Slint 禁止): 尺寸由 settings.slint 的 Tab 视口给定。
    // 只声明 min-height: 0px, 让内容自然高度可被外层裁切视口正确反推。
    min-height: 0px;

    VerticalBox {
        width: parent.width;
        height: parent.height;
        min-height: 0px;
        padding: 8px;
        spacing: 6px;

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Text {
                text: @tr("GPIO1–12 按键设置。极性、防抖、延时和 HID 键码保存后生效。");
                color: Theme.text-sub;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }

        ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            VerticalLayout {
                vertical-stretch: 0;
                padding: 0px;
                spacing: 6px;
                alignment: start;

                // ---- 抽屉 1: 当前按键触发状态 ----
                CollapsibleSection {
                    title: @tr("当前按键触发状态");
                    summary: root.keycfg_status;
                    expanded <=> root.live_expanded;
                    Text {
                        text: @tr("原始 / 去抖后 / 实际输出。");
                        color: Theme.text-sub;
                        font-size: Theme.fs-small;
                        // ★折叠区内不用 word-wrap★ 换行文本的高度依赖尚未确定的宽度, 会让外层
                        // CollapsibleSection 的 body.preferred-height 反推偏小 —— 内容被裁掉一截,
                        // 同时按真实高度绘制并溢出到上一个区块的标题之上(本页实测过的症状)。
                        // 这行本来就是一句短说明, 单行足够; 真放不下就省略, 不牵连整块高度。
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    VerticalLayout {
                    padding: 0px;
                    spacing: 2px;
                    for i in 12: HorizontalLayout {
                        spacing: Theme.gap;
                        height: 22px;
                        Text {
                            text: @tr("键 ") + (i + 1) + " (GPIO" + (i + 1) + ")";
                            width: 108px;
                            font-size: Theme.fs-small;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("原始");
                            width: 30px;
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 16px; height: 16px; y: 3px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            background: (i < root.phys_raw.length && root.phys_raw[i]) ? #6a9ec9 : #262b31;
                        }
                        Text {
                            text: @tr("去抖后");
                            width: 42px;
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 16px; height: 16px; y: 3px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            background: (i < root.phys_pressed.length && root.phys_pressed[i]) ? Theme.accent : #262b31;
                        }
                        Text {
                            text: @tr("输出");
                            width: 30px;
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 16px; height: 16px; y: 3px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            background: (i < root.phys_out.length && root.phys_out[i]) ? Theme.ok : #262b31;
                        }
                        Text {
                            // 恒显"当前生效电平"; 电平只取固件掩码, AUTO 档额外标注来源。
                            text: !(i < root.phys_pol_resolved_known.length && root.phys_pol_resolved_known[i])
                                ? @tr("当前: 未知")
                                : ((i < root.phys_pol_mode.length && root.phys_pol_mode[i] == 2) ? @tr("自动 → ") : "")
                                  + ((i < root.phys_pol_resolved_high.length && root.phys_pol_resolved_high[i])
                                      ? @tr("当前: 高电平") : @tr("当前: 低电平"));
                            width: 132px;
                            font-size: Theme.fs-small;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                        Text {
                            text: (i < root.phys_debounce.length ? root.phys_debounce[i] : 0) + "us";
                            width: 64px;
                            font-size: Theme.fs-small;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                        Text {
                            text: i < root.phys_display.length ? root.phys_display[i] : "";
                            font-size: Theme.fs-small;
                            color: #d0d6dd;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    }
                }

                // ---- 抽屉 2: 每键参数(极性 / 防抖 / 长按 / 键码) ----
                CollapsibleSection {
                    title: @tr("每键参数（极性 · 防抖 · 长按 · 键码）");
                    summary: root.keycfg_status;
                    expanded <=> root.keys_expanded;
                    VerticalLayout {
                    padding: 0px;
                    spacing: 4px;
                    PhysKeyHeader { }
                    for i in 12: PhysKeyRow {
                        index: i;
                        pressed: i < root.phys_pressed.length ? root.phys_pressed[i] : false;
                        raw_on: i < root.phys_raw.length ? root.phys_raw[i] : false;
                        display: i < root.phys_display.length ? root.phys_display[i] : "";
                        pol_mode: i < root.phys_pol_mode.length ? root.phys_pol_mode[i] : 2;
                        pol_resolved_high: i < root.phys_pol_resolved_high.length ? root.phys_pol_resolved_high[i] : false;
                        pol_resolved_known: i < root.phys_pol_resolved_known.length ? root.phys_pol_resolved_known[i] : false;
                        debounce_us: i < root.phys_debounce.length ? root.phys_debounce[i] : 0;
                        hold_delay: i < root.phys_hold_delay.length ? root.phys_hold_delay[i] : 0;
                        hold_max: i < root.phys_hold_max.length ? root.phys_hold_max[i] : 0;
                        captured(t, c, s, a, g) => { root.phys_captured(i, t, c, s, a, g); }
                        hid_submitted(t) => { root.phys_hid_submitted(i, t); }
                        cleared => { root.phys_cleared(i); }
                        keycfg_set(pol, db) => { root.phys_keycfg_set(i, pol, db); }
                        hold_set(d, m) => { root.phys_hold_set(i, d, m); }
                    }
                    }
                }

                // ---- 抽屉 3: 逻辑分析仪(12 通道共用一张图, 横轴为设备时间戳) ----
                CollapsibleSection {
                    title: @tr("逻辑分析仪");
                    summary: root.la_status;
                    expanded <=> root.la_expanded;
                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: 28px;
                        Text {
                            text: @tr("时间窗");
                            font-size: Theme.fs-small;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            // 120px 低于 fluent ComboBox 的 160px 下限 ⇒ 窗口时长文本被箭头吃掉。
                            width: Theme.combo-width;
                            horizontal-stretch: 0;
                            model: root.la_window_names;
                            current-index: root.la_window_index;
                            selected => { root.la_window_set(self.current-index); }
                        }
                        Text {
                            text: root.la_span_text;
                            font-size: Theme.fs-small;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Button {
                            min-width: Theme.button-min-width;
                            horizontal-stretch: 0;
                            text: @tr("清空波形");
                            clicked => { root.la_clear(); }
                        }
                    }
                    Text {
                        text: root.la_status;
                        font-size: Theme.fs-small;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }
                    // 12 条泳道纵向排列, 共用同一横轴; 每条右侧是该通道自己的触发读数。
                    VerticalLayout {
                    padding: 0px;
                    spacing: 1px;
                    for i in 12: LaneRow {
                        label: @tr("键") + (i + 1);
                        raw_path: i < root.la_raw_paths.length ? root.la_raw_paths[i] : "";
                        deb_path: i < root.la_deb_paths.length ? root.la_deb_paths[i] : "";
                        out_path: i < root.la_out_paths.length ? root.la_out_paths[i] : "";
                        trig_x: i < root.la_trig_x.length ? root.la_trig_x[i] : -1;
                        trig_text: i < root.la_trig_text.length ? root.la_trig_text[i] : "";
                        raw_on: i < root.phys_raw.length ? root.phys_raw[i] : false;
                        deb_on: i < root.phys_pressed.length ? root.phys_pressed[i] : false;
                        out_on: i < root.phys_out.length ? root.phys_out[i] : false;
                    }
                    }
                    // 横轴刻度: 与泳道波形区左右边界严格对齐(左侧占位 = 通道名 + 三个状态点 + spacing)。
                    HorizontalLayout {
                        spacing: 4px;
                        height: 16px;
                        Rectangle { width: 58px; }
                        Rectangle { width: 10px; }
                        Rectangle { width: 10px; }
                        Rectangle { width: 10px; }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            for lbl[k] in root.la_time_labels: Text {
                                text: lbl;
                                font-size: Theme.fs-small;
                                color: Theme.muted;
                                horizontal-stretch: 1;
                                horizontal-alignment: k == 0 ? left : (k == root.la_time_labels.length - 1 ? right : center);
                            }
                        }
                        Rectangle { width: 104px; }
                    }
                }
            }
        }
    }
}
