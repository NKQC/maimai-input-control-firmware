// ============================================================================
// 配置页 (#6e-2)
// ============================================================================

import { VerticalBox, HorizontalBox, CheckBox, SpinBox, ComboBox, LineEdit, ScrollView, Button } from "std-widgets.slint";
import { ConfigRow, ConfigGroupCount } from "../common/types.slint";
import { Theme } from "../common/theme.slint";
// 配置项模型每次 config 版本变化就整行重推 ⇒ 裸 SpinBox/ComboBox 会打断正在进行的输入
// 并丢掉回填绑定, 一律用带守卫的版本(见 widgets.slint 内注释)。
// 分区用 SectionCard(std GroupBox 只有一行标题文字, 分不出组的边界)。
import { GuardedSpinBox, GuardedComboBox, GuardedCheckBox, SectionCard } from "../common/widgets.slint";

// 注:属性名不能叫 `row`,该名字与 GridLayout 子元素自动注入的 row/col
// 附加属性冲突(编译报 "Cannot override property 'row'")。用 `entry` 代替。
component ConfigRowItem inherits Rectangle {
    in property <ConfigRow> entry;
    // 是否属于当前分组。★行高与显隐由本组件自己算★: 原先调用方各写一遍
    // `height: 属于本组 ? (有取值范围 ? 60px : 48px) : 0px`, 同一份三元式散在多处, 迟早漂移。
    in property <bool> shown: true;
    // 显式 height 在 Slint 里是**权威**的(编译器不允许同时再给 min-height), 故行本身不会被压扁;
    // 会被压扁/摊开的是外层容器, 那由调用方给 vertical-stretch: 0 + 末尾弹性占位来解决(见 protocol.slint)。
    height: root.shown ? (root.entry.range_hex != "" ? 60px : 48px) : 0px;
    visible: root.shown;

    callback set_bool(string, bool);
    callback set_number(string, float);
    callback set_number_hex(string, string);   // 数字配置以十六进制串下发, 由 Rust 侧解析+夹取范围
    callback set_enum(string, int);
    callback set_string(string, string);

    vertical-stretch: 0;
    clip: true;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: Theme.gap;

        // 左侧: 中文名 + 小字说明(控制内容) + 取值范围(hex 口径)。
        // ★固定列宽而不是 min-width★: min-width 下长标签会把控件列往右推, 同页各行控件起点错开。
        VerticalLayout {
            width: Theme.form-label-width;
            horizontal-stretch: 0;
            spacing: 1px;
            Text {
                text: root.entry.label;
                vertical-alignment: center;
                color: Theme.text;
            }
            Text {
                text: root.entry.desc;
                font-size: Theme.fs-small;
                color: Theme.text-dim;
                visible: root.entry.desc != "";
                overflow: elide;
            }
            // 取值范围(十六进制, 附十进制)。仅数字整数型有 range_hex。
            Text {
                text: root.entry.range_hex;
                font-size: Theme.fs-small;
                color: #6f7a84;
                visible: root.entry.range_hex != "";
                overflow: elide;
            }
        }

        // ★控件一律不拉伸 + 给确定宽度★ 原先每个控件写 horizontal-stretch: 1, 于是数字框/下拉/
        // 单行输入被拉到整页宽: 数字被上下箭头挤到看不全、下拉文本与箭头重叠(用户反馈的"输入框被
        // 异常缩放")。剩余宽度统一由本行末尾的弹性空白吸收。
        // ★必须用 GuardedCheckBox★ 这一行住在 Repeater 里且行实例会被复用, 裸 CheckBox 被点过
        // 一次就摧毁 `checked` 绑定, 此后撤销草稿/重新回读/换页都推不进来 —— 勾选状态会跟着行号
        // 而不是跟着数据。见 widgets.slint 的说明。
        if root.entry.kind == 0: GuardedCheckBox {
            horizontal-stretch: 0;
            model_checked: root.entry.bool_val;
            toggled => {
                root.set_bool(root.entry.key, self.checked);
            }
        }

        // 设备设置配置一律十进制 SpinBox(hex 口径仅用于需寄存器处理的 CSD 内容, 见触控全局调整页)。
        if root.entry.kind == 1: GuardedSpinBox {
            width: Theme.spin-width;
            horizontal-stretch: 0;
            minimum: Math.round(root.entry.min_val);
            maximum: Math.round(root.entry.max_val);
            model_value: Math.round(root.entry.num_val);
            edited(v) => {
                root.set_number(root.entry.key, v);
            }
        }

        if root.entry.kind == 2: GuardedComboBox {
            // 选项含括号说明("HID(触摸屏+键盘)"), 取宽档才不会被省略号吃掉。
            width: Theme.combo-wide;
            horizontal-stretch: 0;
            model: [@tr("Serial(游戏串口)"), @tr("HID(触摸屏+键盘)")];
            model_index: root.entry.enum_index;
            selected(_) => {
                root.set_enum(root.entry.key, self.current-index);
            }
        }

        // 固件 schema 以 U8 提供 LED 颜色，未携带 enum options；仅这四个
        // led.color_* 键使用专用 kind=4，仍经 set_number 保持原有 U8 写入路径。
        if root.entry.kind == 4: GuardedComboBox {
            width: Theme.combo-width;
            horizontal-stretch: 0;
            model: [@tr("熄灭"), @tr("红"), @tr("绿"), @tr("黄"), @tr("蓝"), @tr("紫"), @tr("青"), @tr("白")];
            model_index: root.entry.enum_index;
            selected(_) => {
                root.set_number(root.entry.key, self.current-index);
            }
        }

        if root.entry.kind == 3: LineEdit {
            width: Theme.combo-wide;
            horizontal-stretch: 0;
            text: root.entry.str_val;
            edited(v) => {
                root.set_string(root.entry.key, v);
            }
        }
        // 行尾弹性空白: 控件不被拉伸的根本保证(与 widgets.slint::FormRow 同一套做法)。
        Rectangle { horizontal-stretch: 1; }
    }
}

// 展示 `rows` 中 group == group_title 的条目。过滤在 for 循环体内按条件
// 渲染(Slint 不支持数组推导式 filter 语法),故传入完整 rows,由每个
// section 各自筛选自己关心的组。
// 导出给协议页复用: 搬过去的协议参数用同一套 ConfigRow → 控件映射与同一套 cfg_set_* 草稿写入,
// 不在协议页重造一遍 SpinBox/CheckBox 与专用属性。
export component ConfigGroupSection inherits SectionCard {
    in property <string> group_title;
    in property <[ConfigRow]> rows;
    // 各组行数(由 main.rs 与 rows 同批回填)。本组为 0 行时就地报出原因, 绝不留一片空白让人猜。
    in property <[ConfigGroupCount]> group_counts: [];

    callback set_bool(string, bool);
    callback set_number(string, float);
    callback set_number_hex(string, string);
    callback set_enum(string, int);
    callback set_string(string, string);

    title: root.group_title;

    VerticalBox {
        padding: 0px;
        // spacing 设 0: 不属于本组的行 height=0, 若有 spacing 会累积成大段空白(旧 bug 根因)。
        // 行间距改由 ConfigRowItem 自身上下 padding + 分隔线提供。
        spacing: 0px;

        // ★空组必须自报原因★ 用 for+条件高度实现"仅当本组计数为 0 时出现一行说明"
        // (Slint 的 for 不能接 if, 且没有按 key 查模型的语法, 故按匹配项控制显隐/占位)。
        for gc in root.group_counts: Rectangle {
            property <bool> hit: gc.group == root.group_title && gc.count == 0;
            height: self.hit ? 40px : 0px;
            visible: self.hit;
            clip: true;
            Text {
                width: 100%;
                text: root.rows.length == 0
                    ? "⚠ 本组 0 项 —— 设备配置尚未取到(共 0 项): 未连接, 或配置读取(CFG_GET_ALL)未完成/被拒。请到主页重连或查看日志。"
                    : "⚠ 本组 0 项 —— 已取到 " + root.rows.length + " 项配置, 但没有一项归属本组: 分组归属异常, 请查看日志中的「配置分组直方图」。";
                color: Theme.warn;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        for row in root.rows: ConfigRowItem {
            entry: row;
            // Slint 的 `for` 不支持直接接 `if` 元素, 故按"是否属于本组"控制显隐与占位高度;
            // 高度/最小高度由 ConfigRowItem 自己按 shown 算(单一来源, 见其定义)。
            shown: row.group == root.group_title;
            set_bool(key, v) => { root.set_bool(key, v); }
            set_number(key, v) => { root.set_number(key, v); }
            set_number_hex(key, v) => { root.set_number_hex(key, v); }
            set_enum(key, v) => { root.set_enum(key, v); }
            set_string(key, v) => { root.set_string(key, v); }
        }
    }
}

export component ConfigPage inherits Rectangle {
    in property <[ConfigRow]> rows;
    in property <bool> config_dirty: false;
    // group == "其他" 的行数(未收录 key 的兜底组), 由 main.rs 与 rows 同步回填。
    in property <int> other_count: 0;
    // 各组行数, 供空组就地自报原因(见 ConfigGroupSection)。
    in property <[ConfigGroupCount]> group_counts: [];

    callback cfg_set_bool(string, bool);
    callback cfg_set_number(string, float);
    callback cfg_set_number_hex(string, string);
    callback cfg_set_enum(string, int);
    callback cfg_set_string(string, string);
    callback cfg_load();
    callback cfg_save();
    callback cfg_reset();

    VerticalBox {
        padding: Theme.page-pad;
        spacing: Theme.card-gap;

        HorizontalLayout {
            height: Theme.row-height;
            spacing: Theme.gap;

            Button {
                min-width: Theme.button-min-width;
                horizontal-stretch: 0;
                text: @tr("加载");
                clicked => { root.cfg_load(); }
            }
            Button {
                min-width: Theme.button-min-width;
                horizontal-stretch: 0;
                text: @tr("保存到设备");
                clicked => { root.cfg_save(); }
            }
            Button {
                min-width: Theme.button-min-width;
                horizontal-stretch: 0;
                text: @tr("恢复默认");
                clicked => { root.cfg_reset(); }
            }
            Text {
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: no-wrap;
                overflow: elide;
                text: root.config_dirty
                    ? @tr("● 有草稿未保存(编辑仅暂存, 点击“保存到设备”后才下发并生效)")
                    : @tr("✓ 已与设备同步");
                color: root.config_dirty ? Theme.warn : Theme.ok;
                font-size: Theme.fs-title;
            }
        }

        ScrollView {
            VerticalBox {
                padding: 0px;
                // 组间距用卡片令牌: 必须明显大于卡片内的行距, 否则多张卡片会读成一串等距的行。
                spacing: Theme.card-gap;

                // ★组标题 = 渲染归属★ mai2serial/mai2light 的协议参数已归到"协议"页的同名组,
                // 本页只挂剩下的四组, 标题与内容一一对应(不再有名为"通信"却空着的组)。
                ConfigGroupSection {
                    group_title: "开机校准";
                    subtitle: "开机即执行，不依赖 mai2serial 协议初始化；{E} RSET 自动校准/基线复位是协议页的另一条路径。";
                    rows: root.rows;
                    group_counts: root.group_counts;
                    set_bool(k, v) => { root.cfg_set_bool(k, v); }
                    set_number(k, v) => { root.cfg_set_number(k, v); }
                    set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                    set_enum(k, v) => { root.cfg_set_enum(k, v); }
                    set_string(k, v) => { root.cfg_set_string(k, v); }
                }

                ConfigGroupSection {
                    group_title: "工作模式";
                    rows: root.rows;
                    group_counts: root.group_counts;
                    set_bool(k, v) => { root.cfg_set_bool(k, v); }
                    set_number(k, v) => { root.cfg_set_number(k, v); }
                    set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                    set_enum(k, v) => { root.cfg_set_enum(k, v); }
                    set_string(k, v) => { root.cfg_set_string(k, v); }
                }

                ConfigGroupSection {
                    group_title: "键盘映射";
                    rows: root.rows;
                    group_counts: root.group_counts;
                    set_bool(k, v) => { root.cfg_set_bool(k, v); }
                    set_number(k, v) => { root.cfg_set_number(k, v); }
                    set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                    set_enum(k, v) => { root.cfg_set_enum(k, v); }
                    set_string(k, v) => { root.cfg_set_string(k, v); }
                }

                ConfigGroupSection {
                    group_title: "状态指示灯";
                    rows: root.rows;
                    group_counts: root.group_counts;
                    set_bool(k, v) => { root.cfg_set_bool(k, v); }
                    set_number(k, v) => { root.cfg_set_number(k, v); }
                    set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                    set_enum(k, v) => { root.cfg_set_enum(k, v); }
                    set_string(k, v) => { root.cfg_set_string(k, v); }
                }

                // 未收录 key 的兜底组: 固件新增 KV 时不会静默消失, 会出现在这里。
                // 用 `if` 而非 visible: 组为空时整块从树上移除, 不会留下一个有标题没内容的空框
                // (visible:false 仍占布局位)。行数由 Rust 侧统计, Slint 无数组过滤/计数能力。
                if root.other_count > 0: ConfigGroupSection {
                    group_title: "其他";
                    rows: root.rows;
                    group_counts: root.group_counts;
                    set_bool(k, v) => { root.cfg_set_bool(k, v); }
                    set_number(k, v) => { root.cfg_set_number(k, v); }
                    set_number_hex(k, v) => { root.cfg_set_number_hex(k, v); }
                    set_enum(k, v) => { root.cfg_set_enum(k, v); }
                    set_string(k, v) => { root.cfg_set_string(k, v); }
                }
            }
        }
    }
}
