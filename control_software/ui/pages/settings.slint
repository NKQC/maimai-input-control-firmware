        Tab {
            title: "算法";

            AlgoPage {
                algo_info_text: root.algo_info_text;
                algo_c_source <=> root.algo_c_source;
                algo_metadata_rows: root.algo_metadata_rows;
                algo_setting_rows: root.algo_setting_rows;
                algo_refresh() => { root.algo_refresh(); }
                algo_status: root.algo_status;
                algo_phase: root.algo_phase;
                algo_asm: root.algo_asm;
                algo_asm_bytes: root.algo_asm_bytes;
                algo_asm_capacity: root.algo_asm_capacity;
                algo_c_bytes: root.algo_c_bytes;
                algo_c_capacity: root.algo_c_capacity;
                algo_reset_default() => { root.algo_reset_default(); }
                algo_compile(s) => { root.algo_compile(s); }
                algo_upload() => { root.algo_upload(); }
                algo_build_upload(s) => { root.algo_build_upload(s); }
                algo_load_template(i) => { root.algo_load_template(i); }
                algo_source_edited(s) => { root.algo_source_edited(s); }
                algo_setting_edited(idx, v) => { root.algo_setting_edited(idx, v); }
                algo_metadata_edited(idx, kind, alias, description) => { root.algo_metadata_edited(idx, kind, alias, description); }
            }
        }

        }
    }

        // 全局保存栏固定锚定根层底部，不参与 TabWidget 的最小尺寸协商；因此不会被任一
        // 子页的内容高度顶出客户区。
        HorizontalBox {
            x: 0px;
            y: parent.height - 46px;
            width: parent.width;
            height: 46px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            Button {
                // 下发是**串行**的(每帧等设备 ACK 才发下一帧), 期间必须锁住按钮:
                // 重复点击会把同一批草稿再排一遍队, 设备侧收到重复写入。
                text: root.save_pending > 0 ? ("⏳ 下发中 " + root.save_pending + " 项") : "保存到设备";
                enabled: root.config_dirty && root.save_pending == 0;
                clicked => { root.cfg_save(); }
            }
            // 设置文件始终可操作：导出可离线保存当前缓存，导入的连接校验由 Rust 给出明确原因。
            Button {
                text: "导出 JSON";
                clicked => {
                    root.settings_io_action = 1;
                    root.settings_io_config = true; root.settings_io_channel_params = true;
                    root.settings_io_globals = true; root.settings_io_algo = true;
                    root.settings_io_keyboard = true; root.settings_io_zones = true;
                    root.settings_io_dialog = true;
                }
            }
            Button {
                text: "导入 JSON";
                clicked => {
                    root.settings_io_action = 2;
                    root.settings_io_config = true; root.settings_io_channel_params = true;
                    root.settings_io_globals = true; root.settings_io_algo = true;
                    root.settings_io_keyboard = true; root.settings_io_zones = true;
                    root.settings_io_dialog = true;
                }
            }
            Text {
                // 下发进行中优先显示进度: 串行下发一批上百项要几秒, 没有进度的话界面看着像卡住。
                text: root.save_pending > 0
                    ? ("正在串行下发到设备… 剩余 " + root.save_pending + " 项（逐条等设备回执，请勿断开）")
                    : (root.mode_change_needs_reboot
                    ? (root.config_dirty_count + " 项未保存 — 含 Serial/HID 模式切换, 保存后将自动重启设备生效")
                    : (root.config_dirty
                        ? (root.config_dirty_count + " 项改动未保存 — 点击保存写入设备 flash")
                        : "无改动 (已与设备 flash 同步)"));
                color: root.save_pending > 0 ? #8fd6ff
                    : (root.mode_change_needs_reboot ? #f5a623
                    : (root.config_dirty ? #f5a623 : #2b8a3e));
                vertical-alignment: center;
                horizontal-stretch: 1;
                // 无 elide 的单行 Text 会把整句话的宽度当作 min-width(见 Slint text_layout_info),
                // 那会让本栏 min-width 涨到 800px 以上, 反过来把三个按钮挤出窄窗口。让文字先让位。
                wrap: no-wrap;
                overflow: elide;
            }
        }

    // 覆盖范围弹窗放在 SettingsPage 根层，避免 TabWidget/滚动容器裁剪，且与当前深色主题一致。
    Rectangle {
        visible: root.settings_io_dialog;
        x: 0; y: 0;
        width: root.width; height: root.height;
        // 弹窗子项的最小尺寸会回推 SettingsPage，弹窗尺寸不能依赖父尺寸以免形成布局环。
        clip: true;
        background: #000000a8;
        Rectangle {
            width: 560px;
            height: 418px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1e23;
            border-color: #2b3238;
            border-width: 1px;
            border-radius: 7px;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.settings_io_action == 1 ? "导出设备设置 JSON" : "导入设备设置 JSON";
                    color: #e0e6ec;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "导入仅生成草稿；保存后生效。";
                    color: #9aa6b2;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                CheckBox {
                    text: "配置（" + root.settings_io_config_count + " 项）";
                    checked: root.settings_io_config;
                    toggled => { root.settings_io_config = self.checked; }
                }
                CheckBox {
                    text: "通道参数（" + root.settings_io_channel_params_count + " 项）";
                    checked: root.settings_io_channel_params;
                    toggled => { root.settings_io_channel_params = self.checked; }
                }
                CheckBox {
                    text: "全局 CSD（" + root.settings_io_globals_count + " 项）";
                    checked: root.settings_io_globals;
                    toggled => { root.settings_io_globals = self.checked; }
                }
                CheckBox {
                    text: "算法（" + root.settings_io_algo_count + " 项）";
                    checked: root.settings_io_algo;
                    toggled => { root.settings_io_algo = self.checked; }
                }
                CheckBox {
                    text: "键盘映射（" + root.settings_io_keyboard_count + " 项）";
                    checked: root.settings_io_keyboard;
                    toggled => { root.settings_io_keyboard = self.checked; }
                }
                CheckBox {
                    text: "分区绑定（" + root.settings_io_zones_count + " 项）";
                    checked: root.settings_io_zones;
                    toggled => { root.settings_io_zones = self.checked; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => { root.settings_io_dialog = false; }
                    }
                    Button {
                        text: "确定";
                        clicked => {
                            root.settings_io_dialog = false;
                            if (root.settings_io_action == 1) {
                                root.settings_export(root.settings_io_config, root.settings_io_channel_params,
                                    root.settings_io_globals, root.settings_io_algo, root.settings_io_keyboard, root.settings_io_zones);
                            } else {
                                root.settings_import(root.settings_io_config, root.settings_io_channel_params,
                                    root.settings_io_globals, root.settings_io_algo, root.settings_io_keyboard, root.settings_io_zones);
                            }
                        }
                    }
                }
            }
        }
    }
}
