                algo_report_lines: root.algo_report_lines;
                active_norm_amp: root.active_norm_amp;
                curve_t_span_ms: root.curve_t_span_ms;
                curve_t_end_text: root.curve_t_end_text;
                curve_r_min: root.curve_r_min;
                curve_r_max: root.curve_r_max;
                params_expanded <=> root.curve_params_expanded;
                algo_cfg_expanded <=> root.curve_algo_cfg_expanded;
                series_expanded <=> root.curve_series_expanded;
                spectrum_expanded <=> root.curve_spectrum_expanded;
                spectrum_cells: root.curve_spectrum_cells;
                spectrum_active: root.curve_spectrum_active;
                spectrum_status: root.curve_spectrum_status;
                focus_bandwidth: root.focus_bandwidth;
                spectrum_progress: root.curve_spectrum_progress;
                spectrum_start() => { root.curve_spectrum_start(); }
                spectrum_cancel() => { root.curve_spectrum_cancel(); }
                // 批量队列活跃 ⇒ 本页扫描/校准/基线/自适应锁定(与全局精调页双向互斥)。
                batch_op_active: root.batch_op_active;
                plot_frozen: root.plot_frozen;
                sample_rate_hz: root.sample_rate_hz;
                threshold_warning: root.curve_threshold_warning;
                plot_resume() => { root.plot_resume(); }
                plot_freeze() => { root.plot_freeze(); }
                // 通道启用开关(PARAM_ENABLED=0x0C): 关闭后本页一切对它无意义的操作全部锁定。
                ch_enabled: root.curve_ch_enabled;
                ch_enable_set(on) => { root.curve_ch_enable_set(on); }
                calibrate() => { root.curve_calibrate(); }
                baseline_reset() => { root.curve_baseline_reset(); }
                measure_cp() => { root.curve_measure_cp(); }
                auto_tune_channel() => { root.curve_auto_tune(); }
                auto_tune_status: root.curve_auto_tune_status;
                threshold_set(pid, v) => { root.threshold_set(pid, v); }
                param_edited(pid, v) => { root.curve_param_edited(pid, v); }
                mode_changed(m) => { root.curve_mode_changed(m); }
                capture_params() => { root.curve_capture_params(); }
                report_norm_set(idx, v) => { root.report_norm_set(idx, v); }
                op_busy: root.op_busy;
                op_label: root.op_label;
            }
        }

        Tab {
            title: "触控键盘映射";

