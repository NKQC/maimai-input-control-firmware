                live_expanded <=> root.phys_live_expanded;
                keys_expanded <=> root.phys_keys_expanded;
                la_expanded <=> root.phys_la_expanded;
                phys_captured(i, t, c, s, a, g) => { root.kbd_capture_phys(i, t, c, s, a, g); }
                phys_hid_submitted(i, t) => { root.kbd_hid_phys(i, t); }
                phys_cleared(i) => { root.kbd_clear_phys(i); }
                phys_hold_set(i, delay, max_hold) => { root.kbd_set_hold_phys(i, delay, max_hold); }
                phys_keycfg_set(i, pol, db) => { root.kbd_set_keycfg(i, pol, db); }
