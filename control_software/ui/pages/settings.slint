                zone_picked: root.combo_zone_picked;
                pending_keys_text: root.combo_pending_keys_text;
                combo_status: root.combo_status;
                combo_count: root.combo_count;
                set_keyboard_map_en(v) => { root.set_keyboard_map_en(v); }
                combo_zone_toggled(z) => { root.combo_zone_toggled(z); }
                combo_zones_clear() => { root.combo_zones_clear(); }
                combo_captured(t, c, s, a, g) => { root.combo_captured(t, c, s, a, g); }
                combo_hid_submitted(t) => { root.combo_hid_submitted(t); }
                combo_keys_clear() => { root.combo_keys_clear(); }
                combo_add(d, m) => { root.combo_add(d, m); }
                combo_removed(i) => { root.combo_removed(i); }
                combo_hold_set(i, d, m) => { root.combo_hold_set(i, d, m); }
                combo_key_capture_started(i) => { root.combo_key_capture_started(i); }
                combo_key_captured(i, t, c, s, a, g) => { root.combo_key_captured(i, t, c, s, a, g); }
                combo_key_hid_submitted(i, t) => { root.combo_key_hid_submitted(i, t); }
