                finger_th_val: root.finger_th_val;
                noise_th_val: root.noise_th_val;
                params: root.curve_params;
                cp_text: root.cp_text;
                curve_readout: root.curve_readout;
                active_path: root.active_path;
                active_point_count: root.active_point_count;
                show_active <=> root.show_active;
