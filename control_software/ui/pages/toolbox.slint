import { Button, VerticalBox, HorizontalBox, ListView, CheckBox, SpinBox, ScrollView } from "std-widgets.slint";
import { VcamKbdRow } from "../common/types.slint";
// 分区一律用 SectionCard, 带标签的控件行一律用 FormRow(见 widgets.slint 里两者的头注释)。
import { GuardedSpinBox, SectionCard, FormRow } from "../common/widgets.slint";
import { Theme } from "../common/theme.slint";


// ============================================================================
// 设置页容器:子标签,原样挂载现有页面组件 + 算法页
// ============================================================================

// ============================================================================
// 工具箱页: 自动设置端口 + 虚拟扫码摄像头(占位)
// ============================================================================

export component ToolboxPage inherits Rectangle {
    // 子标签: 0=自动设置端口 1=虚拟扫码摄像头(占位)
    property <int> tb_tab: 0;

    in property <bool> auto_port_enabled: false;
    in property <int> serial_com: 3;
    in property <int> light_com: 21;
    in property <string> port_status: "";

    // 虚拟扫码摄像头
    in property <bool> vcam_enabled: false;
    in property <int> vcam_submit_secs: 2;
    in property <int> vcam_display_secs: 10;
    in property <string> vcam_last_data: "";
    in property <image> vcam_preview;
    // 系统安装状态和当前会话运行状态由 Rust 独立回填，避免把“已点安装”误当作已注册。
    // 当前是否已提权, 以及一句话受限说明(由 Rust 侧的 elevation 模块给出)。
    in property <bool> is_elevated: false;
    in property <string> elevation_text: "";
    callback restart_as_admin();
    in property <string> vcam_install_status: "未安装";
    in property <string> vcam_runtime_status: "未运行";
    // 安装/卸载正在进行中(提权 + 改注册表/文件): 两个按钮共用这一个标志一起禁用。
    in property <bool> vcam_deploy_busy: false;
    // WinUSB 改绑的三档状态(签名 / 绑定)与本机内核驱动可行性诊断, 全部由 Rust 侧实测后回填。
    in property <string> vcam_signing_status: "未签名";
    in property <string> vcam_binding_status: "未改绑";
    in property <string> vcam_kernel_diag: "";
    // 只在动作失败时非空: 成功的结论由上面两行状态承担, 重复说一遍就是啰嗦。
    in property <string> vcam_winusb_note: "";
    // 输入源设备树(组头 + 设备项), 由 Rust 侧按分类展平后填充。
    in property <[VcamKbdRow]> vcam_kbd_rows;
    in property <int> vcam_device_index: 0;

    callback set_auto_port_enabled(bool);
    callback set_serial_com(int);
    callback set_light_com(int);
    callback apply_ports();
    callback set_vcam_enabled(bool);
    callback set_vcam_submit_secs(int);
    callback set_vcam_display_secs(int);
    callback set_vcam_device(int);
    callback refresh_vcam_devices();
    callback install_vcam();
    callback uninstall_vcam();
    callback sign_vcam_driver();
    callback bind_vcam_winusb();
    callback unbind_vcam_winusb();

    // 「签名并信任」的二次确认闸: 第一次点击只展开告知文案, 必须再点一次专门的确认按钮才真的执行。
    // 往受信任根证书存储里写东西是不可当作顺手操作的, 所以确认状态放在 UI 本地, 不参与持久化。
    property <bool> sign_confirm: false;

    // ★整页装进 ScrollView★ 本页内容(权限提示 + 设备树 + 若干参数行 + 说明)的 min-height 约 660px,
    // 在 520px 高的窗口里会溢出并把底部说明/预览挤出可视区。ScrollView 自身 min 只有 50px, 且其
    // viewport-height = max(视口高, 子布局 min-height): 窗口矮时页内滚动, 窗口高时子布局照常铺满。
    ScrollView {
        VerticalBox {
            padding: 8px;
            spacing: 8px;

            HorizontalBox {
                padding: 0px;
                spacing: 6px;
                Rectangle {
                    // min-width: 行尾有 stretch 空白吸收余量, 视觉同固定宽; 文案变长也不会被裁。
                    min-width: 140px; height: 30px; border-radius: 4px;
                    background: root.tb_tab == 0 ? #2b7de9 : #23282e;
                    Text { text: "自动设置端口"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.tb_tab = 0; } }
                }
                Rectangle {
                    min-width: 140px; height: 30px; border-radius: 4px;
                    background: root.tb_tab == 1 ? #2b7de9 : #23282e;
                    Text { text: "虚拟扫码摄像头"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.tb_tab = 1; } }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // 权限提示板: 固定 COM 口与虚拟摄像头注册都要管理员。Windows 无法给已运行进程提权,
            // 只能以管理员重开自身, 所以这里给一键提权重启(参数原样带过去), 不必让用户去右键启动。
            if !root.is_elevated: Rectangle {
                height: 40px;
                background: #2a2318;
                border-color: #6b5320;
                border-width: 1px;
                border-radius: 6px;
                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: "⚠ " + root.elevation_text;
                        color: #f5c469;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "以管理员重启";
                        clicked => { root.restart_as_admin(); }
                    }
                }
            }

            if root.tb_tab == 0: SectionCard {
                title: "自动设置端口";
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.card-inner-gap;

                    CheckBox {
                        text: "启动时自动设置端口号";
                        checked: root.auto_port_enabled;
                        toggled => { root.set_auto_port_enabled(self.checked); }
                    }

                    // 两个 COM 口走同一个 FormRow: 标签列宽一致 ⇒ 两个数字框左边缘对齐。
                    FormRow {
                        label: "触控串口(mai2serial) COM:";
                        GuardedSpinBox {
                            width: Theme.spin-width;
                            horizontal-stretch: 0;
                            minimum: 1;
                            maximum: 255;
                            model_value: root.serial_com;
                            edited(v) => { root.set_serial_com(v); }
                        }
                    }

                    FormRow {
                        label: "灯效串口(mai2light) COM:";
                        GuardedSpinBox {
                            width: Theme.spin-width;
                            horizontal-stretch: 0;
                            minimum: 1;
                            maximum: 255;
                            model_value: root.light_com;
                            edited(v) => { root.set_light_com(v); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.gap;
                        Button {
                            min-width: Theme.button-min-width;
                            horizontal-stretch: 0;
                            text: "立即应用";
                            clicked => { root.apply_ports(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Text {
                        text: root.port_status;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "设置固定 COM 口，重连后生效。";
                        color: Theme.text-dim;
                        font-size: Theme.fs-normal;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            if root.tb_tab == 1: SectionCard {
                title: "虚拟扫码摄像头";
                vertical-stretch: 1;

                HorizontalBox {
                    padding: 4px;
                    spacing: 12px;

                    // 左: 设置
                    // 原 width: 320px 在 720px 宽窗口下无法压缩, 会把右侧预览挤成零宽。改成
                    // "下限 240 / 上限 360": 窄窗口先让设置栏收窄, 宽窗口到 360 就停, 余量全归预览。
                    VerticalBox {
                        min-width: 240px;
                        max-width: 360px;
                        padding: 0px;
                        spacing: 10px;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            CheckBox {
                                text: "启用虚拟扫码摄像头";
                                checked: root.vcam_enabled;
                                toggled => { root.set_vcam_enabled(self.checked); }
                            }
                            Text {
                                text: root.vcam_runtime_status;
                                color: root.vcam_enabled ? #8fd6ff : #9aa6b2;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            background: #1a1e23;
                            border-color: #2b3238;
                            border-width: 1px;
                            border-radius: 4px;
                            VerticalBox {
                                padding: 7px;
                                spacing: 5px;
                                Text { text: "系统摄像头注册"; color: #e0e6ec; font-weight: 700; }
                                Text {
                                    text: root.vcam_install_status;
                                    color: #8fd6ff;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    // 部署进行中两个按钮一起禁用: 它们改同一批注册表键与文件,
                                    // 并发点只会得到互相踩踏后无法解释的核验结果。
                                    Button {
                                        text: root.vcam_deploy_busy ? "安装中…" : "安装(需管理员)";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.install_vcam(); }
                                    }
                                    Button {
                                        text: root.vcam_deploy_busy ? "请稍候…" : "卸载(需管理员)";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.uninstall_vcam(); }
                                    }
                                }
                                Text {
                                    text: "可对选定设备执行热重启；若未执行则不会拦截目标设备输入。";
                                    color: #7f8c96;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                // 内核过滤驱动到底可不可行 + 在位键盘节点/槽上限, 都是实测读数。
                                // 旧版只给一句笼统文案, 用户会被误导去排查根本不存在的兼容性问题。
                                if root.vcam_kernel_diag != "": Text {
                                    text: root.vcam_kernel_diag;
                                    color: #c8a24a;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // WinUSB 改绑: 把扫码器的 USB 节点从 hidusb 换到微软已签名的 winusb.sys。
                        // 之后 Windows 不再把它当键盘 ⇒ 天然 100% 吞键, 没有键盘槽上限。
                        Rectangle {
                            background: #1a1e23;
                            border-color: #2b3238;
                            border-width: 1px;
                            border-radius: 4px;
                            VerticalBox {
                                padding: 7px;
                                spacing: 5px;
                                Text {
                                    text: "WinUSB 改绑（100% 吞键）";
                                    color: #e0e6ec;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "① 签名 " + root.vcam_signing_status
                                        + "    ② 绑定 " + root.vcam_binding_status;
                                    color: #8fd6ff;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                // 三个动作并排一行。★不要再把它们拆成三个各自带 stretch 的 HorizontalBox★
                                // 那样每行都要独立分配高度, 与下面的条件确认块一起把布局撑得七零八落。
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    Button {
                                        text: "① 签名并信任";
                                        enabled: !root.vcam_deploy_busy && !root.sign_confirm;
                                        clicked => { root.sign_confirm = true; }
                                    }
                                    Button {
                                        text: "② 安装并改绑";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.bind_vcam_winusb(); }
                                    }
                                    Button {
                                        text: "恢复原驱动";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.unbind_vcam_winusb(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // 二次确认: 必须显式再点一次「确认执行」才会往证书存储写入任何东西。
                                // ★这里不能再套一层 Rectangle 当告知面板★ Rectangle 在 VerticalBox 里没有
                                // 内在高度, 里面又是会换行的文本 ⇒ 高度算不出来, 实测会与下一个按钮压在一起
                                // (用户截图里的"确认键重叠"就是这么来的)。直接做 VerticalBox 的条件子项即可。
                                if root.sign_confirm: Text {
                                    text: "将向本机「受信任的根证书颁发机构」与「受信任的发布者」写入一张本应用自签名证书，"
                                        + "仅用于满足 Windows 10 起对驱动包的强制签名；不安装任何内核驱动。「恢复原驱动」会把它一并移除。";
                                    color: #f5c469;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                if root.sign_confirm: HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    Button {
                                        text: root.vcam_deploy_busy ? "签名中…" : "确认执行";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => {
                                            root.sign_confirm = false;
                                            root.sign_vcam_driver();
                                        }
                                    }
                                    Button {
                                        text: "取消";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.sign_confirm = false; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // 只在动作真的失败时出现: 状态行说不出"为什么没成", 那句必须留在界面上。
                                if root.vcam_winusb_note != "": Text {
                                    text: root.vcam_winusb_note;
                                    color: #ff9a8a;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                // ★这段副作用必须出现在界面上★ 吞键就是靠"它不再是键盘"实现的,
                                // 用户必须事先知道代价, 而不是事后发现扫码器在别处也不工作了。
                                Text {
                                    text: "⚠ 改绑后该扫码器在所有程序里都不再是键盘（吞键就是这么实现的），要恢复请点「恢复原驱动」。";
                                    color: #f5c469;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // 输入源设备树: 不选则收所有键盘(打字会污染扫码缓冲), 选定扫码器后只收它。
                        // 按设备分类分组, 每行给出系统里的设备描述/厂商/父设备, 便于认出哪个是扫码器。
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            Text {
                                text: "扫码器设备(设备树):";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "刷新";
                                clicked => { root.refresh_vcam_devices(); }
                            }
                        }

                        Rectangle {
                            // 设备树是本列唯一"越高越有用"的块: 下限 120px + 独占多余高度, 取代固定 168px。
                            min-height: 120px;
                            vertical-stretch: 1;
                            background: #14181c;
                            border-color: #2b3238;
                            border-width: 1px;
                            border-radius: 4px;

                            ListView {
                                width: 100%;
                                height: 100%;

                                for row in root.vcam_kbd_rows: Rectangle {
                                    height: row.is_group ? 22px : 38px;
                                    background: row.is_group
                                        ? #1c2228
                                        : (row.dev_index == root.vcam_device_index ? #234a63 : transparent);

                                    HorizontalLayout {
                                        padding-left: 6px + row.level * 14px;
                                        padding-right: 6px;
                                        padding-top: 2px;
                                        padding-bottom: 2px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: (row.is_group ? "■ " : "") + row.title
                                                    + (row.is_group ? "   (" + row.detail + ")" : "");
                                                color: row.is_group
                                                    ? (row.level == 0 ? #7f8c96 : #a8b6c0)
                                                    : #dfe6ea;
                                                font-size: row.is_group ? 11px : 13px;
                                                font-weight: row.is_group ? 700 : 400;
                                                overflow: elide;
                                            }
                                            if !row.is_group && row.detail != "": Text {
                                                text: row.detail;
                                                color: #7f8c96;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // 组头不可选。
                                    if !row.is_group: TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set_vcam_device(row.dev_index); }
                                    }
                                }
                            }
                        }

                        // 两项都走 FormRow: 左栏最宽只有 360px, 标签列取窄一档才留得下数字框。
                        FormRow {
                            label: "输入停顿提交阈值(秒):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 1;
                                maximum: 10;
                                model_value: root.vcam_submit_secs;
                                edited(v) => { root.set_vcam_submit_secs(v); }
                            }
                        }

                        FormRow {
                            label: "QR 显示时长(秒):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 1;
                                maximum: 60;
                                model_value: root.vcam_display_secs;
                                edited(v) => { root.set_vcam_display_secs(v); }
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            Text { text: "最近提交数据:"; vertical-alignment: center; }
                            Text {
                                text: root.vcam_last_data == "" ? "(无)" : root.vcam_last_data;
                                color: #8fd6ff;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            text: "扫码内容转为 QR 画面；停顿或 Enter 提交。";
                            color: #7f8c96;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // 右: 预览(黑底 QR)
                    Rectangle {
                        horizontal-stretch: 1;
                        // 给下限, 否则窄窗口下左栏吃满宽度会把预览压成一条缝(QR 变得不可扫)。
                        min-width: 180px;
                        min-height: 180px;
                        background: #000000;
                        border-radius: 4px;
                        Image {
                            source: root.vcam_preview;
                            image-fit: contain;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
        }
    }
}
