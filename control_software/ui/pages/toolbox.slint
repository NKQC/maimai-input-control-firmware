import { Button, VerticalBox, HorizontalBox, ListView, CheckBox, SpinBox, ScrollView } from "std-widgets.slint";
import { VcamKbdRow } from "../common/types.slint";
// 分区一律用 SectionCard, 带标签的控件行一律用 FormRow(见 widgets.slint 里两者的头注释)。
import { GuardedSpinBox, SectionCard, FormRow } from "../common/widgets.slint";
import { Theme } from "../common/theme.slint";


// ============================================================================
// 设置页容器:子标签,原样挂载现有页面组件 + 算法页
// ============================================================================

// ============================================================================
// 工具箱页: 自动设置端口 + 虚拟扫码摄像头(占位)
// ============================================================================

export component ToolboxPage inherits Rectangle {
    // 子标签: 0=自动设置端口 1=虚拟扫码摄像头(占位)
    property <int> tb_tab: 0;

    in property <bool> auto_port_enabled: false;
    in property <int> serial_com: 3;
    in property <int> light_com: 21;
    in property <string> port_status: "";

    // 虚拟扫码摄像头
    in property <bool> vcam_enabled: false;
    // 测试覆盖模式: 恒定输出带外框的 TEST 图案(含走动的游标), 用来独立验证出画链路。
    in property <bool> vcam_test_pattern: false;
    callback set_vcam_test_pattern(bool);
    // X 镜像: 左右翻转输出帧。预览与出画同源, 勾上后两边一起翻。
    in property <bool> vcam_mirror_x: false;
    callback set_vcam_mirror_x(bool);
    // 输出分辨率与 QR 占短边百分比。回填的都是夹取后的实际生效值。
    in property <int> vcam_frame_w: 640;
    in property <int> vcam_frame_h: 480;
    in property <int> vcam_qr_fill_pct: 75;
    callback set_vcam_resolution(int, int);
    callback set_vcam_qr_fill_pct(int);
    in property <int> vcam_submit_secs: 2;
    in property <int> vcam_display_secs: 10;
    in property <string> vcam_last_data: "";
    in property <image> vcam_preview;
    // 系统安装状态和当前会话运行状态由 Rust 独立回填，避免把“已点安装”误当作已注册。
    // 当前是否已提权, 以及一句话受限说明(由 Rust 侧的 elevation 模块给出)。
    in property <bool> is_elevated: false;
    in property <string> elevation_text: "";
    callback restart_as_admin();
    in property <string> vcam_install_status: "未安装";
    in property <string> vcam_runtime_status: "未运行";
    // 安装/卸载正在进行中(提权 + 改注册表/文件): 两个按钮共用这一个标志一起禁用。
    in property <bool> vcam_deploy_busy: false;
    // WinUSB 改绑的三档状态(签名 / 绑定)与本机内核驱动可行性诊断, 全部由 Rust 侧实测后回填。
    in property <string> vcam_signing_status: "未签名";
    in property <string> vcam_binding_status: "未改绑";
    in property <string> vcam_kernel_diag: "";
    // 只在动作失败时非空: 成功的结论由上面两行状态承担, 重复说一遍就是啰嗦。
    in property <string> vcam_winusb_note: "";
    // 输入源设备树(组头 + 设备项), 由 Rust 侧按分类展平后填充。
    in property <[VcamKbdRow]> vcam_kbd_rows;
    in property <int> vcam_device_index: 0;

    callback set_auto_port_enabled(bool);
    callback set_serial_com(int);
    callback set_light_com(int);
    callback apply_ports();
    callback set_vcam_enabled(bool);
    callback set_vcam_submit_secs(int);
    callback set_vcam_display_secs(int);
    callback set_vcam_device(int);
    callback refresh_vcam_devices();
    callback install_vcam();
    callback uninstall_vcam();
    callback sign_vcam_driver();
    callback bind_vcam_winusb();
    callback unbind_vcam_winusb();

    // 「签名并信任」的二次确认闸: 第一次点击只展开告知文案, 必须再点一次专门的确认按钮才真的执行。
    // 往受信任根证书存储里写东西是不可当作顺手操作的, 所以确认状态放在 UI 本地, 不参与持久化。
    property <bool> sign_confirm: false;
    // 「安装」的二次确认闸。★这一步必须先告知再执行★ 安装会连带装上键盘输入过滤组件, 它在重启前
    // 会让**此后重新插拔/重新上电的每一个键盘**在整个系统里收不到输入 —— 这个代价必须事先说清,
    // 不能等用户事后发现扫码器和固件键盘一起没反应。确认状态同样只活在 UI 本地。
    property <bool> install_confirm: false;

    // ★整页装进 ScrollView★ 本页内容(权限提示 + 设备树 + 若干参数行 + 说明)的 min-height 约 660px,
    // 在 520px 高的窗口里会溢出并把底部说明/预览挤出可视区。ScrollView 自身 min 只有 50px, 且其
    // viewport-height = max(视口高, 子布局 min-height): 窗口矮时页内滚动, 窗口高时子布局照常铺满。
    ScrollView {
        VerticalBox {
            padding: 8px;
            spacing: 8px;

            HorizontalBox {
                padding: 0px;
                spacing: 6px;
                Rectangle {
                    // min-width: 行尾有 stretch 空白吸收余量, 视觉同固定宽; 文案变长也不会被裁。
                    min-width: 140px; height: 30px; border-radius: 4px;
                    background: root.tb_tab == 0 ? #2b7de9 : #23282e;
                    Text { text: "自动设置端口"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.tb_tab = 0; } }
                }
                Rectangle {
                    min-width: 140px; height: 30px; border-radius: 4px;
                    background: root.tb_tab == 1 ? #2b7de9 : #23282e;
                    Text { text: "虚拟扫码摄像头"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.tb_tab = 1; } }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // 权限提示板: 固定 COM 口与虚拟摄像头注册都要管理员。Windows 无法给已运行进程提权,
            // 只能以管理员重开自身, 所以这里给一键提权重启(参数原样带过去), 不必让用户去右键启动。
            if !root.is_elevated: Rectangle {
                height: 40px;
                background: #2a2318;
                border-color: #6b5320;
                border-width: 1px;
                border-radius: 6px;
                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: "⚠ " + root.elevation_text;
                        color: #f5c469;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "以管理员重启";
                        clicked => { root.restart_as_admin(); }
                    }
                }
            }

            if root.tb_tab == 0: SectionCard {
                title: "自动设置端口";
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.card-inner-gap;

                    CheckBox {
                        text: "启动时自动设置端口号";
                        checked: root.auto_port_enabled;
                        toggled => { root.set_auto_port_enabled(self.checked); }
                    }

                    // 两个 COM 口走同一个 FormRow: 标签列宽一致 ⇒ 两个数字框左边缘对齐。
                    FormRow {
                        label: "触控串口(mai2serial) COM:";
                        GuardedSpinBox {
                            width: Theme.spin-width;
                            horizontal-stretch: 0;
                            minimum: 1;
                            maximum: 255;
                            model_value: root.serial_com;
                            edited(v) => { root.set_serial_com(v); }
                        }
                    }

                    FormRow {
                        label: "灯效串口(mai2light) COM:";
                        GuardedSpinBox {
                            width: Theme.spin-width;
                            horizontal-stretch: 0;
                            minimum: 1;
                            maximum: 255;
                            model_value: root.light_com;
                            edited(v) => { root.set_light_com(v); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.gap;
                        Button {
                            min-width: Theme.button-min-width;
                            horizontal-stretch: 0;
                            text: "立即应用";
                            clicked => { root.apply_ports(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Text {
                        text: root.port_status;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "设置固定 COM 口，重连后生效。";
                        color: Theme.text-dim;
                        font-size: Theme.fs-normal;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            if root.tb_tab == 1: SectionCard {
                title: "虚拟扫码摄像头";
                vertical-stretch: 1;

                HorizontalBox {
                    padding: 4px;
                    spacing: 12px;

                    // 左: 设置栏, 自带滚动。
                    //
                    // ★为什么左栏必须是"宽度确定 + 自带滚动", 而不是弹性宽度★
                    // 本栏几乎全是 wrap: word-wrap 的说明文本, 而换行文本的 min-height 取决于它拿到
                    // 多宽。以前这里写 min-width: 240 / max-width: 360 —— 布局先按某个宽度算出各段
                    // 文本的 min-height, 实际分配时若比那个宽度窄, 每段文本就要多折一行, 于是整栏
                    // 的真实高度大于已分配的高度, 底部的块被顶出卡片(用户看到的"底部超出边界")。
                    // 两个 vertical-stretch: 1(设备树 + 尾部占位)在滚动视口里还会互相抢那点余量,
                    // 让症状随窗口尺寸飘忽不定。
                    // 现在: 宽度由窗口宽**唯一**决定 ⇒ 文本折行确定 ⇒ min-height 确定; 高度不够时
                    // 由本栏自己滚动, 不再把父布局撑破。
                    // ★宽度只准依赖 root.width★ 它是本页整体宽度(由外层给出), 与本 ScrollView 内部
                    // 滚动条无关。绝不能用 visible-width: 那会形成"滚动条 → 可见宽 → 文本高 →
                    // 视口高 → 滚动条"的求值环(本工程别处已栽过)。
                    ScrollView {
                        horizontal-stretch: 0;
                        // 下限由**本栏内最宽的那一行**决定, 不是随手取的数: 「安装(需管理员)」+
                        // 「卸载(需管理员)」并排约需 270px, 分辨率那行(标签 150 + 两个数字框 + "x")
                        // 约需 310px, 再加内边距与滚动条 ⇒ 360px 才不裁切。低于这个数就会出现
                        // 横向滚动条并把按钮文字切掉(实测截图里就是这样)。
                        width: max(380px, min(470px, root.width * 0.46));
                        // ★上下限必须是常量★ 一旦写成由 parent.height 推, 子的 min-height 会向上
                        // 决定父的 min, 父高度又回头喂给子, 布局直接成环。
                        min-height: 240px;
                        max-height: 1000px;

                        VerticalLayout {
                            // 减掉竖向滚动条占位, 免得再横向滚一下。
                            width: parent.width - 14px;
                            spacing: 10px;

                            // 开关分两行: 三个勾选框加一句状态挤在一行, 在 300px 上下的栏宽里必然
                            // 溢出。主开关独占一行, 两个输出选项并排, 状态文案单独一行换行显示。
                            CheckBox {
                                text: "启用虚拟扫码摄像头";
                                checked: root.vcam_enabled;
                                toggled => { root.set_vcam_enabled(self.checked); }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                CheckBox {
                                    text: "X 镜像";
                                    checked: root.vcam_mirror_x;
                                    toggled => { root.set_vcam_mirror_x(self.checked); }
                                }
                                CheckBox {
                                    text: "测试图案";
                                    checked: root.vcam_test_pattern;
                                    enabled: root.vcam_enabled;
                                    toggled => { root.set_vcam_test_pattern(self.checked); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                text: root.vcam_runtime_status;
                                color: root.vcam_enabled ? #8fd6ff : #9aa6b2;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                        Rectangle {
                            background: #1a1e23;
                            border-color: #2b3238;
                            border-width: 1px;
                            border-radius: 4px;
                            VerticalBox {
                                padding: 7px;
                                spacing: 5px;
                                Text { text: "系统摄像头注册"; color: #e0e6ec; font-weight: 700; }
                                Text {
                                    text: root.vcam_install_status;
                                    color: #8fd6ff;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    // 部署进行中两个按钮一起禁用: 它们改同一批注册表键与文件,
                                    // 并发点只会得到互相踩踏后无法解释的核验结果。
                                    Button {
                                        text: root.vcam_deploy_busy ? "安装中…" : "安装(需管理员)";
                                        enabled: !root.vcam_deploy_busy && !root.install_confirm;
                                        clicked => { root.install_confirm = true; }
                                    }
                                    Button {
                                        text: root.vcam_deploy_busy ? "请稍候…" : "卸载(需管理员)";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.uninstall_vcam(); }
                                    }
                                }
                                // ★安装前告示★ 与「签名并信任」同一手法: 第一次点击只展开这段文案。
                                // 三件事必须齐全 —— 装什么、要你做什么、影响谁; 只讲功能与后果,
                                // 不讲实现。★不要套 Rectangle★ 见下方签名告示处的同一条布局告诫。
                                if root.install_confirm: Text {
                                    text: "将安装：系统虚拟摄像头 + 键盘输入过滤组件。\n"
                                        + "需要你做的：过程中确认管理员弹窗；装完必须重启电脑，过滤组件才会生效。\n"
                                        + "⚠ 影响面：从装完到重启电脑之前，凡是重新插拔或重新上电的键盘（扫码器、本机固件键盘都算）"
                                        + "会在整个系统里收不到输入，重启后自行恢复；当前已在用的键盘不受影响。\n"
                                        + "只要扫码器独占输入，用下面的「WinUSB 改绑」即可，不必安装本组件。";
                                    color: #f5c469;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                if root.install_confirm: HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    Button {
                                        text: root.vcam_deploy_busy ? "安装中…" : "确认安装";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => {
                                            root.install_confirm = false;
                                            root.install_vcam();
                                        }
                                    }
                                    Button {
                                        text: "取消";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.install_confirm = false; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text {
                                    text: "键盘输入过滤组件装完需重启电脑才生效；只要扫码器可改用下面的「WinUSB 改绑」。";
                                    color: #7f8c96;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                // 内核过滤驱动到底可不可行 + 在位键盘节点/槽上限, 都是实测读数。
                                // 旧版只给一句笼统文案, 用户会被误导去排查根本不存在的兼容性问题。
                                if root.vcam_kernel_diag != "": Text {
                                    text: root.vcam_kernel_diag;
                                    color: #c8a24a;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // WinUSB 改绑: 把扫码器的 USB 节点从 hidusb 换到微软已签名的 winusb.sys。
                        // 之后 Windows 不再把它当键盘 ⇒ 天然 100% 吞键, 没有键盘槽上限。
                        Rectangle {
                            background: #1a1e23;
                            border-color: #2b3238;
                            border-width: 1px;
                            border-radius: 4px;
                            VerticalBox {
                                padding: 7px;
                                spacing: 5px;
                                Text {
                                    text: "WinUSB 改绑（100% 吞键）";
                                    color: #e0e6ec;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "① 签名 " + root.vcam_signing_status
                                        + "    ② 绑定 " + root.vcam_binding_status;
                                    color: #8fd6ff;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                // 三个动作并排一行。★不要再把它们拆成三个各自带 stretch 的 HorizontalBox★
                                // 那样每行都要独立分配高度, 与下面的条件确认块一起把布局撑得七零八落。
                                // 三个动作拆成两行。★不要再挤成一行★ 三个按钮的最小宽度之和
                                // 超过本栏可用宽度, 挤在一行的结果是后两个按钮被裁掉(第三个
                                // 干脆看不见)。按钮不会缩到文字以下, 所以只能换行, 不能靠压缩。
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    Button {
                                        text: "① 签名并信任";
                                        enabled: !root.vcam_deploy_busy && !root.sign_confirm;
                                        clicked => { root.sign_confirm = true; }
                                    }
                                    Button {
                                        text: "② 安装并改绑";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.bind_vcam_winusb(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    Button {
                                        text: "恢复原驱动";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.unbind_vcam_winusb(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // 二次确认: 必须显式再点一次「确认执行」才会往证书存储写入任何东西。
                                // ★这里不能再套一层 Rectangle 当告知面板★ Rectangle 在 VerticalBox 里没有
                                // 内在高度, 里面又是会换行的文本 ⇒ 高度算不出来, 实测会与下一个按钮压在一起
                                // (用户截图里的"确认键重叠"就是这么来的)。直接做 VerticalBox 的条件子项即可。
                                if root.sign_confirm: Text {
                                    text: "将向本机「受信任的根证书颁发机构」与「受信任的发布者」写入一张本应用自签名证书，"
                                        + "仅用于满足 Windows 10 起对驱动包的强制签名；不安装任何内核驱动。「恢复原驱动」会把它一并移除。";
                                    color: #f5c469;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                if root.sign_confirm: HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    Button {
                                        text: root.vcam_deploy_busy ? "签名中…" : "确认执行";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => {
                                            root.sign_confirm = false;
                                            root.sign_vcam_driver();
                                        }
                                    }
                                    Button {
                                        text: "取消";
                                        enabled: !root.vcam_deploy_busy;
                                        clicked => { root.sign_confirm = false; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // 只在动作真的失败时出现: 状态行说不出"为什么没成", 那句必须留在界面上。
                                if root.vcam_winusb_note != "": Text {
                                    text: root.vcam_winusb_note;
                                    color: #ff9a8a;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                // ★这段副作用必须出现在界面上★ 吞键就是靠"它不再是键盘"实现的,
                                // 用户必须事先知道代价, 而不是事后发现扫码器在别处也不工作了。
                                Text {
                                    text: "⚠ 改绑后该扫码器在所有程序里都不再是键盘（吞键就是这么实现的），要恢复请点「恢复原驱动」。";
                                    color: #f5c469;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // 输入源设备树: 不选则收所有键盘(打字会污染扫码缓冲), 选定扫码器后只收它。
                        // 按设备分类分组, 每行给出系统里的设备描述/厂商/父设备, 便于认出哪个是扫码器。
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            Text {
                                text: "扫码器设备(设备树):";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "刷新";
                                clicked => { root.refresh_vcam_devices(); }
                            }
                        }

                        Rectangle {
                            // 设备树自己就能滚(内部是 ListView), 所以这里只需要一个确定高度, 不再
                            // 用 vertical-stretch 去抢余量 —— 在滚动视口里"抢余量"本就没有意义,
                            // 反而让整栏高度算不准。高度随窗口高走, 但只依赖 root.height(外层给出的
                            // 页面高度), 不依赖本栏内容, 因此不会成环。
                            height: max(150px, min(280px, root.height * 0.3));
                            background: #14181c;
                            border-color: #2b3238;
                            border-width: 1px;
                            border-radius: 4px;

                            ListView {
                                width: 100%;
                                height: 100%;

                                for row in root.vcam_kbd_rows: Rectangle {
                                    height: row.is_group ? 22px : 38px;
                                    background: row.is_group
                                        ? #1c2228
                                        : (row.dev_index == root.vcam_device_index ? #234a63 : transparent);

                                    HorizontalLayout {
                                        padding-left: 6px + row.level * 14px;
                                        padding-right: 6px;
                                        padding-top: 2px;
                                        padding-bottom: 2px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: (row.is_group ? "■ " : "") + row.title
                                                    + (row.is_group ? "   (" + row.detail + ")" : "");
                                                color: row.is_group
                                                    ? (row.level == 0 ? #7f8c96 : #a8b6c0)
                                                    : #dfe6ea;
                                                font-size: row.is_group ? 11px : 13px;
                                                font-weight: row.is_group ? 700 : 400;
                                                overflow: elide;
                                            }
                                            if !row.is_group && row.detail != "": Text {
                                                text: row.detail;
                                                color: #7f8c96;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // 组头不可选。
                                    if !row.is_group: TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set_vcam_device(row.dev_index); }
                                    }
                                }
                            }
                        }

                        // 输出分辨率: 宽高各一个数字框。生效值会被夹进范围并取偶数(NV12 的色度按
                        // 2x2 块取样, 奇数尺寸会让行距错位), 所以回填值可能与刚敲进去的不同 ——
                        // 显示的始终是**实际生效**的那个值。
                        // ★宽高必须各占一行★ 挤在一行需要 标签160 + 数字框128 + "x" + 数字框128
                        // ≈ 440px, 而本栏可用宽度只有 360 上下 —— 而 spin-narrow(128px) 已是数字框
                        // 自报的下限, 再压就把里面的数字挤没了。所以只能分行, 不能靠压缩控件。
                        FormRow {
                            label: "输出宽度(px):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 160;
                                maximum: 1920;
                                model_value: root.vcam_frame_w;
                                edited(v) => { root.set_vcam_resolution(v, root.vcam_frame_h); }
                            }
                        }

                        FormRow {
                            label: "输出高度(px):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 120;
                                maximum: 1080;
                                model_value: root.vcam_frame_h;
                                edited(v) => { root.set_vcam_resolution(root.vcam_frame_w, v); }
                            }
                        }

                        FormRow {
                            label: "QR 占画面短边(%):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 10;
                                maximum: 100;
                                model_value: root.vcam_qr_fill_pct;
                                edited(v) => { root.set_vcam_qr_fill_pct(v); }
                            }
                        }

                        // ★这条不是提示, 是硬性要求的说明★ 分辨率全链路原样透传、不做任何缩放,
                        // 而 DirectShow 的尺寸在连接时就与下游定死, 所以改分辨率只能整条链路重来:
                        // 本程序会自动卸载重建摄像头, 消费端那边必须由用户重新打开一次。
                        Text {
                            text: "分辨率原样透传、不缩放：改分辨率会自动卸载并重建摄像头，之后必须在消费端(游戏 / OBS)重新打开一次摄像头，否则那边只会看到黑帧。";
                            color: #7f8c96;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        // 两项都走 FormRow: 左栏最宽 430px, 标签列取窄一档才留得下数字框。
                        FormRow {
                            label: "输入停顿提交阈值(秒):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 1;
                                maximum: 10;
                                model_value: root.vcam_submit_secs;
                                edited(v) => { root.set_vcam_submit_secs(v); }
                            }
                        }

                        FormRow {
                            label: "QR 显示时长(秒):";
                            label_width: 160px;
                            GuardedSpinBox {
                                width: Theme.spin-narrow;
                                horizontal-stretch: 0;
                                minimum: 1;
                                maximum: 60;
                                model_value: root.vcam_display_secs;
                                edited(v) => { root.set_vcam_display_secs(v); }
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            Text { text: "最近提交数据:"; vertical-alignment: center; }
                            Text {
                                text: root.vcam_last_data == "" ? "(无)" : root.vcam_last_data;
                                color: #8fd6ff;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                            Text {
                                text: "扫码内容转为 QR 画面；停顿或 Enter 提交。QR 规则与游戏侧图样一致（Version 自适应 / 纠错 M / 字母数字模式）。";
                                color: #7f8c96;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            // 末尾留白: 让上面各块保持自身首选高度, 而不是被平分多余空间压扁。
                            // 内容超过视口时由本栏的 ScrollView 滚动。
                            Rectangle { vertical-stretch: 1; }
                        }
                    }

                    // 右: 预览(黑底 QR)。宽高都跟着窗口走, 余量全归它 —— 预览越大越好扫。
                    Rectangle {
                        horizontal-stretch: 1;
                        // 给下限, 否则窄窗口下左栏吃满宽度会把预览压成一条缝(QR 变得不可扫)。
                        min-width: 180px;
                        min-height: 200px;
                        background: #000000;
                        border-radius: 4px;
                        clip: true;
                        Image {
                            source: root.vcam_preview;
                            image-fit: contain;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
        }
    }
}
