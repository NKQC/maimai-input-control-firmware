import { Button, ComboBox, VerticalBox, HorizontalBox, ScrollView, TextEdit } from "std-widgets.slint";
import { AlgoMetadataRow, AlgoSettingRow } from "../common/types.slint";
import { LineEdit } from "std-widgets.slint";
import { AlgoSettingEditorRow } from "../common/widgets.slint";
import { Theme } from "../common/theme.slint";

// ============================================================================
// JIT 算法页：左侧代码编辑器，右侧设备状态、变量声明与交互。
// ============================================================================

export component AlgoPage inherits Rectangle {
    in property <string> algo_info_text: "算法信息未读取";
    in-out property <string> algo_c_source;
    in property <string> algo_line_numbers: "1";
    in property <string> algo_status: "";
    in property <bool> algo_busy: false;
    in property <string> algo_phase: "";
    in property <string> algo_asm: "";
    in property <int> algo_asm_bytes: 0;
    in property <int> algo_asm_capacity: 1024;
    in property <int> algo_c_bytes: 0;
    in property <int> algo_c_capacity: 32768;
    property <int> editor_tab: 0; // 0=C 源，1=ASM
    in-out property <float> split_ratio: 0.66;
    property <float> split_drag_start_ratio: 0.66;

    callback algo_refresh();
    callback algo_reset_default();
    callback algo_compile(string);
    callback algo_upload();
    callback algo_build_upload(string);
    callback algo_load_template(int);
    callback algo_source_edited(string);
    in property <[AlgoMetadataRow]> algo_metadata_rows: [];
    in property <[AlgoSettingRow]> algo_setting_rows: [];
    callback algo_setting_edited(int, int);
    callback algo_metadata_edited(int, int, string, string);

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        VerticalBox {
            // ★顶部两行不能钉死高度★ 原先用 height: Theme.row-height(34px) 固定, 而 ComboBox 与
            // Button 在原生样式下的自然高度更大, 于是控件被压扁(文字贴边、下拉箭头挤掉)。
            // 改成 min-height 让控件按自身需要撑开; 同时嵌套 Box 显式 padding: 0, 避免内外层
            // 默认内边距叠加后又把行内可用高度吃掉。
            padding: 0px;
            spacing: 6px;
            HorizontalBox {
                padding: 0px;
                min-height: Theme.row-height;
                spacing: Theme.gap;
                Text {
                    text: "JIT 触控算法";
                    color: Theme.text;
                    font-size: Theme.fs-page;
                    vertical-alignment: center;
                }
                Button {
                    min-width: Theme.button-min-width;
                    text: "读取信息";
                    clicked => { root.algo_refresh(); }
                }
                Text {
                    text: root.algo_info_text;
                    color: Theme.text-sub;
                    min-width: 0px;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
            HorizontalBox {
                padding: 0px;
                min-height: Theme.row-height;
                spacing: Theme.gap;
                alignment: start;
                Text { text: "模板:"; color: Theme.text-sub; vertical-alignment: center; }
                tpl_sel := ComboBox {
                    // 用 min/max 而不是 width: 在 HorizontalBox 内 width 会被布局重新分配,
                    // 表现为下拉框被拉到半屏宽; min/max 才能真正固定成设计宽度。
                    min-width: 300px;
                    max-width: 300px;
                    horizontal-stretch: 0;
                    model: ["v3.1 HDR 默认", "纯白灯演示(触摸点亮)"];
                    current-index: 0;
                }
                Button {
                    min-width: Theme.button-min-width;
                    text: "加载模板";
                    clicked => { root.algo_load_template(tpl_sel.current-index); }
                }
            }
        }

        // 与单通道精调一致：可拖拽的左右面板，编辑器永远占左列，运行态与交互永远在右列。
        body := Rectangle {
            vertical-stretch: 1;
            min-height: 240px;

            left := Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.split_ratio - 10px;
                height: parent.height;
                background: #14181c;
                border-width: 1px;
                border-color: #3a434c;
                clip: true;

                VerticalBox {
                    padding: 8px;
                    spacing: 6px;
                    HorizontalBox {
                        spacing: 6px;
                        Rectangle {
                            min-width: 88px;
                            height: 30px;
                            border-radius: 4px;
                            background: root.editor_tab == 0 ? #2b7de9 : #23282e;
                            Text { text: "C 源"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.editor_tab = 0; } }
                        }
                        Rectangle {
                            min-width: 112px;
                            height: 30px;
                            border-radius: 4px;
                            background: root.editor_tab == 1 ? #2b7de9 : #23282e;
                            Text { text: "反汇编 ASM"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.editor_tab = 1; } }
                        }
                        Text {
                            text: root.editor_tab == 0 ? "编辑 C 源；右侧显示设备状态与变量交互。" : "只读查看最近一次本地或设备算法产物。";
                            color: #8a939c;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 160px;
                        background: #101418;
                        border-width: 1px;
                        border-color: #303840;
                        clip: true;
                        Flickable {
                            visible: root.editor_tab == 0;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Rectangle {
                                    width: 48px;
                                    background: #1c2228;
                                    Text {
                                        x: 0px;
                                        y: 4px;
                                        width: parent.width - 8px;
                                        text: root.algo_line_numbers;
                                        color: #6b7680;
                                        font-size: 13px;
                                        font-family: "Consolas";
                                        horizontal-alignment: TextHorizontalAlignment.right;
                                    }
                                }
                                TextInput {
                                    text <=> root.algo_c_source;
                                    single-line: false;
                                    wrap: no-wrap;
                                    color: #d8e0e8;
                                    font-size: 13px;
                                    font-family: "Consolas";
                                    edited => { root.algo_source_edited(self.text); }
                                }
                            }
                        }
                        TextEdit {
                            visible: root.editor_tab == 1;
                            width: parent.width;
                            height: parent.height;
                            read-only: true;
                            text: root.algo_asm;
                            font-size: 12px;
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Button {
                            text: root.algo_busy ? root.algo_phase : "编译并上传";
                            enabled: !root.algo_busy && root.editor_tab == 0;
                            clicked => { root.algo_build_upload(root.algo_c_source); }
                        }
                        Text {
                            text: root.algo_busy ? root.algo_phase : root.algo_status;
                            color: root.algo_busy ? #8fd6ff : #e0e6ee;
                            wrap: no-wrap;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            divider := Rectangle {
                x: parent.width * root.split_ratio - 8px;
                y: 0;
                width: 8px;
                height: parent.height;
                background: splitter.pressed ? #8fd6ff : (splitter.has-hover ? #3a4149 : #2a2f37);
                Rectangle { x: 3px; width: 2px; height: parent.height; background: splitter.pressed ? #8fd6ff : #4a5560; }
                splitter := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: ew-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { root.split_drag_start_ratio = root.split_ratio; }
                    }
                    moved => {
                        if (self.pressed) {
                            root.split_ratio = Math.max(0.42, Math.min(0.78,
                                root.split_drag_start_ratio + (self.mouse-x - self.pressed-x) / body.width));
                        }
                    }
                    double-clicked => { root.split_ratio = 0.66; }
                }
            }

            right := Rectangle {
                x: parent.width * root.split_ratio;
                y: 0;
                width: parent.width * (1 - root.split_ratio);
                height: parent.height;
                background: Theme.panel;
                border-width: 1px;
                border-color: #3a434c;
                clip: true;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    VerticalBox {
                        padding: 10px;
                        spacing: 8px;
                        Text { text: "状态与交互"; color: Theme.text-title; font-size: Theme.fs-title; }
                        Text { text: root.algo_info_text; color: #8fd6ff; wrap: word-wrap; }
                        Text {
                            text: root.algo_busy ? root.algo_phase : root.algo_status;
                            color: root.algo_busy ? #8fd6ff : #d8e0e8;
                            wrap: word-wrap;
                        }
                        Button {
                            text: "恢复设备默认算法";
                            enabled: !root.algo_busy;
                            clicked => { root.algo_reset_default(); }
                        }
                        Rectangle { height: 1px; background: #3a4149; }
                        Text {
                            text: "C 源：" + root.algo_c_bytes + " / " + root.algo_c_capacity + " 字节";
                            color: root.algo_c_bytes > root.algo_c_capacity ? #ff6b6b : #b0b8c0;
                            font-size: 11px;
                        }
                        Rectangle {
                            height: 10px;
                            min-width: 120px;
                            border-radius: 5px;
                            background: #23282e;
                            clip: true;
                            Rectangle {
                                width: root.algo_c_capacity > 0 ? parent.width * Math.min(1.0, root.algo_c_bytes / root.algo_c_capacity) : 0px;
                                height: parent.height;
                                border-radius: 5px;
                                background: root.algo_c_bytes > root.algo_c_capacity ? #d64545 : #2b8a3e;
                            }
                        }
                        Text {
                            text: "ASM：" + root.algo_asm_bytes + " / " + root.algo_asm_capacity + " 字节";
                            color: #b0b8c0;
                            font-size: 11px;
                        }
                        Rectangle {
                            height: 10px;
                            min-width: 120px;
                            border-radius: 5px;
                            background: #23282e;
                            clip: true;
                            Rectangle {
                                width: root.algo_asm_capacity > 0 ? parent.width * Math.min(1.0, root.algo_asm_bytes / root.algo_asm_capacity) : 0px;
                                height: parent.height;
                                border-radius: 5px;
                                background: root.algo_asm_bytes * 10 > root.algo_asm_capacity * 9 ? #f5a623 : #2b8a3e;
                            }
                        }
                        Rectangle { height: 1px; background: #3a4149; }
                        Text { text: "算法变量元数据"; color: Theme.text-title; font-size: Theme.fs-title; }
                        if root.algo_metadata_rows.length == 0: Text {
                            text: "当前算法未声明 ALGO_REPORT_META / ALGO_SETTING_META。";
                            color: #77828c;
                            wrap: word-wrap;
                        }
                        for row in root.algo_metadata_rows: Rectangle {
                            // ★不能钉死高度★ 卡片里有 4 行(标题/当前值/别名/注释), 原先固定 116px
                            // 装不下, "注释"输入框整行被裁掉(表现为说明输入框被掩盖)。
                            // 用 min-height + 让内部 VerticalBox 决定实际高度。
                            min-height: 150px;
                            border-width: 1px;
                            border-color: #303840;
                            background: #171c21;
                            VerticalBox {
                                padding: 6px;
                                spacing: 4px;
                                HorizontalBox {
                                    spacing: 6px;
                                    Text { text: row.kind + "  " + (row.alias == "" ? row.name : row.alias); color: #e0e6ee; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: row.value_type + "  " + row.range; color: #b0b8c0; }
                                }
                                Text { text: "当前值: " + row.current_value; color: #d8e0e8; }
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 4px;
                                    Text { text: "别名"; color: #8a939c; width: 36px; vertical-alignment: center; }
                                    alias := LineEdit {
                                        text: row.alias;
                                        horizontal-stretch: 1;
                                        changed has-focus => {
                                            if (!self.has-focus) {
                                                root.algo_metadata_edited(row.idx, row.kind == "可调变量" ? 1 : 0, self.text, desc.text);
                                            }
                                        }
                                        accepted(t) => { root.algo_metadata_edited(row.idx, row.kind == "可调变量" ? 1 : 0, t, desc.text); }
                                    }
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 4px;
                                    Text { text: "注释"; color: #8a939c; width: 36px; vertical-alignment: center; }
                                    desc := LineEdit {
                                        text: row.description;
                                        horizontal-stretch: 1;
                                        changed has-focus => {
                                            if (!self.has-focus) {
                                                root.algo_metadata_edited(row.idx, row.kind == "可调变量" ? 1 : 0, alias.text, self.text);
                                            }
                                        }
                                        accepted(t) => { root.algo_metadata_edited(row.idx, row.kind == "可调变量" ? 1 : 0, alias.text, t); }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #3a4149; }
                        Text { text: "可调变量"; color: Theme.text-title; font-size: Theme.fs-title; }
                        if root.algo_setting_rows.length == 0: Text {
                            text: "当前源码未声明 ALGO_SETTING。";
                            color: #77828c;
                        }
                        for row in root.algo_setting_rows: AlgoSettingEditorRow {
                            entry: row;
                            edited(idx, value) => { root.algo_setting_edited(idx, value); }
                        }
                    }
                }
            }
        }
    }
}
